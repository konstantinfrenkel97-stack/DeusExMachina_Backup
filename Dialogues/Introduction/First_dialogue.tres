[sub_resource type="Resource" id="Resource_jjos8"]
script = ExtResource("1_icr5k")
speaker_name = "Лена"
text = "Давайте вот сюда.
"
sprite = ExtResource("3_3fa0j")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_n1djq"]
script = ExtResource("1_icr5k")
speaker_name = "Лена"
text = "Только, прошу, осторожней. Многие из этих книг — раритеты"
sprite = ExtResource("4_k4oqr")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_1cfcq"]
script = ExtResource("1_icr5k")
speaker_name = "Лена"
text = "ОСТОРОЖНО!"
sprite = ExtResource("5_5tdk2")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_3fa0j"]
script = ExtResource("1_icr5k")
text = "Буууууум!"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_k4oqr"]
script = ExtResource("1_icr5k")
speaker_name = "Лена"
text = "Да вы, блин, серьезно?!"
sprite = ExtResource("3_ed1ei")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_5tdk2"]
script = ExtResource("1_icr5k")
speaker_name = "Лена"
text = "Просто тащите его дальше, я тут сама разберусь."
sprite = ExtResource("7_0lul8")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_0lul8"]
script = ExtResource("1_icr5k")
speaker_name = "Лена"
text = "О боги..."
sprite = ExtResource("7_0lul8")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_g6as8"]
script = ExtResource("1_icr5k")
text = "*Шурх шурх шурх*"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_gm8si"]
script = ExtResource("1_icr5k")
speaker_name = "Лена"
text = "А это что? "
sprite = ExtResource("4_k4oqr")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_h4mhf"]
script = ExtResource("1_icr5k")
speaker_name = "Лена"
text = "Когда тебя принесли? Я не помню такой книги. И эти узоры..."
sprite = ExtResource("4_k4oqr")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_iv505"]
script = ExtResource("1_icr5k")
speaker_name = "Лена"
text = "Как на моем ключе! Странно..."
sprite = ExtResource("7_0lul8")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_ra0bb"]
script = ExtResource("1_icr5k")
speaker_name = "Лена"
text = "Не открывается, но я не вижу замка. Только скважина прямо посреди обложки."
sprite = ExtResource("7_0lul8")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_sfqof"]
script = ExtResource("1_icr5k")
speaker_name = "Лена"
text = "Что, если..."
sprite = ExtResource("4_k4oqr")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_oqnoy"]
script = ExtResource("1_icr5k")
text = "............."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_63jlt"]
script = ExtResource("1_icr5k")
speaker_name = "..."
text = "Свобода..."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

