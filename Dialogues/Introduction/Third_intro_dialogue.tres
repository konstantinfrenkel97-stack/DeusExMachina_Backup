[gd_resource type="Resource" script_class="DialogueResource" format=3 uid="uid://c2k3pxgyla42d"]

[ext_resource type="Script" uid="uid://bdppjbkvrapob" path="res://Dialogues/dialogue_line.gd" id="1_egke1"]
[ext_resource type="Script" uid="uid://dh3qxso5m27bg" path="res://Dialogues/dialogue_choice.gd" id="2_hbwro"]
[ext_resource type="Script" uid="uid://c3g5x3dcif30x" path="res://Dialogues/dialogue_resource.gd" id="2_r73dv"]

[sub_resource type="Resource" id="Resource_3wjsj"]
script = ExtResource("1_egke1")
speaker_name = "Лена"
text = "Вау...
Это реально..."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_iwkn0"]
script = ExtResource("1_egke1")
speaker_name = "Голос"
text = "Ха! Действительно сработало. Значит я все понял правильно."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_r73dv"]
script = ExtResource("1_egke1")
speaker_name = "Лена"
text = "Ты клялся что точно сработает!"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_hbwro"]
script = ExtResource("1_egke1")
speaker_name = "Голос"
text = "Оно и сработало."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_8brpc"]
script = ExtResource("1_egke1")
speaker_name = "Голос"
text = "Но позволь представиться, меня зовут Миф, и мы с тобой находимся на плане фантазий."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_b1kgk"]
script = ExtResource("1_egke1")
speaker_name = "Лена"
text = "Я Лена. Погоди, план фантазий?
Ты о чем вообще?"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_flqaw"]
script = ExtResource("1_egke1")
speaker_name = "Миф"
text = "Пространство где собрано все фантастическое и нереальное, где единственный закон - сила воображения"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_bq04w"]
script = ExtResource("1_egke1")
speaker_name = "Миф"
text = "И я тут заперт, получается ты теперь тоже."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_1mv82"]
script = ExtResource("1_egke1")
speaker_name = "Лена"
text = "Это все как-то...
И как нам выбраться отсюда?"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_t7lwn"]
script = ExtResource("1_egke1")
speaker_name = "Миф"
text = "Ну, когда ты попала в этот мир, мои цепи лопнули, и я думал что наконец освобожусь"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_eibuw"]
script = ExtResource("1_egke1")
speaker_name = "Миф"
text = "Но похоже, что произошел какой-то сбой и моя сила рассеялась"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_4ywp2"]
script = ExtResource("1_egke1")
speaker_name = "Лена"
text = "То есть ты не знаешь как выйти?"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_a1xa7"]
script = ExtResource("1_egke1")
speaker_name = "Миф"
text = "Этого я не говорил..."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_s4raq"]
script = ExtResource("1_egke1")
speaker_name = "Монстры"
text = "*Бум бум бум*"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_386nu"]
script = ExtResource("1_egke1")
speaker_name = "Лена"
text = "Они ломают ворота!
Я думала что мы в безопасности!"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_l7mg2"]
script = ExtResource("1_egke1")
speaker_name = "Миф"
text = "Хмм, похоже полная безопасность нам даже так не светит. Любопытно..."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_xidnl"]
script = ExtResource("1_egke1")
speaker_name = "Миф"
text = "Ладно, ты пока выпроводи наших гостей, а я постараюсь решить проблему глобально."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_axv5a"]
script = ExtResource("1_egke1")
speaker_name = "Лена"
text = "Эй, погоди! Как прикажешь мне их выпроваживать?"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_46c7n"]
script = ExtResource("1_egke1")
speaker_name = "Миф"
text = "Фантазия, Лена. 
Используй фантазию. Представь кого-нибудь сильного, кто будет драться на твоей стороне. "
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_26btc"]
script = ExtResource("1_egke1")
speaker_name = "Миф"
text = "Желательно ОЧЕНЬ сильного, "
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_dg7cp"]
script = ExtResource("1_egke1")
speaker_name = "Лена"
text = "Очень сильного...
Бога чтоли?"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_qgxrh"]
script = ExtResource("1_egke1")
speaker_name = "Лена"
text = "Черт, куда он делся?"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_atlmw"]
script = ExtResource("1_egke1")
speaker_name = "Лена"
text = "На ладно, у меня получилось раньше, получится и сейчас!"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_2iiet"]
script = ExtResource("1_egke1")
speaker_name = "Лена"
text = "Бог, Бог, Бог!
ПРИДИ!"
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[resource]
script = ExtResource("2_r73dv")
lines = Array[ExtResource("1_egke1")]([SubResource("Resource_3wjsj"), SubResource("Resource_iwkn0"), SubResource("Resource_r73dv"), SubResource("Resource_hbwro"), SubResource("Resource_8brpc"), SubResource("Resource_b1kgk"), SubResource("Resource_flqaw"), SubResource("Resource_bq04w"), SubResource("Resource_1mv82"), SubResource("Resource_t7lwn"), SubResource("Resource_eibuw"), SubResource("Resource_4ywp2"), SubResource("Resource_a1xa7"), SubResource("Resource_s4raq"), SubResource("Resource_386nu"), SubResource("Resource_l7mg2"), SubResource("Resource_xidnl"), SubResource("Resource_axv5a"), SubResource("Resource_46c7n"), SubResource("Resource_26btc"), SubResource("Resource_dg7cp"), SubResource("Resource_qgxrh"), SubResource("Resource_atlmw"), SubResource("Resource_2iiet")])
metadata/_custom_type_script = "uid://c3g5x3dcif30x"
