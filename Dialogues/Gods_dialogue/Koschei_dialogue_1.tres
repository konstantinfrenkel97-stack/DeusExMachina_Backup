[gd_resource type="Resource" script_class="DialogueResource" format=3 uid="uid://b3xcntgci8aua"]

[ext_resource type="Script" uid="uid://bdppjbkvrapob" path="res://Dialogues/dialogue_line.gd" id="1_line"]
[ext_resource type="Script" uid="uid://dh3qxso5m27bg" path="res://Dialogues/dialogue_choice.gd" id="2_choice"]
[ext_resource type="Texture2D" uid="uid://bfu365plvlb5v" path="res://Main_characters/Lena/Lena_surprised.png" id="3_7458m"]
[ext_resource type="Script" uid="uid://c3g5x3dcif30x" path="res://Dialogues/dialogue_resource.gd" id="3_res"]
[ext_resource type="Texture2D" uid="uid://cl8wacfrih2fj" path="res://Main_characters/Lena/Lena_smile_1.png" id="4_dc4o2"]
[ext_resource type="Texture2D" uid="uid://bwmrl7quj85d" path="res://Main_characters/Lena/Lena_scared.png" id="5_n5we3"]
[ext_resource type="Texture2D" uid="uid://bq5671vbp3ry4" path="res://Main_characters/Lena/Lena_smile_2.png" id="6_fi6je"]
[ext_resource type="Texture2D" uid="uid://duogyyhwd3igs" path="res://Main_characters/Lena/Lena_sceptical.png" id="7_no0vo"]

[sub_resource type="Resource" id="Resource_k001"]
script = ExtResource("1_line")
line_id = "intro_1"
speaker_name = "Кощей"
text = "(Его комната полна золотых статуй скелетов в коронах в величественных позах. Сам Кощей, спиной к двери, поднимает свой жезл как штангу на бицепс.)"
next_line_id = "intro_2"

[sub_resource type="Resource" id="Resource_k002"]
script = ExtResource("1_line")
line_id = "intro_2"
speaker_name = "Лена"
text = "(Но у него же нет мышц.)"
sprite = ExtResource("3_7458m")
next_line_id = "intro_3"

[sub_resource type="Resource" id="Resource_k003"]
script = ExtResource("1_line")
line_id = "intro_3"
speaker_name = "Лена"
text = "Эм, можно тебя спросить?"
sprite = ExtResource("3_7458m")
next_line_id = "Koschei_choices_1"

[sub_resource type="Resource" id="Resource_c001"]
script = ExtResource("2_choice")
choice_id = "open_door"
choice_text = "Открыть дверь"
next_line_id = "open_door_1"

[sub_resource type="Resource" id="Resource_c002"]
script = ExtResource("2_choice")
choice_id = "opinion"
choice_text = "Отношение к богам"
next_line_id = "opinion_start"

[sub_resource type="Resource" id="Resource_c003"]
script = ExtResource("2_choice")
choice_id = "new_world"
choice_text = "Новый мир"
next_line_id = "new_world_1"

[sub_resource type="Resource" id="Resource_c004"]
script = ExtResource("2_choice")
choice_id = "your_help"
choice_text = "Твоя помощь"
next_line_id = "help_1"

[sub_resource type="Resource" id="Resource_c005"]
script = ExtResource("2_choice")
choice_id = "chosen_world"
choice_text = "Выбранный мир"
next_line_id = "chosen_world_1"

[sub_resource type="Resource" id="Resource_k004"]
script = ExtResource("1_line")
line_id = "Koschei_choices_1"
choices = Array[ExtResource("2_choice")]([SubResource("Resource_c001"), SubResource("Resource_c002"), SubResource("Resource_c003"), SubResource("Resource_c004"), SubResource("Resource_c005")])

[sub_resource type="Resource" id="Resource_k005"]
script = ExtResource("1_line")
line_id = "open_door_1"
speaker_name = "Лена"
text = "Мне нужно чтобы ты открыл одну из этих дверей."
sprite = ExtResource("3_7458m")
next_line_id = "open_door_2"

[sub_resource type="Resource" id="Resource_k006"]
script = ExtResource("1_line")
line_id = "open_door_2"
speaker_name = "Кощей"
text = "Открыл? А что сама не откроешь?"
next_line_id = "open_door_3"

[sub_resource type="Resource" id="Resource_k007"]
script = ExtResource("1_line")
line_id = "open_door_3"
speaker_name = "Лена"
text = "Сил не хватает, нужен бог."
sprite = ExtResource("4_dc4o2")
next_line_id = "open_door_4"

[sub_resource type="Resource" id="Resource_k008"]
script = ExtResource("1_line")
line_id = "open_door_4"
speaker_name = "Кощей"
text = "Бог? Бог! Значит признаешь мою божественную мощь?"
next_line_id = "open_door_5"

[sub_resource type="Resource" id="Resource_k009"]
script = ExtResource("1_line")
line_id = "open_door_5"
speaker_name = "Лена"
text = "Но я и раньше говорила что признаю..."
sprite = ExtResource("3_7458m")
next_line_id = "open_door_6"

[sub_resource type="Resource" id="Resource_k010"]
script = ExtResource("1_line")
line_id = "open_door_6"
speaker_name = "Кощей"
text = "Не надо лишних слов, помогу тебе смертная."
next_line_id = "open_door_7"

[sub_resource type="Resource" id="Resource_k011"]
script = ExtResource("1_line")
line_id = "open_door_7"
speaker_name = "Кощей"
text = "О! Вот эта мне по вкусу?"
next_line_id = "open_door_8"

[sub_resource type="Resource" id="Resource_k012"]
script = ExtResource("1_line")
line_id = "open_door_8"
speaker_name = "Лена"
text = "Топь? Я отсюда чувствую сырость."
sprite = ExtResource("3_7458m")
next_line_id = "open_door_9"

[sub_resource type="Resource" id="Resource_k013"]
script = ExtResource("1_line")
line_id = "open_door_9"
speaker_name = "Лена"
text = "Жутковатая какая-то."
sprite = ExtResource("5_n5we3")
next_line_id = "open_door_10"

[sub_resource type="Resource" id="Resource_k014"]
script = ExtResource("1_line")
line_id = "open_door_10"
speaker_name = "Кощей"
text = "Ничего то ты не понимаешь."
next_line_id = "open_door_11"

[sub_resource type="Resource" id="Resource_k015"]
script = ExtResource("1_line")
line_id = "open_door_11"
speaker_name = "Кощей"
text = "Это по началу кажется, что сплошная чаща и топь и орды нечисти."
next_line_id = "open_door_12"

[sub_resource type="Resource" id="Resource_k016"]
script = ExtResource("1_line")
line_id = "open_door_12"
speaker_name = "Кощей"
text = "А как поживёшь немного, так другого и не захочется."
next_line_id = "open_door_13"

[sub_resource type="Resource" id="Resource_k017"]
script = ExtResource("1_line")
line_id = "open_door_13"
speaker_name = "Кощей"
text = "Поверь уж."
next_line_id = "open_door_14"

[sub_resource type="Resource" id="Resource_k018"]
script = ExtResource("1_line")
line_id = "open_door_14"
speaker_name = "Лена"
text = "Да, наверное и у меня так было."
sprite = ExtResource("4_dc4o2")
next_line_id = "open_door_15"

[sub_resource type="Resource" id="Resource_k019"]
script = ExtResource("1_line")
line_id = "open_door_15"
speaker_name = "Кощей"
text = "Поверь, говорю из опыта."
next_line_id = "open_door_16"

[sub_resource type="Resource" id="Resource_k020"]
script = ExtResource("1_line")
line_id = "open_door_16"
speaker_name = "Лена"
text = "Да, я верю, верю."
sprite = ExtResource("4_dc4o2")
next_line_id = "open_door_17"

[sub_resource type="Resource" id="Resource_k021"]
script = ExtResource("1_line")
line_id = "open_door_17"
speaker_name = "Кощей"
text = "Длительного опыта."
next_line_id = "open_door_18"

[sub_resource type="Resource" id="Resource_k022"]
script = ExtResource("1_line")
line_id = "open_door_18"
speaker_name = "Лена"
text = "..."
sprite = ExtResource("4_dc4o2")
next_line_id = "open_door_19"

[sub_resource type="Resource" id="Resource_k023"]
script = ExtResource("1_line")
line_id = "open_door_19"
speaker_name = "Кощей"
text = "Потому что я Бессмертный!"
next_line_id = "open_door_20"

[sub_resource type="Resource" id="Resource_k024"]
script = ExtResource("1_line")
line_id = "open_door_20"
speaker_name = "Лена"
text = "Вааааау! Какое остроумие!"
sprite = ExtResource("6_fi6je")
next_line_id = "open_door_21"

[sub_resource type="Resource" id="Resource_k025"]
script = ExtResource("1_line")
line_id = "open_door_21"
speaker_name = "Кощей"
text = "Это ты сейчас серьезно или иронизируешь?"
next_line_id = "open_door_22"

[sub_resource type="Resource" id="Resource_k026"]
script = ExtResource("1_line")
line_id = "open_door_22"
speaker_name = "Лена"
text = "А что вам подсказывает опыт?"
sprite = ExtResource("6_fi6je")
next_line_id = "Koschei_choices_1"

[sub_resource type="Resource" id="Resource_c006"]
script = ExtResource("2_choice")
choice_id = "opinion_duna"
choice_text = "Дуна"
next_line_id = "opinion_duna_1"

[sub_resource type="Resource" id="Resource_c007"]
script = ExtResource("2_choice")
choice_id = "opinion_morgan"
choice_text = "Моргана"
next_line_id = "opinion_morgan_1"

[sub_resource type="Resource" id="Resource_k027"]
script = ExtResource("1_line")
line_id = "opinion_start"
speaker_name = "Лена"
text = "Слушай, а что ты думаешь о..."
sprite = ExtResource("3_7458m")
choices = Array[ExtResource("2_choice")]([SubResource("Resource_c006"), SubResource("Resource_c007")])

[sub_resource type="Resource" id="Resource_k028"]
script = ExtResource("1_line")
line_id = "opinion_duna_1"
speaker_name = "Лена"
text = "... Дуне."
sprite = ExtResource("3_7458m")
next_line_id = "opinion_duna_2"

[sub_resource type="Resource" id="Resource_k029"]
script = ExtResource("1_line")
line_id = "opinion_duna_2"
speaker_name = "Кощей"
text = "О Дуна! Прекрасная дева."
next_line_id = "opinion_duna_3"

[sub_resource type="Resource" id="Resource_k030"]
script = ExtResource("1_line")
line_id = "opinion_duna_3"
speaker_name = "Кощей"
text = "Любо дорого смотреть."
next_line_id = "opinion_duna_4"

[sub_resource type="Resource" id="Resource_k031"]
script = ExtResource("1_line")
line_id = "opinion_duna_4"
speaker_name = "Кощей"
text = "Недавно с ней разговаривал. Думаю мы отлично поладили."
next_line_id = "opinion_duna_5"

[sub_resource type="Resource" id="Resource_k032"]
script = ExtResource("1_line")
line_id = "opinion_duna_5"
speaker_name = "Лена"
text = "Неужели..."
sprite = ExtResource("7_no0vo")
next_line_id = "opinion_duna_6"

[sub_resource type="Resource" id="Resource_k033"]
script = ExtResource("1_line")
line_id = "opinion_duna_6"
speaker_name = "Лена"
text = "И о чем вы говорили?"
sprite = ExtResource("7_no0vo")
next_line_id = "opinion_duna_7"

[sub_resource type="Resource" id="Resource_k034"]
script = ExtResource("1_line")
line_id = "opinion_duna_7"
speaker_name = "Кощей"
text = "Как о чем? Ну в основном... Обо мне."
next_line_id = "opinion_duna_8"

[sub_resource type="Resource" id="Resource_k035"]
script = ExtResource("1_line")
line_id = "opinion_duna_8"
speaker_name = "Лена"
text = "Ага, и что она сказала."
sprite = ExtResource("7_no0vo")
next_line_id = "opinion_duna_9"

[sub_resource type="Resource" id="Resource_k036"]
script = ExtResource("1_line")
line_id = "opinion_duna_9"
speaker_name = "Кощей"
text = "Ну, она согласилась с моими доводами."
next_line_id = "opinion_duna_10"

[sub_resource type="Resource" id="Resource_k037"]
script = ExtResource("1_line")
line_id = "opinion_duna_10"
speaker_name = "Лена"
text = "На тему?"
sprite = ExtResource("7_no0vo")
next_line_id = "opinion_duna_11"

[sub_resource type="Resource" id="Resource_k038"]
script = ExtResource("1_line")
line_id = "opinion_duna_11"
speaker_name = "Кощей"
text = "Того что я бессмертный."
next_line_id = "opinion_duna_12"

[sub_resource type="Resource" id="Resource_k039"]
script = ExtResource("1_line")
line_id = "opinion_duna_12"
speaker_name = "Кощей"
text = "И это круто."
next_line_id = "opinion_duna_13"

[sub_resource type="Resource" id="Resource_k040"]
script = ExtResource("1_line")
line_id = "opinion_duna_13"
speaker_name = "Лена"
text = "Ага..."
next_line_id = "opinion_duna_14"

[sub_resource type="Resource" id="Resource_k041"]
script = ExtResource("1_line")
line_id = "opinion_duna_14"
speaker_name = "Кощей"
text = "Ты думаешь я ей не нравлюсь?"
next_line_id = "opinion_duna_15"

[sub_resource type="Resource" id="Resource_k042"]
script = ExtResource("1_line")
line_id = "opinion_duna_15"
speaker_name = "Лена"
text = "Да не то чтобы..."
next_line_id = "opinion_duna_16"

[sub_resource type="Resource" id="Resource_k043"]
script = ExtResource("1_line")
line_id = "opinion_duna_16"
speaker_name = "Кощей"
text = "..."
next_line_id = "opinion_duna_17"

[sub_resource type="Resource" id="Resource_k044"]
script = ExtResource("1_line")
line_id = "opinion_duna_17"
speaker_name = "Лена"
text = "А это важно?"
next_line_id = "opinion_duna_18"

[sub_resource type="Resource" id="Resource_k045"]
script = ExtResource("1_line")
line_id = "opinion_duna_18"
speaker_name = "Кощей"
text = "Что?"
next_line_id = "opinion_duna_19"

[sub_resource type="Resource" id="Resource_k046"]
script = ExtResource("1_line")
line_id = "opinion_duna_19"
speaker_name = "Лена"
text = "Чтобы вы ей нравились?"
next_line_id = "opinion_duna_20"

[sub_resource type="Resource" id="Resource_k047"]
script = ExtResource("1_line")
line_id = "opinion_duna_20"
speaker_name = "Кощей"
text = "Нет. Конечно нет."
next_line_id = "opinion_duna_21"

[sub_resource type="Resource" id="Resource_k048"]
script = ExtResource("1_line")
line_id = "opinion_duna_21"
speaker_name = "Кощей"
text = "Да мне вообще все равно."
next_line_id = "opinion_duna_22"

[sub_resource type="Resource" id="Resource_k049"]
script = ExtResource("1_line")
line_id = "opinion_duna_22"
speaker_name = "Кощей"
text = "Я бессмертный, что мне мнение какой-то Дуны."
next_line_id = "opinion_duna_23"

[sub_resource type="Resource" id="Resource_k050"]
script = ExtResource("1_line")
line_id = "opinion_duna_23"
speaker_name = "Лена"
text = "Ну вот и славно."
next_line_id = "Koschei_choices_1"

[sub_resource type="Resource" id="Resource_k051"]
script = ExtResource("1_line")
line_id = "opinion_morgan_1"
speaker_name = "Лена"
text = "...Моргане."
next_line_id = "opinion_morgan_2"

[sub_resource type="Resource" id="Resource_k052"]
script = ExtResource("1_line")
line_id = "opinion_morgan_2"
speaker_name = "Кощей"
text = "Моргана. Ох, Моргана Моргана."
next_line_id = "opinion_morgan_3"

[sub_resource type="Resource" id="Resource_k053"]
script = ExtResource("1_line")
line_id = "opinion_morgan_3"
speaker_name = "Кощей"
text = "Что за женщина!"
next_line_id = "opinion_morgan_4"

[sub_resource type="Resource" id="Resource_k054"]
script = ExtResource("1_line")
line_id = "opinion_morgan_4"
speaker_name = "Лена"
text = "Ладно я поняла не продолжайте."
next_line_id = "opinion_morgan_5"

[sub_resource type="Resource" id="Resource_k055"]
script = ExtResource("1_line")
line_id = "opinion_morgan_5"
speaker_name = "Кощей"
text = "Я хочу чтобы она покрепче в руку взяла..."
next_line_id = "opinion_morgan_6"

[sub_resource type="Resource" id="Resource_k056"]
script = ExtResource("1_line")
line_id = "opinion_morgan_6"
speaker_name = "Лена"
text = "Я ухожу."
next_line_id = "opinion_morgan_7"

[sub_resource type="Resource" id="Resource_k057"]
script = ExtResource("1_line")
line_id = "opinion_morgan_7"
speaker_name = "Кощей"
text = "... этот твёрдый черный жезл..."
next_line_id = "opinion_morgan_8"

[sub_resource type="Resource" id="Resource_k058"]
script = ExtResource("1_line")
line_id = "opinion_morgan_8"
speaker_name = "Лена"
text = "Я ушла!"
next_line_id = "opinion_morgan_9"

[sub_resource type="Resource" id="Resource_k059"]
script = ExtResource("1_line")
line_id = "opinion_morgan_9"
speaker_name = "Кощей"
text = "... и наложила проклятие на какого-нибудь богатыря."
next_line_id = "Koschei_choices_1"

[sub_resource type="Resource" id="Resource_k060"]
script = ExtResource("1_line")
line_id = "new_world_1"
speaker_name = "Лена"
text = "Как вам на этом плане? Обживаетесь?"
next_line_id = "new_world_2"

[sub_resource type="Resource" id="Resource_k061"]
script = ExtResource("1_line")
line_id = "new_world_2"
speaker_name = "Кощей"
text = "Обживаюсь. Не то чтобы тут было много интересных занятий."
next_line_id = "new_world_3"

[sub_resource type="Resource" id="Resource_k062"]
script = ExtResource("1_line")
line_id = "new_world_3"
speaker_name = "Лена"
text = "А чем вы обычно занимаетесь."
next_line_id = "new_world_4"

[sub_resource type="Resource" id="Resource_k063"]
script = ExtResource("1_line")
line_id = "new_world_4"
speaker_name = "Кощей"
text = "Ну, похищаю царевен, строю козни."
next_line_id = "new_world_5"

[sub_resource type="Resource" id="Resource_k064"]
script = ExtResource("1_line")
line_id = "new_world_5"
speaker_name = "Кощей"
text = "А когда нет настроения напрягаться, собираю золото в кучу и гляжу на него."
next_line_id = "new_world_6"

[sub_resource type="Resource" id="Resource_k065"]
script = ExtResource("1_line")
line_id = "new_world_6"
speaker_name = "Лена"
text = "И как, увлекает?"
next_line_id = "new_world_7"

[sub_resource type="Resource" id="Resource_k066"]
script = ExtResource("1_line")
line_id = "new_world_7"
speaker_name = "Кощей"
text = "Не то чтобы увлекает, успокаивает."
next_line_id = "new_world_8"

[sub_resource type="Resource" id="Resource_k067"]
script = ExtResource("1_line")
line_id = "new_world_8"
speaker_name = "Кощей"
text = "Знаешь, когда живешь бесконечно долго, задаешь себе вопрос."
next_line_id = "new_world_9"

[sub_resource type="Resource" id="Resource_k068"]
script = ExtResource("1_line")
line_id = "new_world_9"
speaker_name = "Кощей"
text = "А ради чего я вообще живу."
next_line_id = "new_world_10"

[sub_resource type="Resource" id="Resource_k069"]
script = ExtResource("1_line")
line_id = "new_world_10"
speaker_name = "Кощей"
text = "И вот когда я смотрю на кучу золота, которую накопил за все эти годы."
next_line_id = "new_world_11"

[sub_resource type="Resource" id="Resource_k070"]
script = ExtResource("1_line")
line_id = "new_world_11"
speaker_name = "Кощей"
text = "И тогда понимаю, что прошел этот путь не зря."
next_line_id = "new_world_12"

[sub_resource type="Resource" id="Resource_k071"]
script = ExtResource("1_line")
line_id = "new_world_12"
speaker_name = "Лена"
text = "Золото... Ваша история очень вдохновляет."
next_line_id = "new_world_13"

[sub_resource type="Resource" id="Resource_k072"]
script = ExtResource("1_line")
line_id = "new_world_13"
speaker_name = "Кощей"
text = "Правда? Мне говорили что я очень глубоко чувствую."
next_line_id = "new_world_14"

[sub_resource type="Resource" id="Resource_k073"]
script = ExtResource("1_line")
line_id = "new_world_14"
speaker_name = "Лена"
text = "Серьезно? И кто это говорил?"
next_line_id = "new_world_15"

[sub_resource type="Resource" id="Resource_k074"]
script = ExtResource("1_line")
line_id = "new_world_15"
speaker_name = "Кощей"
text = "Да так, кикимора одна. Я ей тогда стихи свои читал."
next_line_id = "new_world_16"

[sub_resource type="Resource" id="Resource_k075"]
script = ExtResource("1_line")
line_id = "new_world_16"
speaker_name = "Лена"
text = "Ого, и ей понравилось?"
next_line_id = "new_world_17"

[sub_resource type="Resource" id="Resource_k076"]
script = ExtResource("1_line")
line_id = "new_world_17"
speaker_name = "Кощей"
text = "О да! Так хвалила."
next_line_id = "new_world_18"

[sub_resource type="Resource" id="Resource_k077"]
script = ExtResource("1_line")
line_id = "new_world_18"
speaker_name = "Кощей"
text = "Я аж растрогался, снял цепи и отпустил ее живой."
next_line_id = "new_world_19"

[sub_resource type="Resource" id="Resource_k078"]
script = ExtResource("1_line")
line_id = "new_world_19"
speaker_name = "Лена"
text = "..."
next_line_id = "new_world_20"

[sub_resource type="Resource" id="Resource_k079"]
script = ExtResource("1_line")
line_id = "new_world_20"
speaker_name = "Кощей"
text = "Хочешь тоже стихи послушать?"
next_line_id = "new_world_21"

[sub_resource type="Resource" id="Resource_k080"]
script = ExtResource("1_line")
line_id = "new_world_21"
speaker_name = "Лена"
text = "Эм, давай в другой раз."
next_line_id = "Koschei_choices_1"

[sub_resource type="Resource" id="Resource_k081"]
script = ExtResource("1_line")
line_id = "help_1"
speaker_name = "Лена"
text = "И все таки, огромное спасибо, за то что вы мне помогаете."
next_line_id = "help_2"

[sub_resource type="Resource" id="Resource_k082"]
script = ExtResource("1_line")
line_id = "help_2"
speaker_name = "Кощей"
text = "Хах, благодарность не бывает лишней."
next_line_id = "help_3"

[sub_resource type="Resource" id="Resource_k083"]
script = ExtResource("1_line")
line_id = "help_3"
speaker_name = "Лена"
text = "Хотя вы и странноватый."
next_line_id = "help_4"

[sub_resource type="Resource" id="Resource_k084"]
script = ExtResource("1_line")
line_id = "help_4"
speaker_name = "Кощей"
text = "Кто странноватый? Я странноватый?!"
next_line_id = "help_5"

[sub_resource type="Resource" id="Resource_k085"]
script = ExtResource("1_line")
line_id = "help_5"
speaker_name = "Лена"
text = "Ну эм... В общем, большое вам спасибо."
next_line_id = "help_6"

[sub_resource type="Resource" id="Resource_k086"]
script = ExtResource("1_line")
line_id = "help_6"
speaker_name = "Кощей"
text = "Нет, подожди, почему ты говоришь что я странноватый?"
next_line_id = "help_7"

[sub_resource type="Resource" id="Resource_k087"]
script = ExtResource("1_line")
line_id = "help_7"
speaker_name = "Лена"
text = "Ну... То как вы говорите и ведете себя..."
next_line_id = "help_8"

[sub_resource type="Resource" id="Resource_k088"]
script = ExtResource("1_line")
line_id = "help_8"
speaker_name = "Лена"
text = "Вы поднимаете свой жезл, как во время тренировки. Хотя у вас даже мышц нет."
next_line_id = "help_9"

[sub_resource type="Resource" id="Resource_k089"]
script = ExtResource("1_line")
line_id = "help_9"
speaker_name = "Кощей"
text = "Это странно? Я видел как один богатырь так делал. Решил что это поможет мне стать сильнее."
next_line_id = "help_10"

[sub_resource type="Resource" id="Resource_k090"]
script = ExtResource("1_line")
line_id = "help_10"
speaker_name = "Кощей"
text = "Раз я тебе помогаю."
next_line_id = "help_11"

[sub_resource type="Resource" id="Resource_k091"]
script = ExtResource("1_line")
line_id = "help_11"
speaker_name = "Лена"
text = "Блин, теперь мне стыдно."
next_line_id = "help_12"

[sub_resource type="Resource" id="Resource_k092"]
script = ExtResource("1_line")
line_id = "help_12"
speaker_name = "Лена"
text = "Я не хотела обидеть, правда. Само как-то вырвалось."
next_line_id = "help_13"

[sub_resource type="Resource" id="Resource_k093"]
script = ExtResource("1_line")
line_id = "help_13"
speaker_name = "Кощей"
text = "Да нет, ты просто не первая кто мне это говорит."
next_line_id = "help_14"

[sub_resource type="Resource" id="Resource_k094"]
script = ExtResource("1_line")
line_id = "help_14"
speaker_name = "Кощей"
text = "Что я странный."
next_line_id = "help_15"

[sub_resource type="Resource" id="Resource_k095"]
script = ExtResource("1_line")
line_id = "help_15"
speaker_name = "Кощей"
text = "А я не могу понять почему."
next_line_id = "help_16"

[sub_resource type="Resource" id="Resource_k096"]
script = ExtResource("1_line")
line_id = "help_16"
speaker_name = "Кощей"
text = "Что я такого делаю?"
next_line_id = "help_17"

[sub_resource type="Resource" id="Resource_k097"]
script = ExtResource("1_line")
line_id = "help_17"
speaker_name = "Лена"
text = "Я просто не знаю как вам объяснить."
next_line_id = "help_18"

[sub_resource type="Resource" id="Resource_k098"]
script = ExtResource("1_line")
line_id = "help_18"
speaker_name = "Лена"
text = "Такие вещи как-то люди сами понимают."
next_line_id = "help_19"

[sub_resource type="Resource" id="Resource_k099"]
script = ExtResource("1_line")
line_id = "help_19"
speaker_name = "Лена"
text = "А вы, как будто не понимаете."
next_line_id = "help_20"

[sub_resource type="Resource" id="Resource_k100"]
script = ExtResource("1_line")
line_id = "help_20"
speaker_name = "Кощей"
text = "Вот как..."
next_line_id = "help_21"

[sub_resource type="Resource" id="Resource_k101"]
script = ExtResource("1_line")
line_id = "help_21"
speaker_name = "Лена"
text = "Это не значит что вы плохой."
next_line_id = "help_22"

[sub_resource type="Resource" id="Resource_k102"]
script = ExtResource("1_line")
line_id = "help_22"
speaker_name = "Лена"
text = "Может это потому что вы так долго живете?"
next_line_id = "help_23"

[sub_resource type="Resource" id="Resource_k103"]
script = ExtResource("1_line")
line_id = "help_23"
speaker_name = "Кощей"
text = "Может быть."
next_line_id = "help_24"

[sub_resource type="Resource" id="Resource_k104"]
script = ExtResource("1_line")
line_id = "help_24"
speaker_name = "Кощей"
text = "Может быть..."
next_line_id = "Koschei_choices_1"

[sub_resource type="Resource" id="Resource_k105"]
script = ExtResource("1_line")
line_id = "chosen_world_1"
speaker_name = "Лена"
text = "Вы называли себя повелителем нечисти."
next_line_id = "chosen_world_2"

[sub_resource type="Resource" id="Resource_k106"]
script = ExtResource("1_line")
line_id = "chosen_world_2"
speaker_name = "Кощей"
text = "О! Ты заметила?"
next_line_id = "chosen_world_3"

[sub_resource type="Resource" id="Resource_k107"]
script = ExtResource("1_line")
line_id = "chosen_world_3"
speaker_name = "Лена"
text = "Да, вы не были особо скрытным в этот момент."
next_line_id = "chosen_world_4"

[sub_resource type="Resource" id="Resource_k108"]
script = ExtResource("1_line")
line_id = "chosen_world_4"
speaker_name = "Лена"
text = "Мне казалось у нечисти нет, как такового лидера."
next_line_id = "chosen_world_5"

[sub_resource type="Resource" id="Resource_k109"]
script = ExtResource("1_line")
line_id = "chosen_world_5"
speaker_name = "Лена"
text = "Скорее более могущественные представители."
next_line_id = "chosen_world_6"

[sub_resource type="Resource" id="Resource_k110"]
script = ExtResource("1_line")
line_id = "chosen_world_6"
speaker_name = "Кощей"
text = "Ну... Это одновременно верно и неверно."
next_line_id = "chosen_world_7"

[sub_resource type="Resource" id="Resource_k111"]
script = ExtResource("1_line")
line_id = "chosen_world_7"
speaker_name = "Кощей"
text = "Постоянного царя как у людей нет."
next_line_id = "chosen_world_8"

[sub_resource type="Resource" id="Resource_k112"]
script = ExtResource("1_line")
line_id = "chosen_world_8"
speaker_name = "Кощей"
text = "Потому что у нас нет организованных общин. Каждый сам по себе живёт."
next_line_id = "chosen_world_9"

[sub_resource type="Resource" id="Resource_k113"]
script = ExtResource("1_line")
line_id = "chosen_world_9"
speaker_name = "Кощей"
text = "Но, есть статус повелителя. И он не просто декоративный."
next_line_id = "chosen_world_10"

[sub_resource type="Resource" id="Resource_k114"]
script = ExtResource("1_line")
line_id = "chosen_world_10"
speaker_name = "Кощей"
text = "Повелитель имеет право собирать общий совет."
next_line_id = "chosen_world_11"

[sub_resource type="Resource" id="Resource_k115"]
script = ExtResource("1_line")
line_id = "chosen_world_11"
speaker_name = "Кощей"
text = "Назначать законы, вести суды."
next_line_id = "chosen_world_12"

[sub_resource type="Resource" id="Resource_k116"]
script = ExtResource("1_line")
line_id = "chosen_world_12"
speaker_name = "Кощей"
text = "Даже можно собрать армию и пойти на войну. Но пока никому не удавалось это согласовать."
next_line_id = "chosen_world_13"

[sub_resource type="Resource" id="Resource_k117"]
script = ExtResource("1_line")
line_id = "chosen_world_13"
speaker_name = "Лена"
text = "Ох..."
next_line_id = "chosen_world_14"

[sub_resource type="Resource" id="Resource_k118"]
script = ExtResource("1_line")
line_id = "chosen_world_14"
speaker_name = "Кощей"
text = "У нас сейчас три главные силы: Я, Баба Яга и Змей Горыныч."
next_line_id = "chosen_world_15"

[sub_resource type="Resource" id="Resource_k119"]
script = ExtResource("1_line")
line_id = "chosen_world_15"
speaker_name = "Кощей"
text = "Точнее сказать, две с половиной."
next_line_id = "chosen_world_16"

[sub_resource type="Resource" id="Resource_k120"]
script = ExtResource("1_line")
line_id = "chosen_world_16"
speaker_name = "Кощей"
text = "Мы с Горынычем примерно равны по влиянию среди нечисти."
next_line_id = "chosen_world_17"

[sub_resource type="Resource" id="Resource_k121"]
script = ExtResource("1_line")
line_id = "chosen_world_17"
speaker_name = "Кощей"
text = "Баба Яга уступает, но зато она предоставляет поддержку одному из нас. В некотором смысле, ее слабое положение делает ее самой влиятельной."
next_line_id = "chosen_world_18"

[sub_resource type="Resource" id="Resource_k122"]
script = ExtResource("1_line")
line_id = "chosen_world_18"
speaker_name = "Кощей"
text = "Так вот, когда ты меня призвала, я был повелителем нечисти."
next_line_id = "chosen_world_19"

[sub_resource type="Resource" id="Resource_k123"]
script = ExtResource("1_line")
line_id = "chosen_world_19"
speaker_name = "Кощей"
text = "Но я опасаюсь, что в мою отсутствие, эта гадюка Горыныч узурпирует мою власть."
next_line_id = "chosen_world_20"

[sub_resource type="Resource" id="Resource_k124"]
script = ExtResource("1_line")
line_id = "chosen_world_20"
speaker_name = "Лена"
text = "Вы, звучите очень компетентно и серьезно."
next_line_id = "chosen_world_21"

[sub_resource type="Resource" id="Resource_k125"]
script = ExtResource("1_line")
line_id = "chosen_world_21"
speaker_name = "Кощей"
text = "Ну так, сколько лет я этой политикой занимаюсь."
next_line_id = "chosen_world_22"

[sub_resource type="Resource" id="Resource_k126"]
script = ExtResource("1_line")
line_id = "chosen_world_22"
speaker_name = "Лена"
text = "Я многое о вас узнала."
next_line_id = "chosen_world_23"

[sub_resource type="Resource" id="Resource_k127"]
script = ExtResource("1_line")
line_id = "chosen_world_23"
speaker_name = "Лена"
text = "А как вообще выбирается Повелитель? Голосованием?"
next_line_id = "chosen_world_24"

[sub_resource type="Resource" id="Resource_k128"]
script = ExtResource("1_line")
line_id = "chosen_world_24"
speaker_name = "Кощей"
text = "Ооооо. Там процедура меняется каждый раз, когда сменяется власть. Все пытаемся сместить ее в свою пользу."
next_line_id = "chosen_world_25"

[sub_resource type="Resource" id="Resource_k129"]
script = ExtResource("1_line")
line_id = "chosen_world_25"
speaker_name = "Кощей"
text = "Сейчас расскажу по порядку."
next_line_id = "chosen_world_26"

[sub_resource type="Resource" id="Resource_k130"]
script = ExtResource("1_line")
line_id = "chosen_world_26"
speaker_name = "Лена"
text = "(Ох, зачем я спросила...)"
next_line_id = "Koschei_choices_1"

[resource]
script = ExtResource("3_res")
dialogue_id = "koschei_dialogue_1"
dialogue_name = ""
