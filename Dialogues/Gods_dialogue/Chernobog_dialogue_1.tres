[sub_resource type="Resource" id="Resource_cb_L1"]
script = ExtResource("1_line")
line_id = "intro_1"
speaker_name = "Чернобог"
text = "(Он сидит посреди пустой комнаты подобно горгулье, ты слышишь только тихий свист. Не сразу понимаешь, что это воздух всасывается в пустоту в его лице.)"
next_line_id = "intro_2"

