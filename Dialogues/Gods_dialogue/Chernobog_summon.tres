[ext_resource type="Texture2D" uid="uid://bfu365plvlb5v" path="res://Main_characters/Lena/Lena_surprised.png" id="4_m4lgs"]
[ext_resource type="Texture2D" uid="uid://cl8wacfrih2fj" path="res://Main_characters/Lena/Lena_smile_1.png" id="5_h452l"]

[sub_resource type="Resource" id="Resource_ot534"]
script = ExtResource("1_n1l0t")
speaker_name = "Лена"
text = "Киияааааа! Я призвала монстра!"
sprite = ExtResource("3_j6que")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_j6que"]
script = ExtResource("1_n1l0t")
speaker_name = "Чернобог"
text = "СТОЙ..."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_m4lgs"]
script = ExtResource("1_n1l0t")
speaker_name = "Чернобог"
text = "Я НЕ МОНСТР... Я БОГ..."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_h452l"]
script = ExtResource("1_n1l0t")
speaker_name = "Лена"
text = "Вы. Неужели?"
sprite = ExtResource("4_m4lgs")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_8m18j"]
script = ExtResource("1_n1l0t")
speaker_name = "Чернобог"
text = "ЧЕРНОБОГ..."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_g45ad"]
script = ExtResource("1_n1l0t")
speaker_name = "Лена"
text = "Вы действительно бог, но вы ведь покровитель всего зла славянской мифологии, я не уверена, что мне стоит…"
sprite = ExtResource("4_m4lgs")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_745v5"]
script = ExtResource("1_n1l0t")
speaker_name = "Чернобог"
text = "ЗАЧЕМ... Я ЗДЕСЬ..."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_w5akg"]
script = ExtResource("1_n1l0t")
speaker_name = "Лена"
text = "Меня окружила орда чудовищ, и я хотела призвать того, кто сможет с ними разобраться."
sprite = ExtResource("5_h452l")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_bcjb4"]
script = ExtResource("1_n1l0t")
speaker_name = "Лена"
text = "Но послушайте, я не думаю, что нам с вами…"
sprite = ExtResource("4_m4lgs")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_7sw0b"]
script = ExtResource("1_n1l0t")
speaker_name = "Чернобог"
text = "ХОЧЕШЬ УБИВАТЬ..."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_mxlpx"]
script = ExtResource("1_n1l0t")
speaker_name = "Чернобог"
text = "БУДУ УБИВАТЬ..."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_m4oxi"]
script = ExtResource("1_n1l0t")
speaker_name = "Лена"
text = "Нет, постойте!"
sprite = ExtResource("4_m4lgs")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_syuv7"]
script = ExtResource("1_n1l0t")
speaker_name = "Чернобог"
text = "УБИВАТЬ..."
metadata/_custom_type_script = "uid://bdppjbkvrapob"

[sub_resource type="Resource" id="Resource_7smcg"]
script = ExtResource("1_n1l0t")
speaker_name = "Лена"
text = "Да постойте же! Дайте я хоть покажу вам, где враги!"
sprite = ExtResource("3_j6que")
metadata/_custom_type_script = "uid://bdppjbkvrapob"

