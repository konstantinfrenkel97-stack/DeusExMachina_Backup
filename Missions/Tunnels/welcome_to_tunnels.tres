[gd_resource type="Resource" script_class="MissionResource" format=3]

[ext_resource type="Script" path="res://Missions/mission_resource.gd" id="mission_script"]
[ext_resource type="Resource" path="res://Scenes/TunnelsScenes/welcome_tunnels.tres" id="scene_welcome"]
[ext_resource type="Resource" path="res://Scenes/TunnelsScenes/tunnels_treasure_chest.tres" id="scene_chest"]
[ext_resource type="Resource" path="res://Scenes/TunnelsScenes/tunnels_patrol_1.tres" id="scene_patrol"]
[ext_resource type="Resource" path="res://Scenes/rest.tres" id="scene_rest"]
[ext_resource type="Resource" path="res://Scenes/TunnelsScenes/combat_drills.tres" id="scene_combat_drills"]

[resource]
script = ExtResource("mission_script")
mission_name = "Добро пожаловать в Тоннели"
scenes = [ExtResource("scene_welcome"), ExtResource("scene_chest"), ExtResource("scene_patrol"), ExtResource("scene_rest"), ExtResource("scene_combat_drills")]
location = 2
required_god = 0
