[gd_resource type="Resource" script_class="MissionResource" format=3]

[ext_resource type="Script" path="res://Missions/mission_resource.gd" id="mission_script"]
[ext_resource type="Resource" path="res://Scenes/DepthScenes/depths_patrol_1.tres" id="scene_patrol"]
[ext_resource type="Resource" path="res://Scenes/DepthScenes/volcano_heart_scene.tres" id="scene_noncombat"]
[ext_resource type="Resource" path="res://Scenes/DepthScenes/depths_ambush.tres" id="scene_ambush"]
[ext_resource type="Resource" path="res://Scenes/DepthScenes/depth_beauty.tres" id="scene_beauty"]
[ext_resource type="Resource" path="res://Scenes/DepthScenes/underwater_city.tres" id="scene_combat"]

[resource]
script = ExtResource("mission_script")
mission_name = "Возвращение на Глубину"
scenes = [ExtResource("scene_patrol"), ExtResource("scene_noncombat"), ExtResource("scene_ambush"), ExtResource("scene_beauty"), ExtResource("scene_combat"), ExtResource("scene_patrol")]
location = 9
required_god = 9
