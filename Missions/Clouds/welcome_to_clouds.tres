[gd_resource type="Resource" script_class="MissionResource" format=3]

[ext_resource type="Script" path="res://Missions/mission_resource.gd" id="mission_script"]
[ext_resource type="Resource" path="res://Scenes/CloudsScenes/welcome_clouds.tres" id="scene_welcome"]
[ext_resource type="Resource" path="res://Scenes/CloudsScenes/clouds_treasure_chest.tres" id="scene_chest"]
[ext_resource type="Resource" path="res://Scenes/CloudsScenes/clouds_patrol_1.tres" id="scene_patrol"]
[ext_resource type="Resource" path="res://Scenes/rest.tres" id="scene_rest"]
[ext_resource type="Resource" path="res://Scenes/CloudsScenes/copper_rain.tres" id="scene_copper_rain"]

[resource]
script = ExtResource("mission_script")
mission_name = "Добро пожаловать в Облака"
scenes = [ExtResource("scene_welcome"), ExtResource("scene_chest"), ExtResource("scene_patrol"), ExtResource("scene_rest"), ExtResource("scene_copper_rain")]
location = 3
required_god = 1
