[gd_resource type="Resource" script_class="MissionResource" format=3]

[ext_resource type="Script" path="res://Missions/mission_resource.gd" id="mission_script"]
[ext_resource type="Resource" path="res://Scenes/JungleScenes/welcome_jungle.tres" id="scene_welcome"]
[ext_resource type="Resource" path="res://Scenes/JungleScenes/jungle_treasure_chest.tres" id="scene_chest"]
[ext_resource type="Resource" path="res://Scenes/JungleScenes/jungle_patrol_1.tres" id="scene_patrol"]
[ext_resource type="Resource" path="res://Scenes/rest.tres" id="scene_rest"]
[ext_resource type="Resource" path="res://Scenes/JungleScenes/snake_dance.tres" id="scene_snake_dance"]
[ext_resource type="Resource" path="res://Scenes/JungleScenes/wolf_boy.tres" id="scene_wolf_boy"]
[ext_resource type="Resource" path="res://Scenes/JungleScenes/monkey_statue.tres" id="scene_monkey_statue"]

[resource]
script = ExtResource("mission_script")
mission_name = "Добро пожаловать в Джунгли"
scenes = [ExtResource("scene_welcome"), ExtResource("scene_chest"), ExtResource("scene_patrol"), ExtResource("scene_rest"), ExtResource("scene_snake_dance"), ExtResource("scene_wolf_boy"), ExtResource("scene_monkey_statue")]
location = 12
required_god = 12
