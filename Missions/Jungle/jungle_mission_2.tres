[gd_resource type="Resource" script_class="MissionResource" format=3]

[ext_resource type="Script" path="res://Missions/mission_resource.gd" id="mission_script"]
[ext_resource type="Resource" path="res://Scenes/JungleScenes/jungle_patrol_1.tres" id="scene_patrol"]
[ext_resource type="Resource" path="res://Scenes/JungleScenes/wolf_boy.tres" id="scene_noncombat"]
[ext_resource type="Resource" path="res://Scenes/JungleScenes/jungle_ambush.tres" id="scene_ambush"]
[ext_resource type="Resource" path="res://Scenes/JungleScenes/jungle_beauty.tres" id="scene_beauty"]
[ext_resource type="Resource" path="res://Scenes/JungleScenes/monkey_statue.tres" id="scene_combat"]

[resource]
script = ExtResource("mission_script")
mission_name = "Возвращение в Джунгли"
scenes = [ExtResource("scene_patrol"), ExtResource("scene_noncombat"), ExtResource("scene_ambush"), ExtResource("scene_beauty"), ExtResource("scene_combat"), ExtResource("scene_patrol")]
location = 12
required_god = 12
