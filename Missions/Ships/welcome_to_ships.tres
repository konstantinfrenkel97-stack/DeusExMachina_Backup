[gd_resource type="Resource" script_class="MissionResource" format=3]

[ext_resource type="Script" path="res://Missions/mission_resource.gd" id="mission_script"]
[ext_resource type="Resource" path="res://Scenes/ShipsScenes/welcome_ships.tres" id="scene_welcome"]
[ext_resource type="Resource" path="res://Scenes/ShipsScenes/ships_treasure_chest.tres" id="scene_chest"]
[ext_resource type="Resource" path="res://Scenes/ShipsScenes/ships_patrol_1.tres" id="scene_patrol"]
[ext_resource type="Resource" path="res://Scenes/rest.tres" id="scene_rest"]
[ext_resource type="Resource" path="res://Scenes/ShipsScenes/dolphin_hunt.tres" id="scene_dolphin_hunt"]

[resource]
script = ExtResource("mission_script")
mission_name = "Добро пожаловать на Корабли"
scenes = [ExtResource("scene_welcome"), ExtResource("scene_chest"), ExtResource("scene_patrol"), ExtResource("scene_rest"), ExtResource("scene_dolphin_hunt")]
location = 11
required_god = 10
