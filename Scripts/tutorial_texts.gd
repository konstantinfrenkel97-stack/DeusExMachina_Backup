extends RefCounted
class_name TutorialTexts

## Все тексты обучающей системы — единое место для правок формулировок.
## Используется battle_scene.gd (подсказки по механике боя + подсказка о
## локации) и campaign_screen.gd (подсказка про комнаты/страницу бога/инвентарь
## после первого разговора с богом, и текст всплывающей подсказки "спросите
## бога про дверь"). Иконки характеристик — та же папка Icons/Stats, что
## использует battle_scene.gd (см. STAT_ICON_PATHS там); продублировано здесь
## небольшим списком, чтобы этот файл не зависел от battle_scene.gd.

const _ICON_SIZE := 20
const _ICON_PATHS := {
	"initiative": "res://Icons/Stats/Initiative.png",
	"accuracy": "res://Icons/Stats/Accuracy.png",
	"evasion": "res://Icons/Stats/Evasion.png",
	"attack": "res://Icons/Stats/Attack.png",
	"armor": "res://Icons/Stats/Armor.png",
	"luck": "res://Icons/Stats/Luck.png",
	"glory": "res://Icons/Stats/Glory.png",
	"fantasy": "res://Icons/fantasy_icon.png",
}

## "[иконка] Название" — иконка ставится РЯДОМ с названием характеристики,
## а не вместо него, чтобы новичок мог сопоставить одно с другим.
static func _icon_label(key: String, label: String) -> String:
	var path: String = str(_ICON_PATHS.get(key, ""))
	if path == "" or not ResourceLoader.exists(path):
		return label
	return "[img width=%d height=%d]%s[/img] %s" % [_ICON_SIZE, _ICON_SIZE, path, label]

