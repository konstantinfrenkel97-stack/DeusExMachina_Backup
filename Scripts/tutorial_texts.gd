static func battle_intro_hints() -> Array:
	return [
		"%s определяет порядок ходов в бою. Чем выше инициатива юнита — тем раньше он ходит. Ряд портретов сверху экрана — это очередь: слева тот, кто ходит сейчас, дальше по порядку — следующие. При равной инициативе всегда раньше ходит бог." % _icon_label("initiative", "Инициатива"),
		"В свой ход выберите способность бога, обратите внимание что у способностей есть ограничения по тому откуда их можно применить и по какой цели. Кнопка «Ждать» переносит в конец очереди, кнопка «Пропустить ход», оканчивает ход.",
		"Кроме способностей богов есть заклинания — способности Лены. Они тратят %s (шкала сверху) и доступны в любой момент боя, но можно применить только одно заклинание за раунд." % _icon_label("fantasy", "фантазию"),
	]

static func battle_targeting_hints() -> Array:
	return [
		"Доступные цели подсвечиваются. Вероятность попадания показывает шанс, что атака достигнет цели.",
		"При атаке, из точности %s  атакующего вычитается уклонение %s цели, и так считается вероятность попадания.\n%s Броня уменьшает входящий урон на процент. Но не периодический и не чистый урон. %s Атака умножается на определенный процент, и так определяется сколько урона нанесет способность.\nИногда атака выходит %s — урон удваивается." % [
			_icon_label("accuracy", "Точность"), _icon_label("evasion", "уклонения"),
			_icon_label("attack", "Урон"), _icon_label("armor", "бронёй"),
			_icon_label("luck", "критической"),
		],
		"%s Величие — особый ресурс богов. Оно растёт в бою и тратится на мощные ультимативные способности. Они всегда стоят 100 величия." % _icon_label("glory", "Величие"),
	]

