[gd_resource type="Resource" script_class="MissionSceneResource" format=3 uid="uid://dj177jotyub1l"]

[ext_resource type="Script" uid="uid://565su18o8um0" path="res://Missions/buff_entry.gd" id="buff_script"]
[ext_resource type="Script" uid="uid://djjvdhvrq6wkh" path="res://Missions/mission_choice.gd" id="choice_script"]
[ext_resource type="Script" uid="uid://dvpdwqc5nh1vu" path="res://Missions/mission_outcome.gd" id="outcome_script"]
[ext_resource type="Script" uid="uid://fn4cj3u8rsvt" path="res://Missions/reward.gd" id="reward_script"]
[ext_resource type="Script" uid="uid://dgj8xyl3mmptl" path="res://Missions/mission_scene_resource.gd" id="scene_script"]
[ext_resource type="Resource" path="res://Essence/essence_power.tres" id="essence_reward"]

[sub_resource type="Resource" id="reward_essence"]
script = ExtResource("reward_script")
kind = 1
resource = ExtResource("essence_reward")
amount = 1
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="sr_001"]
script = ExtResource("outcome_script")
result_text = "«Идемте! Именем Осириса, царя царей, я выясню, что случилось на моих землях, и верну ей процветание! Египет заждался своего повелителя!» Неохотно ваш отряд покидает тень и выступает вперед."
rewards = Array[ExtResource("reward_script")]([SubResource("reward_essence")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_002"]
script = ExtResource("choice_script")
choice_text = "Идти вперед"
outcome = SubResource("sr_001")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Добро пожаловать в пустыню"
body_text = "Солнце безжалостно бьет по коже, стоит вам ступить на желтый песок. Единственный, кто неуязвим к стихии, — Осирис: он плывет над дюнами на золотом диске, оглядывая руины древних городов и далекие пирамиды.

«Это странно. Так тихо, так пусто. Совсем не похоже на ту процветающую землю, которой я когда-то правил. Города так близко, но я не вижу караванов… И это солнце? Всегда ли оно было таким жгучим?»

«Идемте! Именем Осириса, царя царей, я выясню, что случилось на моих землях, и верну ей процветание!»"
choices = Array[ExtResource("choice_script")]([SubResource("sr_002")])
