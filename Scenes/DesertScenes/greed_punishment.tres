[sub_resource type="Resource" id="sr_003"]
script = ExtResource("outcome_script")
result_text = "«Сам виноват, сам и расхлебывай». Человек проклинает вас и вашу черствость, а вы идете дальше, оставляя его наедине с проклятием и мумией."
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_004"]
script = ExtResource("choice_script")
choice_text = "Мы не будем решать твои проблемы"
outcome = SubResource("sr_003")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="sr_001"]
script = ExtResource("formation_script")
formation_name = "Стражи гробницы"
pos1 = ExtResource("ext_1")
pos2 = ExtResource("ext_2")
pos3 = ExtResource("ext_2")
pos4 = ExtResource("ext_3")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="sr_002"]
script = ExtResource("battle_script")
formation = SubResource("sr_001")
location_id = "desert"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="sr_005"]
script = ExtResource("outcome_script")
result_text = "«Хорошо! Крипта — за той дюной. Просто убейте чертову мумию!» Вы отправляетесь к крипте, чтобы снять проклятие с незадачливого грабителя."
battle = SubResource("sr_002")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_006"]
script = ExtResource("choice_script")
choice_text = "Ну ладно, мы одолеем мумию"
outcome = SubResource("sr_005")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="sr_009"]
script = ExtResource("outcome_script")
result_text = "Вы тащите вора к крипте, но мумия не намерена разбираться в нюансах: проклятие распространяется и на вас! Эффект: начинается бой."
battle = SubResource("sr_002")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_010"]
script = ExtResource("stat_check_script")
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="sr_007"]
script = ExtResource("reward_script")
kind = 3
resource = ExtResource("ext_4")
amount = 1000
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="sr_008"]
script = ExtResource("outcome_script")
result_text = "Вы связываете вора и оставляете его у входа в крипту — пусть мумия сама разбирается с тем, кто ее ограбил. Из глубины слышно шипение и хруст. Выполнив «правосудие», стражи сокровищницы пропускают вас дальше. Эффект: вы получаете 1000 мыслей из сокровищницы и пропускаете бой."
rewards = Array[ExtResource("reward_script")]([SubResource("sr_007")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_011"]
script = ExtResource("choice_script")
choice_text = "Отдать вора мумии"
stat_check = SubResource("sr_010")
success_outcome = SubResource("sr_008")
failure_outcome = SubResource("sr_009")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Наказание за жадность"
body_text = "По дюнам к вам бежит мужчина, размахивая руками и сжимая посеревшую, осыпающуюся левую руку.

«Помогите! На меня пали злые чары! Неподалеку крипта, а в ней мумия — одолейте ее, чтобы снять проклятие!»

Вы с сомнением смотрите на него. Очевидно, история неполна.

«Ладно! Я хотел разграбить саркофаг, ясно?! Эта чертова мумия меня прокляла. Просто убейте ее!»"
choices = Array[ExtResource("choice_script")]([SubResource("sr_004"), SubResource("sr_006"), SubResource("sr_011")])
