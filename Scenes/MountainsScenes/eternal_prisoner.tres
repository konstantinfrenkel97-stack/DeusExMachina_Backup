success_outcome = SubResource("out_take_life_success")
failure_outcome = SubResource("out_take_life_failure")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="out_free_him"]
script = ExtResource("outcome_script")
result_text = "Лик Зевса стал мрачен. Иногда на веселого старика накатывали моменты серьезности, но сейчас он был темен как ночь, неотрывно глядя в глаза пленнику прикованному к скале. Божество плавно приблизилось к скованному, летя сквозь воздух.\n\"Мне мало что есть сказать тебе.\"\nЕго голос тихо.\n\"Ты никогда не поймешь меня, и никогда не простишь. Я и сам себя не прощу.\"\nВзгляд Зевса обратился внутрь.\n\"Каждый из нас платит цену...\"\nНад горами повисла тишина. Словно сам ветер замер вслушиваясь в слова громовержца.\n\"Я освобождаю тебя!\"\nСлова как гром пронеслись над пиками. И горы вторили \"Освобождаю... Освобождаю...\"\nЧеловек вкованный в камень не отреагировал. Поначалу. Потом в нем дрогнул кончик пальца. Потом второй. Потом он открыл глаза. Выдохнул. Повернул голову. Посмотрел в лицо владыке Олимпа. Тот смотрел в ответ. Пленник сжал кулаки и дернул руками. Камень затрещал и цепи вылетели. Он сделал шаг, потом еще шаг. Потом еще шаг. Повернул голову и посмотрел в лицо Зевса. На нем было невозможно что-либо прочитать. Потом побрел прочь. Вы проводили его взглядом.\n\"Идем.\" - сказал Зевс, и вы пошли."
target_god_immediate = ExtResource("zeus")
target_god_immediate_majesty_delta = -1000
permanent_god_crit_bonus_target = ExtResource("zeus")
permanent_god_crit_bonus_amount = 0.02
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_free_him"]
script = ExtResource("choice_script")
choice_text = "Освободить его"
required_god = ExtResource("zeus")
outcome = SubResource("out_free_him")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Вечный узник"
body_text = "Над вами пролетает огромный орел. Размах его крыльев соответствует масштабу могучих гор, но не только красота привлекает вас. Вы видите как орел садится за скальной грядой. Там может быть что-то полезное.\n\nВы немного смещаете маршрут, и следуете туда куда сел орёл. Пока вы взбирались, он улетел. Тем лучше. В этих горах ничего не происходит просто так, и вам не терпится посмотреть, что же привлекло крылатого хищника. Правда открывается вам за поворотом. К скале прикован человек, он гол. Его грудная клетка разорвана, вы видите пугающую красную дыру, из которой обильно стекает кровь. Все тело, кроме лица и груди покрыто горной пылью, словно он провел здесь многие годы. Он не двигается и никак не проявляет что жив. Но когда вы подходите, вы чувствуете его едва заметное дыхание. Рана зарастает прямо у вас на глазах. Вы видите как нарастает новая ткань, как закрывается яма в теле, высыхает кровь оставляя широкую коричневую полосу на теле, да пятно у ног. Он снова цел. У вас нет сомнений, орел прилетит еще раз, чтобы клевать тело пленника."
choices = Array[ExtResource("choice_script")]([SubResource("choice_break_chains"), SubResource("choice_take_life"), SubResource("choice_free_him")])
metadata/_custom_type_script = ExtResource("scene_script")
