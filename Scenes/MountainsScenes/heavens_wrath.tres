[sub_resource type="Resource" id="outcome_6"]
script = ExtResource("s_outcome")
result_text = "Гром становится все яростнее.
\"ЗЕВС! ЗЕВС! ЗЕВС!\"
Голубой свет молний бушует в черноте туч и обрисовывает силуэт - согнутый человек, держащий на плечах шар невероятной величины, вам даже не видно верхний конец шара, он исчезает в облаках.

Вы не дожидаетесь пока он обрушит на вас очередную молнию и первыми швыряете заклинание в середину туч. В тот же момент, на вас обрушивается молния. Трескучая, голубая, знакомая. Молния Зевса. Едва придя в себя вы прячетесь за каменный выступ, а у вас над головами пролетает еще одна молния. Потом еще и еще. Что же до вашей атаки, то вы не уверены, достигла ли она вообще своей цели. И не похоже что сможете узнать.

Но одно вам точно известно - у вас появился враг, и враг очень опасный.

Вам известен ваш Немезис."
hero_hp_percent_delta = -5
nemesis_enemy_hp_percent = 2
nemesis_buff_location_id = "mountains"
metadata/_custom_type_script = ExtResource("s_outcome")

