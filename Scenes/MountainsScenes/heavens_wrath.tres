[sub_resource type="Resource" id="check_1"]
script = ExtResource("s_check")
stat = 3
stat_label = "Уклонение"
metadata/_custom_type_script = ExtResource("s_check")

[sub_resource type="Resource" id="outcome_2"]
script = ExtResource("s_outcome")
result_text = "Гром становится все яростнее.
\"ЗЕВС! ЗЕВС! ЗЕВС!\"
Голубой свет молний бушует в черноте туч и обрисовывает силуэт - согнутый человек, держащий на плечах шар невероятной величины, вам даже не видно верхний конец шара, он исчезает в облаках.

Но у вас нет времени разглядывать удивительную картину, вы ныряете за каменный выступ и в этот момент у вас над головами с треском проносится голубая молния. Знакомая. Прямо такая как у Зевса. Кто-то, силуэт в облаках завладел его силой. И он видел вас, он знает вас. И едва ли его можно назвать дружелюбным.

Вам известен ваш Немезис."
metadata/_custom_type_script = ExtResource("s_outcome")

[sub_resource type="Resource" id="outcome_3"]
script = ExtResource("s_outcome")
result_text = "Гром становится все яростнее.
\"ЗЕВС! ЗЕВС! ЗЕВС!\"
Голубой свет молний бушует в черноте туч и обрисовывает силуэт - согнутый человек, держащий на плечах шар невероятной величины, вам даже не видно верхний конец шара, он исчезает в облаках.

Лишь на секунду ваш взгляд задержался, и этого времени хватило. В вас с треском ударяет молния. Голубая, обжигающая, знакомая. Молния Зевса. Кожа чернеет. Будь на вашем месте смертный, его бы мгновенно убило.

Вы приходите в себя и прячетесь за каменный выступ. Фигура с шаром на плечах что многократно больше его самого, овладевший магией Зевса. Он знает вас, и он вас атаковал. Путешествие по горам только что стало гораздо опаснее.

Вам известен ваш Немезис."
hero_hp_percent_delta = -5
metadata/_custom_type_script = ExtResource("s_outcome")

