[resource]
script = ExtResource("s_scene")
scene_title = "Претендент и фаворит"
body_text = "\"Да вытрет он ноги об твоего Сета, слышишь.\"
\"Да ты ваще не шаришь, че говоришь. Ты их бой один хоть видел?\"
\"Ну, мне рассказали.\"
\"Да я те ору, если кто и может Гераклу вообще чет сделать, то это Великолепный Сет. Я те ору, братан, эти морды — они вообще чокнутые.\"
\"Ты чокнутый. Ну сам подумай. Сколько таких претендентов было до этого? А это Геракл. Ты понимаешь? Геракл! Стимфалийские птицы, лернейский лев. Он как пришел на арену, так и остался чемпионом. Ты понимаешь это? Вот какие-то выскочки с арены возьмут и победят величайшего героя человечества?\"

Не похоже, что беседа, которую вы невольно подслушиваете, собирается прийти к какому-то осмысленному финалу. Но предмет разговора вас заинтересовал. Геракл, чемпион арены."
choices = Array[ExtResource("s_choice")]([SubResource("choice_listen"), SubResource("choice_train"), SubResource("choice_gift")])
metadata/_custom_type_script = ExtResource("s_scene")
