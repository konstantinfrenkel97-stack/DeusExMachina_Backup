[sub_resource type="Resource" id="check_luck"]
script = ExtResource("s_check")
stat = 5
stat_label = "Удача"
metadata/_custom_type_script = ExtResource("s_check")

[sub_resource type="Resource" id="buff_luck"]
script = ExtResource("s_buff")
stat = 1
value = 5
duration = -1
metadata/_custom_type_script = ExtResource("s_buff")

[sub_resource type="Resource" id="outcome_listen_success"]
script = ExtResource("s_outcome")
result_text = "Болтовня болельщиков может оказаться неожиданно полезной. Если вы продолжите продвигаться на арене, рано или поздно чемпион станет препятствием.
\"Да ты гонишь? У него вообще из приколов только правый кулак да левый кулак.\"
\"Пока что этого было достаточно.\"
\"Да ты вообще видел, что сетовцы вытворяют? Они же вообще больные! У них там пески, шары какие-то волшебные летают.\"
\"Ничего не работает против простой силы. Ты сам видел, как он дерется. Удары, может, и простые, только чем дольше идет бой, тем сильнее он становится.\"
\"И че?!\"
\"Ты знаешь, мне кажется, тебе стоит поработать над аргументацией.\"
\"Я лучше пойду над мамкой твоей поработаю.\"
\"...\"
Они ушли. Было ли время потрачено зря? Вы узнали о способностях врага. Простые удары кулаками — в целом, для арены это ожидаемо. Но вот вторая часть вызывает беспокойство. Становится тем сильнее, чем дольше идет бой. У вас есть возможность подготовиться.

Вам известен ваш Немезис."
nemesis_buff_stat = SubResource("buff_luck")
nemesis_buff_location_id = "arena"
nemesis_buff_all_heroes = true
metadata/_custom_type_script = ExtResource("s_outcome")

[sub_resource type="Resource" id="outcome_listen_failure"]
script = ExtResource("s_outcome")
result_text = "Болтовня болельщиков может оказаться неожиданно полезной. Если вы продолжите продвигаться на арене, рано или поздно чемпион станет препятствием.
\"Ты, блин, урод. Ты вообще видел, что команда Великолепного Сета вытворяет? Да ты ниче не видел и только базаришь.\"
\"Слушай, я понимаю, о чем ты говоришь...\"
\"Да че ты нахрен понимаешь? Ты меня послушай.\"
\"...\"
\"Он, короче, делает песком так Шуууууу! А потом когтями Жах-жах! А потом такой А-ха-ха-ха-ха и выдает вообще чето нереальное! Понял теперь?\"
\"Понял.\"
\"Да ничего ты не понял.\"
\"Ага, как скажешь.\"
\"Не, я не закончу, пока ты не поймешь. Еще раз, сначала шууууу...\"
Они удалились. Это было неинформативно и даже не очень-то лестно. Чемпион. Геракл. Знаменитый герой. Каков он? Нет сомнений, что, продолжая продвигаться по арене, вы рано или поздно пересечетесь с ним. Нужно подготовиться.

Вам известен ваш Немезис."
metadata/_custom_type_script = ExtResource("s_outcome")

[sub_resource type="Resource" id="choice_listen"]
script = ExtResource("s_choice")
