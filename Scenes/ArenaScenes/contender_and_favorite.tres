failure_outcome = SubResource("outcome_listen_failure")
metadata/_custom_type_script = ExtResource("s_choice")

[sub_resource type="Resource" id="buff_attack"]
script = ExtResource("s_buff")
stat = 0
value = 4
duration = -1
metadata/_custom_type_script = ExtResource("s_buff")

[sub_resource type="Resource" id="outcome_train"]
script = ExtResource("s_outcome")
result_text = "Геракл. Чемпион арены. Нет сомнений, что, продолжая сражаться, вы столкнетесь с ним. Непобедимый герой.

Вы свое навоевали. Что в прошлой жизни, что в предыдущей. Привыкли полагаться на свою силу, испытанную против самых страшных врагов, но сейчас вас захватило что-то новое. Вас захватил дух арены. Вы сражаетесь не чтобы выжить, не чтобы одолеть страшное чудовище. А чтобы показать свою силу. Чтобы быть лучшим. Чтобы быть первым. Давно у вас не было желания потратить время на то, чтобы сделать вашу божественную силу еще больше. Но дух арены берет свое.

Вы отправляетесь, чтобы укрепить тело, нарастить магию. Непобедимый чемпион Геракл, жди нас!

Вам известен ваш Немезис."
nemesis_buff_stat = SubResource("buff_attack")
nemesis_buff_location_id = "arena"
nemesis_buff_all_heroes = true
metadata/_custom_type_script = ExtResource("s_outcome")

[sub_resource type="Resource" id="choice_train"]
script = ExtResource("s_choice")
choice_text = "Усиленно тренироваться"
outcome = SubResource("outcome_train")
metadata/_custom_type_script = ExtResource("s_choice")

