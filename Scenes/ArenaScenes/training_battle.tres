[gd_resource type="Resource" script_class="MissionSceneResource" format=3]

[ext_resource type="Script" path="res://Missions/mission_scene_resource.gd" id="scene_script"]
[ext_resource type="Script" path="res://Missions/mission_choice.gd" id="choice_script"]
[ext_resource type="Script" path="res://Missions/mission_outcome.gd" id="outcome_script"]
[ext_resource type="Script" path="res://Missions/formation_resource.gd" id="formation_script"]
[ext_resource type="Script" path="res://Missions/battle_config.gd" id="battle_script"]
[ext_resource type="Script" path="res://Missions/buff_entry.gd" id="buff_script"]
[ext_resource type="Resource" path="res://Enemies/Civilization/Arena/Novice/Novice.tres" id="novice"]
[ext_resource type="Resource" path="res://Enemies/Civilization/Arena/Mentor/Mentor.tres" id="mentor"]

[sub_resource type="Resource" id="form_training"]
script = ExtResource("formation_script")
formation_name = "Новичок-Новичок-Новичок-Тренер"
pos1 = ExtResource("novice")
pos2 = ExtResource("novice")
pos3 = ExtResource("novice")
pos4 = ExtResource("mentor")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="battle_training"]
script = ExtResource("battle_script")
formation = SubResource("form_training")
location_id = "arena"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="buff_nonlethal_attack"]
script = ExtResource("buff_script")
stat = 0
value = -10
duration = -1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="out_nonlethal_default"]
script = ExtResource("outcome_script")
result_text = "Вы решаете сдерживать силу ударов — новички не заслуживают того, чтобы отправиться на тот свет за свою самонадеянность. Немного жертвуя точностью и силой удара, вы всё же готовы вступить в бой."
battle = SubResource("battle_training")
hero_buffs = Array[ExtResource("buff_script")]([SubResource("buff_nonlethal_attack")])
hero_majesty_delta = 10
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_nonlethal"]
script = ExtResource("choice_script")
choice_text = "Атаковать так, чтобы не убить"
outcome = SubResource("out_nonlethal_default")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="out_ignore_default"]
script = ExtResource("outcome_script")
result_text = "Традиции есть традиции, но вы явились сюда не ради зрелища. Вы отбрасываете условности — бой есть бой, а тратить силы на сдержанность сейчас не время."
battle = SubResource("battle_training")
hero_majesty_delta = -10
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_ignore"]
script = ExtResource("choice_script")
choice_text = "Пренебречь традициями"
outcome = SubResource("out_ignore_default")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Тренировочный бой"
body_text = "«КОМАНДА ВЕЛИКОЛЕПНОГО СЕТАААААААА!!!»

Голос диктора разлетается над ареной и тонет в аплодисментах. Из другого конца появляется вторая группа. Трое новичков и лысый тренер, раздающий команды. Одного из юношей вы как будто видели раньше.

«Совсем новички, за своё рвение они получили право выступить на арене под присмотром одного из инструкторов. Хотя нет правил насчёт убийства на этих священных песках, но по доброй традиции, в таких боях опытные бойцы используют несмертельные удары.»

«ПОМНИТЕ, ВСЕ ВЫ КОГДА-ТО БЫЛИ НА ИХ МЕСТЕ!!!!»

Диктор анонсирует просьбу насчёт убийств, и публика поддерживает его криками. Традиция традицией, но вы не обязаны следовать ей."
choices = Array[ExtResource("choice_script")]([SubResource("choice_nonlethal"), SubResource("choice_ignore")])
metadata/_custom_type_script = ExtResource("scene_script")
