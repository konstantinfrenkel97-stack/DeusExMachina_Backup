"arena_fan_blessing": SubResource("out_c2_blessing"),
"arena_fan_peace": SubResource("out_c2_peace"),
"arena_fan_traitor": SubResource("out_c2_traitor"),
"arena_fan_weak_traitor": SubResource("out_c2_weak_traitor")
}
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Тренировочный бой"
body_text = "«КОМАНДА ВЕЛИКОЛЕПНОГО СЕТААААААА!!!»\n\nГолос диктора разлетается над ареной и тонет в аплодисментах. Из другого конца появляется вторая группа. Трое новичков и лысый тренер, раздающий команды. Одного из юношей вы как будто видели раньше.\n\n«Совсем новички, за своё рвение они получили право выступить на арене под присмотром одного из инструкторов. Хотя нет правил насчёт убийства на этих священных песках, но по доброй традиции, в таких боях опытные бойцы используют несмертельные удары.»\n\n«ПОМНИТЕ, ВСЕ ВЫ КОГДА-ТО БЫЛИ НА ИХ МЕСТЕ!!!!»\n\nДиктор анонсирует просьбу насчёт убийств, и публика поддерживает его криками. Традиция традицией, но вы не обязаны следовать ей."
choices = [SubResource("choice_c1"), SubResource("choice_c2")]
