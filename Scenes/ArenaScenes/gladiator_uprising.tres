location_id = "arena"
metadata/_custom_type_script = ExtResource("s_battle")

[sub_resource type="Resource" id="outcome_5"]
script = ExtResource("s_outcome")
result_text = "Вы бросаетесь вслед за убийцами. В путаных коридорах арены шаги отдаются эхом, вскоре вы уже видите их. Они также замечают погоню, и начинают на бегу ронять интерьер, создавая для вас препятствия. Вы перепрыгиваете и продолжаете погоню. Кто-то кричит:
\"Лови беглых рабов! Награда тому кто поймает!\"
Вам под ноги летят дорогие вазы, бюсты, скамейки. Беглецы исчезают за углом. Вы ныряете, как навстречу вам летит резко открытая дверь. В последний момент успеваете вы уклониться. Из прохода выскакивают гладиаторы и бросаются на вас."
thoughts_delta = 400
battle = SubResource("battle_4")
metadata/_custom_type_script = ExtResource("s_outcome")

[sub_resource type="Resource" id="buff_6"]
script = ExtResource("s_buff")
stat = 3
value = -5
duration = 1
metadata/_custom_type_script = ExtResource("s_buff")

[sub_resource type="Resource" id="battle_7"]
script = ExtResource("s_battle")
formation = SubResource("formation_1")
location_id = "arena"
metadata/_custom_type_script = ExtResource("s_battle")

[sub_resource type="Resource" id="outcome_8"]
script = ExtResource("s_outcome")
result_text = "Вы бросаетесь вслед за убийцами. В путаных коридорах арены шаги отдаются эхом, вскоре вы уже видите их. Они также замечают погоню, и начинают на бегу ронять интерьер, создавая для вас препятствия. Вы перепрыгиваете и продолжаете погоню. Кто-то кричит:
\"Лови беглых рабов! Награда тому кто поймает!\"
Вам под ноги летят дорогие вазы, бюсты, скамейки. Беглецы исчезают за углом. Вы ныряете, как навстречу вам летит резко открытая дверь.

Удар в лоб, первый бог что бежал теряет равновесие и отлетает на союзников. Из-за двери выскакивают гладиаторы и с оружием бросаются на вас."
battle = SubResource("battle_7")
hero_buffs = Array[ExtResource("s_buff")]([SubResource("buff_6")])
metadata/_custom_type_script = ExtResource("s_outcome")

