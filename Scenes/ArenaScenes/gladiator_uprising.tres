[sub_resource type="Resource" id="outcome_24"]
script = ExtResource("s_outcome")
result_text = "Вы мгновенно понимаете ситуацию, и также быстро принимаете решение. Вы хватаете тела и оттаскиваете в свою раздевалку. Тут вы начинаете пускать в ход божественные чары. Тела начинают помаленьку исчезать, когда к вам врываются несколько стражей арены. Они видят вас, видят тела, видят следы крови. Вас застали на месте преступления. Нечего доказывать и объяснять. Вы решили помочь гладиаторам обрести свободу, решили уничтожить тела. Но увы, тел будет больше чем планировалось."
rewards = Array[ExtResource("s_reward")]([SubResource("reward_23")])
battle = SubResource("battle_22")
metadata/_custom_type_script = ExtResource("s_outcome")

