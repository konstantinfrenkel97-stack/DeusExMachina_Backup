[sub_resource type="Resource" id="outcome_17"]
script = ExtResource("s_outcome")
result_text = "\"Не сопротивляйтесь, и никто не пострадает.\"
Вы начинаете звать стражу. Она оказывается здесь через секунду. Вы объясняете им ситуацию, про восставших гладиаторов, показываете куда они побежали. Один из стражников берет бога за ту руку, которой он указывал направление побега, нацепляет на нее наручники, и быстро застегивает их на второй руке.
\"Убийцы, ложитесь на пол! Ну, живо!\"
Вы пытаетесь объяснить, что вы не убийцы, и они неправильно вас поняли, но не похоже что они вообще вас слышать. Тяжело выдохнув вы беретесь за оружие. Одна проблема за другой."
battle = SubResource("battle_16")
metadata/_custom_type_script = ExtResource("s_outcome")

