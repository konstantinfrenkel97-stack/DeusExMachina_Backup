metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="mod_duel_berserk"]
script = ExtResource("unit_modifier_script")
target_position = 1
hp_percent = 80
passive_charges = 8
buffs = Array[ExtResource("buff_script")]([SubResource("buff_damage_minus20")])
metadata/_custom_type_script = ExtResource("unit_modifier_script")

[sub_resource type="Resource" id="form_duel"]
script = ExtResource("formation_script")
formation_name = "Дуэль с берсерком"
pos1 = ExtResource("enemy_berserk")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="battle_duel"]
script = ExtResource("battle_script")
formation = SubResource("form_duel")
enemy_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("mod_duel_berserk")])
location_id = "helheim"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="reward_berserker_claws"]
script = ExtResource("reward_script")
resource = ExtResource("item_berserker_claws")
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="out_duel"]
script = ExtResource("outcome_script")
result_text = "Локи в одиночку выходит на плато, где безумствует берсерк. Боги замирают, замирает и окружающая нежить. Одинокий бог идет, широко расправив руки, ладони открыты. Драугр замечает врага, и, направляясь к нему, отрывает собственную руку с когтями, бросая оппоненту оружие. Вы получаете артефакт «Когти берсерка»."
battle = SubResource("battle_duel")
rewards = Array[ExtResource("reward_script")]([SubResource("reward_berserker_claws")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_loki_duel"]
script = ExtResource("choice_script")
choice_text = "Устроить дуэль с берсерком"
required_god = ExtResource("loki")
outcome = SubResource("out_duel")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Бесконечная ярость"
body_text = "Пробираясь через туман, вы слышите скрежет металла и звуки ударов. Выглядывая из-за камней, вы обнаруживаете одинокого драугра в звериной шкуре. Он мечется, размахивая руками, и из раза в раз вонзает когти в собственное тело. Как ребенок, притворяющийся рыцарем, он то наносит удары невидимому противнику, то самому себе. Прежде чем вы можете что-то сделать, вы замечаете, что его безумная игра уже собрала вокруг орду нежити."
choices = Array[ExtResource("choice_script")]([SubResource("choice_kill"), SubResource("choice_escape"), SubResource("choice_loki_duel")])
