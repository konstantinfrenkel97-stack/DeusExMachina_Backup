enemy_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("mod_berserk80_luck")])
location_id = "helheim"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_escape_fail"]
script = ExtResource("outcome_script")
result_text = "Вам не удалось достаточно быстро прорубить себе путь сквозь нежить, и вы видите, как на четвереньках, подобно зверю, к вам мчится безумный берсерк."
battle = SubResource("battle_escape_fail")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="check_initiative"]
script = ExtResource("stat_check_script")
stat = 1
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="form_escape"]
