[sub_resource type="Resource" id="mod_berserk80_stacks7"]
script = ExtResource("unit_modifier_script")
target_position = 1
hp_percent = 80
passive_charges = 7
metadata/_custom_type_script = ExtResource("unit_modifier_script")

[sub_resource type="Resource" id="form_initial"]
script = ExtResource("formation_script")
formation_name = "Бесконечная ярость: Берсерк-Берсерк-Банши-Рейдер"
pos1 = ExtResource("enemy_berserk")
pos2 = ExtResource("enemy_berserk")
pos3 = ExtResource("enemy_banshee")
pos4 = ExtResource("enemy_raider")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="battle_kill_fail"]
script = ExtResource("battle_script")
formation = SubResource("form_initial")
enemy_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("mod_berserk80_stacks7")])
location_id = "helheim"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_kill_fail"]
script = ExtResource("outcome_script")
result_text = "Прежде чем вы добираетесь до безумца, на вас набрасывается орда нежити."
battle = SubResource("battle_kill_fail")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="check_attack"]
