pos2 = ExtResource("enemy_banshee")
pos3 = ExtResource("enemy_raider")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="battle_escape_success"]
script = ExtResource("battle_script")
formation = SubResource("form_escape")
location_id = "helheim"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_escape_success"]
script = ExtResource("outcome_script")
result_text = "Ваша скорость и сила оружия прорубают вам путь через орду нежити, безумный берсерк остается позади."
battle = SubResource("battle_escape_success")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_escape"]
script = ExtResource("choice_script")
