[sub_resource type="Resource" id="out_kill_success"]
script = ExtResource("outcome_script")
result_text = "Вы обрушиваете свое оружие на безумца, его кости трещат, а мышцы рвутся. Прежде чем вас настигает орда нежити, он превращается в едва живой останок."
battle = SubResource("battle_kill_success")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_kill"]
