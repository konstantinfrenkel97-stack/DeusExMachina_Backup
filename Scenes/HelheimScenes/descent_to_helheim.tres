[gd_resource type="Resource" script_class="MissionSceneResource" format=3]

[ext_resource type="Script" path="res://Missions/mission_scene_resource.gd" id="scene_script"]
[ext_resource type="Script" path="res://Missions/mission_choice.gd" id="choice_script"]
[ext_resource type="Script" path="res://Missions/mission_outcome.gd" id="outcome_script"]
[ext_resource type="Script" path="res://Missions/formation_resource.gd" id="formation_script"]
[ext_resource type="Script" path="res://Missions/battle_config.gd" id="battle_script"]
[ext_resource type="Script" path="res://Missions/unit_modifier.gd" id="unit_modifier_script"]
[ext_resource type="Script" path="res://Missions/buff_entry.gd" id="buff_script"]
[ext_resource type="Script" path="res://Missions/stat_check.gd" id="stat_check_script"]
[ext_resource type="Script" path="res://Missions/reward.gd" id="reward_script"]
[ext_resource type="Resource" path="res://Enemies/Dungeon/Hellheim/Draugr_raider/Draugr_raider.tres" id="enemy_raider"]
[ext_resource type="Resource" path="res://Enemies/Dungeon/Hellheim/Banshee/banshee.tres" id="enemy_banshee"]
[ext_resource type="Resource" path="res://Enemies/Dungeon/Hellheim/Draugr_Juggernaut/Draugr_Juggernaut.tres" id="enemy_juggernaut"]
[ext_resource type="Resource" path="res://Essence/thoughts.tres" id="thoughts"]
[sub_resource type="Resource" id="form_welcome"]
script = ExtResource("formation_script")
formation_name = "Хельхейм приветствует: Рейдер-Рейдер-Баньши"
pos1 = ExtResource("enemy_raider")
pos2 = ExtResource("enemy_raider")
pos3 = ExtResource("enemy_banshee")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="battle_welcome"]
script = ExtResource("battle_script")
formation = SubResource("form_welcome")
location_id = "helheim"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_welcome"]
script = ExtResource("outcome_script")
result_text = "Нежить окружает вас. Пустые глазницы черепов и руны на дряхлом оружии излучают голубое сияние."
battle = SubResource("battle_welcome")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_welcome"]
script = ExtResource("choice_script")
choice_text = "Хельхейм приветствует вас"
outcome = SubResource("out_welcome")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Нисхождение в Хельхейм"
body_text = "Черные скалы, мертвые деревья и белый туман встречают вас. Среди мертвой земли бродят мрачные фигуры драугров, иногда кидаясь друг на друга в приступе ярости. Нежить, живущая лишь воспоминаниями о былых сражениях, они рыщут в поисках хоть капли жизни, на которую они могли бы обрушить свою бесконечную ярость и жажду крови. Скорбный плач баньши сопровождает их бесцельные поиски.\n\nВы петляете среди скал, когда внезапно оказываетесь полностью поглощенными туманом. Холод и влага словно высасывают из вас жизнь. Ваши цели становятся все дальше, эмоции притупляются. Вы забываете что вообще делаете, в чем смысл, к какой цели двигаетесь и почему это важно. Остается только пустота, усталость и странная скорбь. Но вы не помните что именно утрачиваете.\n- За мной, - тихо говорит Локи. Группа бездумно следует за ним. Он их единственный маяк в этом темном мире. Единственная причина двигаться.\n\nОн выводит группу на пустой участок свободный от тумана.\n- Нужно привыкнуть. - говорит Локи. - Этот туман... Сложный. Говорю сразу, легче не станет. Чувство останется таким же тошнотворным. Но постепенно привыкнете. Будет проще действовать. Главное воля, заставляйте себя делать то, что раньше казалось вам важным. Даже если не можете вспомнить почему это важно. Заставляйте , себя.\n\nПока Локи объяснял, вы замечаете отряд нежити наступающий на вас из тумана."
choices = [SubResource("choice_welcome")]