[gd_resource type="Resource" script_class="MissionSceneResource" format=3]

[ext_resource type="Script" path="res://Missions/mission_scene_resource.gd" id="scene_script"]
[ext_resource type="Script" path="res://Missions/mission_choice.gd" id="choice_script"]
[ext_resource type="Script" path="res://Missions/mission_outcome.gd" id="outcome_script"]
[ext_resource type="Script" path="res://Missions/formation_resource.gd" id="formation_script"]
[ext_resource type="Script" path="res://Missions/battle_config.gd" id="battle_script"]
[ext_resource type="Script" path="res://Missions/unit_modifier.gd" id="unit_modifier_script"]
[ext_resource type="Script" path="res://Missions/buff_entry.gd" id="buff_script"]
[ext_resource type="Script" path="res://Missions/stat_check.gd" id="stat_check_script"]
[ext_resource type="Script" path="res://Missions/reward.gd" id="reward_script"]
[ext_resource type="Resource" path="res://Enemies/Dungeon/Hellheim/Draugr_raider/Draugr_raider.tres" id="enemy_raider"]
[ext_resource type="Resource" path="res://Enemies/Dungeon/Hellheim/Banshee/banshee.tres" id="enemy_banshee"]
[ext_resource type="Resource" path="res://Enemies/Dungeon/Hellheim/Draugr_Juggernaut/Draugr_Juggernaut.tres" id="enemy_juggernaut"]
[ext_resource type="Resource" path="res://Essence/thoughts.tres" id="thoughts"]
[sub_resource type="Resource" id="form_chest_fail"]
script = ExtResource("formation_script")
formation_name = "Ловушка сундука: Джаггернаут-Рейдер-Рейдер-Баньши"
pos1 = ExtResource("enemy_juggernaut")
pos2 = ExtResource("enemy_raider")
pos3 = ExtResource("enemy_raider")
pos4 = ExtResource("enemy_banshee")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="battle_chest_fail"]
script = ExtResource("battle_script")
formation = SubResource("form_chest_fail")
location_id = "helheim"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="reward_thoughts_800"]
script = ExtResource("reward_script")
kind = 3
resource = ExtResource("thoughts")
amount = 800
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="reward_thoughts_700"]
script = ExtResource("reward_script")
kind = 3
resource = ExtResource("thoughts")
amount = 700
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="buff_strongest_init_minus1"]
script = ExtResource("buff_script")
stat = 6
value = -1
duration = -1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="out_open_success"]
script = ExtResource("outcome_script")
result_text = "Вы ловко вскрываете сундук. Точная и элегантная работа. Внутри полно украшений, драгоценных камней и фарфора. Не понятно зачем они вам на плане фантазий, но решив что могут пригодиться, вы берете их с собой. ?? ?????????????????????????????????????????? 800 ??????????????????????????."
rewards = [SubResource("reward_thoughts_800")]
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="out_open_fail"]
script = ExtResource("outcome_script")
result_text = "Замок никак вам не поддается, один за другим боги пробуют, дают друг другу советы и лезут под руку. Когда, наконец, с щелчком открывается замок - вы замечаете что окружены со всех сторон. ?? ?????????????????????????????????????????? 800 ??????????????????????????."
battle = SubResource("battle_chest_fail")
rewards = [SubResource("reward_thoughts_800")]
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="out_break_success"]
script = ExtResource("outcome_script")
result_text = "Парой точных ударов вы разламываете сундук на части. Внутри находятся золотые монеты, украшения, драгоценные камни, и битый украшенный фарфор. Хотя не вся добыча пережила кенетическое воздействие, вы так или иначе обогатились. Но зачем вам золото в этом мире? ?? ?????????????????????????????????????????? 700 ??????????????????????????."
rewards = [SubResource("reward_thoughts_700")]
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="out_break_fail"]
script = ExtResource("outcome_script")
result_text = "Сундук не поддается вашим ударом. Один за другим вы обрушиваете сокрушительные атаки, пока наконец сундук не разваливается в труху. К сожалению, та же судьба постигла содержимое: разбитый фарфор, погнутое золото, треснутые драгоценные камни. Во истину, сила богов пугает. ????????????????????? ?? ??????????????????????????????????."
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="out_take"]
script = ExtResource("outcome_script")
result_text = "Сильнейший из ваших богов берет сундук с собой, чтобы открыть в безопасной обстановке убежища. К сожалению, даже для бога - сундучишко весьма тяжел. Драться с ним будет совсем не сподручно. Персонаж с наибольшей атакой получает штраф 1 инициативы до конца миссии."
strongest_hero_buffs = Array[ExtResource("buff_script")]([SubResource("buff_strongest_init_minus1")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="check_accuracy"]
script = ExtResource("stat_check_script")
stat = 4
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="check_attack"]
script = ExtResource("stat_check_script")
stat = 0
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="choice_open"]
script = ExtResource("choice_script")
choice_text = "Попытаться открыть сундук"
stat_check = SubResource("check_accuracy")
success_outcome = SubResource("out_open_success")
failure_outcome = SubResource("out_open_fail")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="choice_break"]
script = ExtResource("choice_script")
choice_text = "Разломать сундук"
stat_check = SubResource("check_attack")
success_outcome = SubResource("out_break_success")
failure_outcome = SubResource("out_break_fail")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="choice_take"]
script = ExtResource("choice_script")
choice_text = "Взять сундук с собой"
outcome = SubResource("out_take")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Сундук с сокровищами (Хельхейм)"
body_text = "Сундук. Он стоит на видном месте. Выглядит так, будто он полон сокровищ, но так ли это?"
choices = [SubResource("choice_open"), SubResource("choice_break"), SubResource("choice_take")]