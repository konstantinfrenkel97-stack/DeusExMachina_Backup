[sub_resource type="Resource" id="reward_1"]
script = ExtResource("s_reward")
kind = 1
resource = ExtResource("r_death")
metadata/_custom_type_script = ExtResource("s_reward")

[sub_resource type="Resource" id="outcome_2"]
script = ExtResource("s_outcome")
result_text = "Он растерянно смотрит на вас.
“Что значит нет выхода? А как же вы сами? Вы не выглядите мертвыми.”
Вы пытаетесь объяснить юноше, что вы живые, и поэтому можете вернуться. Но у него такой возможности нет, потому что он мертв. Бальдр поднимает полупрозрачные руки.
“Нет-нет-нет, вы не поняли. Я не могу быть мертв. Я не должен быть мертв. Меня ничего не может убить, мама договорилась..”
Вы указываете на стрелу торчащую у него из сердца. Он обиженно отворачивается.
“Ну и ладно! Не хотите помогать, и не надо! За мной еще придут, вот увидите, и заберут из этого проклятого места!”
Вы пытаетесь его догнать, но он растворяется в тумане. Призрак бессмертного юноши, убитого по прихоти капризного бога обмана. Вы чувствуете, что еще встретитесь.

Вам известен ваш Немезис."
rewards = Array[ExtResource("s_reward")]([SubResource("reward_1")])
metadata/_custom_type_script = ExtResource("s_outcome")

[sub_resource type="Resource" id="choice_3"]
script = ExtResource("s_choice")
choice_text = "Из Хельхейма нет выхода"
outcome = SubResource("outcome_2")
metadata/_custom_type_script = ExtResource("s_choice")

[sub_resource type="Resource" id="reward_4"]
script = ExtResource("s_reward")
kind = 1
resource = ExtResource("r_chaos")
metadata/_custom_type_script = ExtResource("s_reward")

[sub_resource type="Resource" id="outcome_5"]
script = ExtResource("s_outcome")
result_text = "Вы не понимаете как можно помочь, но страдания бедняги ранят сердце. Его глаза широко раскрываются, а на лице расцветает улыбка.
“Спасибо! Спасибо большое! Я знал что кто-то придет и мне поможет!”
Он заговорщически наклоняется вперед.
“А у меня, кстати, есть вариант как отсюда выбраться. Я давным-давно видел как мертвецы улетели отсюда на корабле. Вы не поверите! Корабле из ногтей! Там был дядя Локи. Я ему кричал, он не слышал. Если мы достроим один из таких, я смогу выбраться!”
Вы вспоминаете отвратительную конструкцию. Само ваше божественное нутро кричит, что если такой корабль будет достроен, это будет очень очень плохо.
Вы говорите Бальдру, что поищете способ, но лучше не заигрывать с проклятыми кораблями. Юноша смотрит на вас с сомнением, и пожимает плечами.
“Ну как хотите. Вы давайте подумайте как меня отсюда вытащить, я тоже пойду, поищу способы, посмотрю что можно сделать.”
Не дожидаясь вашего ответа, он машет вам рукой и исчезает в тумане. Вы смотрите на молчаливую синеву. Вам жаль юношу, но словно сам безжалостный Хельхейм шепчет вам - вы еще встретитесь, и ничем хорошим это не кончится.

Вам известен ваш Немезис."
rewards = Array[ExtResource("s_reward")]([SubResource("reward_4")])
metadata/_custom_type_script = ExtResource("s_outcome")

[sub_resource type="Resource" id="choice_6"]
script = ExtResource("s_choice")
