[sub_resource type="Resource" id="form_patrol"]
script = ExtResource("formation_script")
formation_name = "Патруль Хельхейма: Джаггернаут-Банши-Рейдер-Рейдер"
pos1 = ExtResource("enemy_juggernaut")
pos2 = ExtResource("enemy_banshee")
pos3 = ExtResource("enemy_raider")
pos4 = ExtResource("enemy_raider")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="buff_hero_init_minus3"]
script = ExtResource("buff_script")
stat = 6
value = -3
duration = 1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="mod_hero_init_fail"]
script = ExtResource("unit_modifier_script")
buffs = Array[ExtResource("buff_script")]([SubResource("buff_hero_init_minus3")])
metadata/_custom_type_script = ExtResource("unit_modifier_script")

[sub_resource type="Resource" id="battle_ambush_fail"]
script = ExtResource("battle_script")
formation = SubResource("form_patrol")
hero_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("mod_hero_init_fail")])
location_id = "helheim"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_ambush_fail"]
script = ExtResource("outcome_script")
result_text = "Пока вы сидели в засаде, вы не заметили, что враги обнаружили вас. Поэтому для вас стало сюрпризом, когда противники, которых вы подпустили поближе, обрушились на вас."
battle = SubResource("battle_ambush_fail")
metadata/_custom_type_script = "uid://dvpdwqc5nh1vu"

[sub_resource type="Resource" id="check_initiative"]
script = ExtResource("stat_check_script")
stat = 1
metadata/_custom_type_script = "uid://cbv7uofemtg3y"

[sub_resource type="Resource" id="buff_enemy_init_minus3"]
script = ExtResource("buff_script")
stat = 6
value = -3
duration = 1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="mod_enemy_ambush"]
script = ExtResource("unit_modifier_script")
hp_percent = 90
buffs = Array[ExtResource("buff_script")]([SubResource("buff_enemy_init_minus3")])
metadata/_custom_type_script = ExtResource("unit_modifier_script")

[sub_resource type="Resource" id="battle_ambush_success"]
script = ExtResource("battle_script")
formation = SubResource("form_patrol")
enemy_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("mod_enemy_ambush")])
location_id = "helheim"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_ambush_success"]
script = ExtResource("outcome_script")
result_text = "Вы дожидаетесь, пока враги подойдут поближе, и обрушиваетесь со всей мощью. Ошеломленные, они не успевают отреагировать и принимают на себя ваши удары и заклинания."
battle = SubResource("battle_ambush_success")
metadata/_custom_type_script = "uid://dvpdwqc5nh1vu"

[sub_resource type="Resource" id="choice_ambush"]
script = ExtResource("choice_script")
choice_text = "Устроить засаду"
stat_check = SubResource("check_initiative")
success_outcome = SubResource("out_ambush_success")
failure_outcome = SubResource("out_ambush_fail")
metadata/_custom_type_script = "uid://djjvdhvrq6wkh"

[sub_resource type="Resource" id="buff_hero_armor_minus10"]
script = ExtResource("buff_script")
stat = 4
value = -10
duration = 1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="mod_hero_armor_fail"]
script = ExtResource("unit_modifier_script")
buffs = Array[ExtResource("buff_script")]([SubResource("buff_hero_armor_minus10")])
metadata/_custom_type_script = ExtResource("unit_modifier_script")

[sub_resource type="Resource" id="battle_avoid_fail"]
script = ExtResource("battle_script")
formation = SubResource("form_patrol")
hero_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("mod_hero_armor_fail")])
location_id = "helheim"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_avoid_fail"]
script = ExtResource("outcome_script")
result_text = "Вы пытаетесь обойти отряд стороной, но один из патрульных замечает движение. Весь отряд бросается на вас. Вы не успеваете сформировать построение, и уязвимы перед их атаками."
battle = SubResource("battle_avoid_fail")
metadata/_custom_type_script = "uid://dvpdwqc5nh1vu"

[sub_resource type="Resource" id="check_evasion"]
script = ExtResource("stat_check_script")
stat = 3
metadata/_custom_type_script = "uid://cbv7uofemtg3y"

[sub_resource type="Resource" id="out_avoid_success"]
script = ExtResource("outcome_script")
result_text = "Вы меняете маршрут, и крадетесь обходным путем, не выпуская вражеский отряд из поля зрения. Вскоре они удаляются прочь, а вы продолжаете путь."
metadata/_custom_type_script = "uid://dvpdwqc5nh1vu"

[sub_resource type="Resource" id="choice_avoid"]
script = ExtResource("choice_script")
choice_text = "Попытаться избежать врага"
stat_check = SubResource("check_evasion")
success_outcome = SubResource("out_avoid_success")
failure_outcome = SubResource("out_avoid_fail")
metadata/_custom_type_script = "uid://djjvdhvrq6wkh"

[sub_resource type="Resource" id="battle_fair"]
script = ExtResource("battle_script")
formation = SubResource("form_patrol")
location_id = "helheim"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_fair"]
script = ExtResource("outcome_script")
result_text = "Вы выходите и встаете поперек пути патруля. Заметив вас, они поднимают оружие и устремляются вперед. Вы занимаете позицию, готовясь принять честный бой."
battle = SubResource("battle_fair")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_fair"]
script = ExtResource("choice_script")
choice_text = "Выйти к ним и принять честный бой"
outcome = SubResource("out_fair")
metadata/_custom_type_script = "uid://djjvdhvrq6wkh"

[resource]
script = ExtResource("scene_script")
scene_title = "Патруль Хельхейма 1"
body_text = "Пробираясь через туман, скалы и заросли, вы обнаруживаете отряд нежити, бредущий через ущелье. Они вас пока не видят, и это дает преимущество."
choices = Array[ExtResource("choice_script")]([SubResource("choice_ambush"), SubResource("choice_avoid"), SubResource("choice_fair")])
