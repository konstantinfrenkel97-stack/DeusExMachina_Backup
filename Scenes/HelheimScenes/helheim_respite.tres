[gd_resource type="Resource" script_class="MissionSceneResource" format=3 uid="uid://dkd6i2qyj2ohl"]

[ext_resource type="Script" uid="uid://fn4cj3u8rsvt" path="res://Missions/reward.gd" id="3_7d30j"]
[ext_resource type="Script" uid="uid://565su18o8um0" path="res://Missions/buff_entry.gd" id="4_it3hj"]
[ext_resource type="Script" uid="uid://djjvdhvrq6wkh" path="res://Missions/mission_choice.gd" id="choice_script"]
[ext_resource type="Script" uid="uid://dvpdwqc5nh1vu" path="res://Missions/mission_outcome.gd" id="outcome_script"]
[ext_resource type="Script" uid="uid://dgj8xyl3mmptl" path="res://Missions/mission_scene_resource.gd" id="scene_script"]
[ext_resource type="Script" path="res://Missions/Effects/mission_effect.gd" id="mig_fx_base"]
[ext_resource type="Script" path="res://Missions/Effects/hero_hp_delta_effect.gd" id="mig_fx_hp"]
[ext_resource type="Script" path="res://Missions/Effects/hero_majesty_delta_effect.gd" id="mig_fx_maj"]

[sub_resource type="Resource" id="mig_out_heal_1"]
script = ExtResource("mig_fx_hp")
percent_delta = 10
immediate = true
heal_item_bonus = true
metadata/_custom_type_script = ExtResource("mig_fx_hp")

[sub_resource type="Resource" id="out_heal"]
script = ExtResource("outcome_script")
result_text = "Вы используете отведенное время, чтобы подлечить раны, полученные в сражениях до этого. Боль отступает, возвращаются силы. Все боги восстанавливают 10% здоровья."
effects = Array[ExtResource("mig_fx_base")]([SubResource("mig_out_heal_1")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_heal"]
script = ExtResource("choice_script")
choice_text = "Подлатать раны"
outcome = SubResource("out_heal")
metadata/_custom_type_script = "uid://djjvdhvrq6wkh"

[sub_resource type="Resource" id="out_strategy"]
script = ExtResource("outcome_script")
result_text = "Вы используете отведенное время, чтобы обсудить возможные комбинации, хитрости и стратегию. К следующей битве вы подходите более подготовленными. Враги даже не предполагают, что их ждет. Вы получаете 15 очков фантазии."
fantasy_delta = 15
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_strategy"]
script = ExtResource("choice_script")
choice_text = "Продумать стратегию"
outcome = SubResource("out_strategy")
metadata/_custom_type_script = "uid://djjvdhvrq6wkh"

[sub_resource type="Resource" id="mig_out_experience_1"]
script = ExtResource("mig_fx_maj")
delta = 10
immediate = true
metadata/_custom_type_script = ExtResource("mig_fx_maj")

[sub_resource type="Resource" id="out_experience"]
script = ExtResource("outcome_script")
result_text = "Вы используете отведенное время, чтобы перевести дух. Пока боги отдыхают, они рассказывают друг другу о великих сражениях, через которые прошли. Воспоминания и обмен опытом приподняли боевой дух и укрепили связь между богами. Все боги получают 10 величия."
effects = Array[ExtResource("mig_fx_base")]([SubResource("mig_out_experience_1")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_experience"]
script = ExtResource("choice_script")
choice_text = "Поделиться опытом"
outcome = SubResource("out_experience")
metadata/_custom_type_script = "uid://djjvdhvrq6wkh"

[resource]
script = ExtResource("scene_script")
scene_title = "Передышка"
body_text = "Вам попадается кусок свободного пространства.

Поблизости нет врагов, и, похоже, у вас есть редкая возможность перевести дух."
choices = [SubResource("choice_heal"), SubResource("choice_strategy"), SubResource("choice_experience")]
