resource = ExtResource("thoughts")
amount = 250
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="out_meaning"]
script = ExtResource("outcome_script")
result_text = "Один делает вам знак остановиться. И какое-то время наблюдает за дуэлью, бормоча себе под нос.

«Снова и снова… И ничего не меняется, силы равны. Ты не знаешь, был ли слишком упрям… Или недостаточно настойчив… Но тогда…»

Он идёт вперёд и обнажает свой меч. Подходит к той точке, где сталкиваются овны. Когда они оба, разогнавшись, ударяются рогами, в тот же момент Один обрушивает свой меч на место соприкосновения. Вспышка. Все трое разлетаются.

С ловкостью, которой не ожидаешь от его возраста, Один вскакивает и бежит к месту столкновения. Две пары рогов и меч снова сталкиваются. Снова все трое разлетаются.

Ритуал повторяется вновь и вновь. Удар, вспышка, новый удар. И когда вам кажется, что старый бог сошёл с ума, во время одного из ударов не происходит вспышки. Один остаётся стоять с мечом в руке. Оба овна на коленях, их звёздные рога рассыпаются в пыль. Отец богов торжественно убирает меч в ножны.

«Я знал, что прав. Если две силы находятся в идеальном балансе, нужен третий элемент. Не чтобы победить кого-то из двух. Достаточно просто нарушить равновесие.»

Вы не особо понимаете, что произошло, но Один что-то понял, а вы рады, что проблема так или иначе решилась.

В награду вы получаете «Осколок истины овна» (250 мыслей)."
battle = SubResource("battle_plain")
rewards = Array[ExtResource("reward_script")]([SubResource("reward_thoughts")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_meaning"]
script = ExtResource("choice_script")
choice_text = "Найти смысл в происходящем"
required_god = ExtResource("odin")
outcome = SubResource("out_meaning")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Испытание овна"
body_text = "Впереди вспышка. Она повторяется снова и снова, с медленной периодичностью. При приближении оказывается, что это две человеческие фигуры с головами барана. Они разбегаются, бросаются друг на друга и ударяются лбами. Происходит вспышка света, после чего они снова расходятся и снова бросаются друг на друга. Пройти мимо, избежав их, не представляется возможным."
choices = Array[ExtResource("choice_script")]([SubResource("choice_disrupt"), SubResource("choice_slip"), SubResource("choice_meaning")])
metadata/_custom_type_script = ExtResource("scene_script")
