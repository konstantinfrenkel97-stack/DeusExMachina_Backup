[sub_resource type="Resource" id="out_slip_failure"]
script = ExtResource("outcome_script")
result_text = "Вам приходит в голову невероятно рискованная мысль. Но это может сработать. Вы дожидаетесь удара и вспышки, и пока противники расходятся, резко бежите между ними. Овны резко ускоряются и идут на сближение.

Вы оказываетесь между молотом и наковальней. С обеих сторон в вас влетают твёрдые, как камни, рога. Вас вжимает друг в друга. Слышится хруст. Овны расходятся и готовятся броситься, но уже не друг на друга, а на вас."
battle = SubResource("battle_slip_failure")
hero_heal_percent = -15
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_slip"]
script = ExtResource("choice_script")
