[sub_resource type="Resource" id="out_disrupt_success"]
script = ExtResource("outcome_script")
result_text = "Вы решаете воспользоваться их ритуалом, чтобы получить преимущество. Вы ждёте, пока пройдёт ослепление от вспышки и противники снова разбегутся, и бросаетесь на одного из овнов. Вы сбиваете его на бегу, и второй влетает рогами прямо тому в грудь. Жертва отлетает и вскоре встаёт. Не похоже, что он понёс большой урон. Оба овна оборачиваются к вам."
battle = SubResource("battle_disrupt_success")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="out_disrupt_failure"]
script = ExtResource("outcome_script")
result_text = "Вы решаете воспользоваться их ритуалом, чтобы получить преимущество. Вы ждёте, пока пройдёт ослепление от вспышки и противники снова разбегутся, и бросаетесь на одного из овнов. Но когда вы пытаетесь его сбить, оба овна одновременно замирают, мгновенно погасив скорость. Они одновременно оборачиваются и бросаются на вас, словно в отместку за вмешательство в ритуал."
battle = SubResource("battle_disrupt_failure")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_disrupt"]
script = ExtResource("choice_script")
