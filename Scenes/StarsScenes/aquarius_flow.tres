[gd_resource type="Resource" script_class="MissionSceneResource" format=3]

[ext_resource type="Resource" path="res://Enemies/Sky/Stars/Aries/aries.tres" id="ext_1"]
[ext_resource type="Resource" path="res://Enemies/Sky/Stars/Aquarius/aquarius.tres" id="ext_2"]
[ext_resource type="Resource" path="res://Essence/thoughts.tres" id="ext_3"]
[ext_resource type="Resource" path="res://Gods/Odin/Odin.tres" id="ext_4"]
[ext_resource type="Script" path="res://Missions/mission_scene_resource.gd" id="scene_script"]
[ext_resource type="Script" path="res://Missions/mission_choice.gd" id="choice_script"]
[ext_resource type="Script" path="res://Missions/mission_outcome.gd" id="outcome_script"]
[ext_resource type="Script" path="res://Missions/formation_resource.gd" id="formation_script"]
[ext_resource type="Script" path="res://Missions/battle_config.gd" id="battle_script"]
[ext_resource type="Script" path="res://Missions/unit_modifier.gd" id="unit_modifier_script"]
[ext_resource type="Script" path="res://Missions/buff_entry.gd" id="buff_script"]
[ext_resource type="Script" path="res://Missions/stat_check.gd" id="stat_check_script"]
[ext_resource type="Script" path="res://Missions/reward.gd" id="reward_script"]

[sub_resource type="Resource" id="sr_001"]
script = ExtResource("formation_script")
formation_name = "Стражи потока"
pos1 = ExtResource("ext_1")
pos2 = ExtResource("ext_1")
pos3 = ExtResource("ext_2")
pos4 = null
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="sr_002"]
script = ExtResource("formation_script")
formation_name = "Поток водолея"
pos1 = ExtResource("ext_2")
pos2 = ExtResource("ext_2")
pos3 = ExtResource("ext_2")
pos4 = ExtResource("ext_2")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="sr_003"]
script = ExtResource("battle_script")
formation = SubResource("sr_001")
location_id = "stars"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="sr_004"]
script = ExtResource("battle_script")
formation = SubResource("sr_002")
location_id = "stars"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="sr_005"]
script = ExtResource("outcome_script")
result_text = "Трюки звездной сущности — ничто перед мощью богов. Вы ускоряетесь, кто-то переходит на бег. Шаг за шагом, тяжким трудом, вы приближаетесь — и наконец добираетесь до водолея. Он поднимает амфору: вы прошли его испытание, и он принимает вызов."
battle = SubResource("sr_003")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_006"]
script = ExtResource("buff_script")
stat = 0
value = -10
duration = 1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="sr_007"]
script = ExtResource("outcome_script")
result_text = "Водолей приближается все медленнее, потом не приближается вовсе — и наконец его фигура удаляется. Обессиленные, вы падаете на дорогу из света. Тогда водолей сам двигается к вам, и из звездной материи формируются идентичные фигуры. Эффект: бой против четырех водолеев, у богов −10 атаки на 1 ход."
battle = SubResource("sr_004")
hero_buffs = Array[ExtResource("buff_script")]([SubResource("sr_006")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_008"]
script = ExtResource("stat_check_script")
stat = 0
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="sr_009"]
script = ExtResource("choice_script")
choice_text = "Прорваться силой к водолею"
stat_check = SubResource("sr_008")
success_outcome = SubResource("sr_005")
failure_outcome = SubResource("sr_007")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="sr_010"]
script = ExtResource("outcome_script")
result_text = "У дороги из света появляется ответвление — чем дольше вы идете, тем дальше оно растет. Вы отказываетесь участвовать в играх водолея, и он молча провожает вас взглядом. Эффект: вы избегаете боя."
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_011"]
script = ExtResource("buff_script")
stat = 2
value = -15
duration = 1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="sr_012"]
script = ExtResource("outcome_script")
result_text = "Вы таращитесь на звезды, щупаете свет — и не находите ответа. Снова и снова. Кажется, скоро отряд сойдет с ума. В этот момент водолей поднимает амфору и сам идет к вам. Эффект: бой, у богов −15 точности на 1 ход."
battle = SubResource("sr_003")
hero_buffs = Array[ExtResource("buff_script")]([SubResource("sr_011")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_013"]
script = ExtResource("stat_check_script")
stat = 4
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="sr_014"]
script = ExtResource("choice_script")
choice_text = "Поискать обходные пути"
stat_check = SubResource("sr_013")
success_outcome = SubResource("sr_010")
failure_outcome = SubResource("sr_012")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="sr_015"]
script = ExtResource("reward_script")
kind = 3
resource = ExtResource("ext_3")
amount = 250
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="sr_016"]
script = ExtResource("outcome_script")
result_text = "Один опускается на колено и, разведя руками свет, медленно шествует к водолею. Шаг за шагом вы становитесь ближе — и наконец бог встает напротив сущности. «Я прошел твое испытание, дух? Впрочем, я даже не узнаю, в чем оно заключалось. Но мне теперь есть над чем серьезно поразмыслить — за это я благодарен. А вот за что я не благодарен — так это за то, как сильно у меня болит спина!» В награду вы получаете «Осколок истины водолея» (в награду — 250 мыслей). После этого водолей принимает бой."
battle = SubResource("sr_003")
rewards = [SubResource("sr_015")]
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_017"]
script = ExtResource("choice_script")
choice_text = "Найти смысл в происходящем"
required_god = ExtResource("ext_4")
outcome = SubResource("sr_016")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Поток водолея"
body_text = "Впереди по дороге — черная фигура с амфорой, из которой течет поток разноцветного света. Вы идете и идете, но расстояние не уменьшается: световая поверхность под ногами движется назад, пока вы пытаетесь двинуться вперед."
choices = [SubResource("sr_009"), SubResource("sr_014"), SubResource("sr_017")]
