[resource]
script = ExtResource("13_mhyrp")
scene_title = "Сундук с сокровищами (Хельхейм)"
body_text = "Сундук. Он стоит на видном месте. Выглядит так, будто он полон сокровищ, но так ли это?"
choices = Array[ExtResource("11_xjq68")]([SubResource("choice_open"), SubResource("choice_break"), SubResource("choice_take")])
