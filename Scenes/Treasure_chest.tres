[sub_resource type="Resource" id="out_take"]
script = ExtResource("7_e2327")
result_text = "Сильнейший из ваших богов берет сундук с собой, чтобы открыть в безопасной обстановке убежища. К сожалению, даже для бога сундучишко весьма тяжел. Драться с ним будет совсем несподручно. Персонаж с наибольшей атакой получает штраф 1 инициативы до конца миссии."
strongest_hero_buffs = Array[ExtResource("10_80tng")]([SubResource("buff_strongest_init_minus1")])
metadata/_custom_type_script = ExtResource("7_e2327")

