[sub_resource type="Resource" id="out_break_success"]
script = ExtResource("7_e2327")
result_text = "Парой точных ударов вы разламываете сундук на части. Внутри находятся золотые монеты, украшения, драгоценные камни и битый украшенный фарфор. Хотя не вся добыча пережила кинетическое воздействие, вы так или иначе обогатились. Но зачем вам золото в этом мире? ?? ?????????????????????????????????????????? 700 ??????????????????????????."
rewards = Array[ExtResource("8_3f4iy")]([SubResource("reward_thoughts_700")])
metadata/_custom_type_script = ExtResource("7_e2327")

