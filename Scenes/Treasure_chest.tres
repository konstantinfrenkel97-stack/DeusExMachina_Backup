[sub_resource type="Resource" id="out_open_fail"]
script = ExtResource("7_e2327")
result_text = "Замок никак вам не поддается, один за другим боги пробуют, дают друг другу советы и лезут под руку. Когда, наконец, с щелчком открывается замок — вы замечаете, что окружены со всех сторон. ?? ?????????????????????????????????????????? 800 ??????????????????????????."
battle = SubResource("battle_chest_fail")
rewards = Array[ExtResource("8_3f4iy")]([SubResource("reward_thoughts_800")])
metadata/_custom_type_script = ExtResource("7_e2327")

[sub_resource type="Resource" id="check_accuracy"]
