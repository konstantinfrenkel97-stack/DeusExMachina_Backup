[resource]
script = ExtResource("1_msr")
scene_title = "Добро пожаловать в ад"
body_text = "Запах серы, жар неугасающего пламени, молчаливый мрак обсидиановых башен и крики, крики, крики. Последнее пристанище для грешных душ. Место бесконечной пытки, словно высасывающее из вас все хорошее. Вы спустились в ад.\n\nАид идёт впереди молча. Кажется, его не задевает устрашающая обстановка. Его шаг ровный, а взгляд перемещается с одного места на другое, словно изучая обстановку с профессиональным интересом.\n\n\"Так это и есть ад...\"\n\nВы замечаете фигуры в огне, бестелесные чёрные души, рогатые демоны, четвероногие существа. Капли пота, падая на пол, испаряются, шипя, пока вы углубляетесь в объятия преисподней, навстречу тем, кто вас здесь ждет."
choices = [ExtResource("2_choice")]