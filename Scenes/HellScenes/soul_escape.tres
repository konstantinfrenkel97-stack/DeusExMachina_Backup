[resource]
script = ExtResource("scene_script")
scene_title = "Побег душ"
body_text = "Вы проходите мимо устрашающих адских тюрем, из которых слышится болезненный вой. Неожиданно по стене ближайшей тюрьмы идет трещина, она разлетается на куски — и толпа душ цвета сажи летит прямо на вас. Их эфемерные тела разорваны и заново сшиты металлическими нитями, из-под дымчатой кожи золы сияет огонь. Изнутри здания слышатся громкие резкие крики."
choices = Array[ExtResource("choice_script")]([SubResource("sr_013"), SubResource("sr_018"), SubResource("sr_022")])
