resource = ExtResource("ext_3")
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="sr_019"]
script = ExtResource("outcome_script")
result_text = "Аид выходит перед отрядом, непоколебимый перед приливом мертвецов. Из его тени одна за другой вырываются цепи, хватают беглые души и рассеивают их. Демоны-тюремщики завороженно слушают повелителя смерти — и уходят. «Театральщина. Я не люблю прибегать к таким трюкам, но опыт показал, что они крайне эффективны. Пойдем». Эффект: бой пропущен, вы получаете эссенцию власти."
rewards = Array[ExtResource("reward_script")]([SubResource("sr_009")])
metadata/_custom_type_script = ExtResource("outcome_script")

