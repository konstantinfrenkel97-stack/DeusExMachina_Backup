[sub_resource type="Resource" id="sr_016"]
script = ExtResource("outcome_script")
result_text = "Волна душ настигает вас. В голове звенит, один за другим боги падают на землю. Когда вы открываете глаза, вы не знаете, сколько времени прошло, но вам очень плохо, а на вас с яростью смотрят глаза рогатых тюремщиков. Эффект: бой против трех Мучителей, весь отряд теряет 10% здоровья."
battle = SubResource("sr_008")
hero_heal_percent = -10
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_017"]
