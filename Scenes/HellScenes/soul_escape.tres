[sub_resource type="Resource" id="sr_011"]
script = ExtResource("outcome_script")
result_text = "Вы покрепче хватаетесь за оружие и даете отпор наплыву визжащих грешных душ. Однако дымная волна сметает вас. Вы теряете друг друга из виду и кто как может пытается отбиться от волны потерянных душ. Эффект: противники начинают бой с 70% здоровья, герои теряют 2 инициативы на 1 ход."
battle = SubResource("sr_007")
metadata/_custom_type_script = ExtResource("outcome_script")

