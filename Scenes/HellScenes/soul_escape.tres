metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="sr_015"]
script = ExtResource("outcome_script")
result_text = "Волна душ настигает вас, вы замираете и стараетесь не шевелиться. Вас захлестывает дымный поток, но как волна обрушилась, так она и прошла. Один из богов находит в кулаке янтарную «Слезу незабываемой боли» — когда проводишь по ней пальцем, слышен тихий плач. А между тем тюремщики-мучители выбегают из дыры в стене и обращают свою ярость на ваш отряд. Эффект: бой против трех Мучителей, вы получаете 150 мыслей за найденную реликвию."
battle = SubResource("sr_008")
rewards = Array[ExtResource("reward_script")]([SubResource("sr_014")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_018"]
script = ExtResource("choice_script")
choice_text = "Ничего не делать"
stat_check = SubResource("sr_017")
success_outcome = SubResource("sr_015")
failure_outcome = SubResource("sr_016")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="sr_020"]
script = ExtResource("outcome_script")
result_text = "Аид рассеивает души цепями, но демоны-тюремщики скалятся и яростно поднимают оружие. Тот лишь безразлично пожимает плечами: «Стоило попробовать». Эффект: бой против трех Мучителей."
battle = SubResource("sr_008")
metadata/_custom_type_script = ExtResource("outcome_script")

