[sub_resource type="Resource" id="sr_010"]
script = ExtResource("outcome_script")
result_text = "Вы покрепче хватаетесь за оружие и даете отпор наплыву визжащих грешных душ. Их пепельный поток ударяется о стену вашей обороны и не может ее преодолеть. Души воют и извиваются, но не могут добраться до вас. Вы слышите демонический голос из-за стены дымных тел: «Так держать! Удерживайте их еще какое-то время!» Эффект: противники начинают бой с 70% здоровья."
battle = SubResource("sr_004")
metadata/_custom_type_script = ExtResource("outcome_script")

