metadata/_custom_type_script = ExtResource("9_x8f3d")

[resource]
script = ExtResource("11_bbkgh")
scene_title = "Патруль Хельхейма 1"
body_text = "Построение - Джаггернаут - Рейдер - Рейдер

Пробираясь через туман, скалы и заросли, вы обнаруживаете отряд нежити, бредущий через ущелье. Они вас пока не видят, и это дает преимущество."
choices = Array[ExtResource("9_x8f3d")]([SubResource("choice_ambush"), SubResource("choice_avoid"), SubResource("choice_fair")])
