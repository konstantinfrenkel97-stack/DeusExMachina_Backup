[sub_resource type="Resource" id="sr_015"]
script = ExtResource("outcome_script")
result_text = "Вы врываетесь в спор и отправляете дворянина. Шут кланяется — и толкает бога к окну. В последний момент тому удается вцепиться в подоконник, но от испуга бог на первой позиции начинает бой оглушенным на 1 ход. Эффект: бой против одного шута (+30 уклонения)."
battle = SubResource("sr_013")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_016"]
script = ExtResource("stat_check_script")
stat = 3
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="sr_017"]
script = ExtResource("choice_script")
choice_text = "Помешать шуту, что бы он ни задумал"
stat_check = SubResource("sr_016")
success_outcome = SubResource("sr_009")
failure_outcome = SubResource("sr_015")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="sr_019"]
script = ExtResource("outcome_script")
result_text = "Моргана шепчет шуту его имя — того передергивает. Он рассказывает о секте шутов, собирающих секреты, и без споров отдает свою маску. «Ты поплатишься за это, ведьма». Эффект: бой avoided, вы получаете артефакт «Маска шута»."
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_020"]
script = ExtResource("outcome_script")
result_text = "Шут застывает, слушая шепот Морганы — а затем достает из-под одежды два серпа. Глаза загораются голубым огнем. «Ясно, раз уж ты так решил…» Эффект: бой против одного шута (+30 уклонения)."
battle = SubResource("sr_005")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_021"]
script = ExtResource("stat_check_script")
stat = 0
stat_label = "Величие"
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="sr_022"]
script = ExtResource("choice_script")
choice_text = "Приказать шуту остановиться"
required_god = ExtResource("ext_3")
stat_check = SubResource("sr_021")
success_outcome = SubResource("sr_019")
failure_outcome = SubResource("sr_020")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Тайна Шута"
body_text = "За углом богато одетый аристократ орет на шута в ярких одеждах. Шут почтительно кланяется — но вы замечаете, как за спиной он полностью прокручивает ладонь на 360 градусов. Под мешковатой тканью — рукоятки оружия, а в глазницах зловещей маски горит голубой огонек. Это не человек."
choices = [SubResource("sr_008"), SubResource("sr_017"), SubResource("sr_022")]
