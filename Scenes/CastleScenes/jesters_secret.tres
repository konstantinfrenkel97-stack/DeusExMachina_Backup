[sub_resource type="Resource" id="sr_007"]
script = ExtResource("outcome_script")
result_text = "Шут ловко подскакивает и выбрасывает надоедливого дворянина в окно, после чего поворачивается к вам: «Эй, вам понравилась шутка, да?» — «О, но так не пойдет, мы не можем отпустить вас после того, что вы видели». Из дверей и даже из окна заходят такие же шуты с серпами, проворачивая ладони на 360 градусов."
battle = SubResource("sr_006")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_008"]
script = ExtResource("choice_script")
choice_text = "Не вмешиваться"
outcome = SubResource("sr_007")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="sr_009"]
script = ExtResource("outcome_script")
result_text = "Вы врываетесь в спор и отправляете дворянина вместе со служанками. Шут кланяется: «О, вы спасли меня, благороднейшие из господ. А теперь позвольте вас отблагодарить» — и, вскакивая, толкает одного из богов к окну! Бог едва цепляется за подоконник, а арлекин уже держит серпы. Эффект: бой против одного шута (+30 уклонения до конца боя)."
battle = SubResource("sr_005")
metadata/_custom_type_script = ExtResource("outcome_script")

