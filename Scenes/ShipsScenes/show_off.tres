[sub_resource type="Resource" id="battle_2"]
script = ExtResource("s_battle")
formation = SubResource("formation_1")
location_id = "ships"
metadata/_custom_type_script = ExtResource("s_battle")

[sub_resource type="Resource" id="outcome_3"]
script = ExtResource("s_outcome")
result_text = "Вы вынимаете оружие и идете на моряка. Он беззаботно вращает пистолетом.
\"Э... Че такое, а? Че серьезные такие? Это типа шутка, всекли?\"
Вы встаете над ним, на ваших лицах написано что шутки кончились, но его рожа не теряет самодовольства.
\"Я же в школах не учился, всего три шутки знаю. Вот две вы уже увидели.\"
Пистолет замирает у него в руке. Дуло смотрит прямо на вас.
\"А сейчас вылетит третья.\""
hero_majesty_delta = -5
battle = SubResource("battle_2")
metadata/_custom_type_script = ExtResource("s_outcome")

[sub_resource type="Resource" id="choice_4"]
script = ExtResource("s_choice")
choice_text = "Он ответит за оскорбление"
outcome = SubResource("outcome_3")
metadata/_custom_type_script = ExtResource("s_choice")

[sub_resource type="Resource" id="check_5"]
