stat_label = "Удача"
metadata/_custom_type_script = ExtResource("s_check")

[sub_resource type="Resource" id="reward_6"]
script = ExtResource("s_reward")
kind = 1
resource = ExtResource("r_power")
metadata/_custom_type_script = ExtResource("s_reward")

[sub_resource type="Resource" id="outcome_7"]
script = ExtResource("s_outcome")
result_text = "Вы идете к моряку с пистолетом. На его лице самодовольная, провокационная улыбка. Вы делаете вид, что его прикол вас не задел.
\"Ты у нас трюкач? Давай и мы тебе трюк покажем.\"
Столб волшебного света ударяет слева от него, флибустьер прыгает вправо, другой луч бьет вправо. Он вынужден отскочить, третий - в ноги, и пират прыгает. Начинается пляска со световым представлением, куда бы не дернулся выпендрежник, ваша магия заставляет его прыгать в противоположную сторону, и так снова и снова. Его движения походят на рывки куклы, чей мастер напился и трясет рукой держащей нити. Матросня радостно собирается на представление, аплодирует, улюлюкает и смеется. Им все равно над кем смеяться. Ваша же жертва больше не выглядит такой самоуверенной, с его лица на красную рубашку падает пот, он упрямо скалит зубы, смотрит на вас с ненавистью снова и снова прыгая от лучей магии. Но движения становятся все медленнее, наконец, он не разжимая зубов одними губами говорит.
\"Хватит... Сдаюсь...\"
Вы еще немного его мучаете и отпускаете. Он бессильный падает на палубу. Матросы стебутся над ним и выкрикивают похвалу вашим способностям. Вы же, ни на что не реагируя, возвращаетесь на свой ящик и погружаете ложку в суп."
hero_majesty_delta = 5
rewards = Array[ExtResource("s_reward")]([SubResource("reward_6")])
metadata/_custom_type_script = ExtResource("s_outcome")

