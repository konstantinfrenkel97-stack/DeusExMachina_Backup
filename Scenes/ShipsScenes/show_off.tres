[sub_resource type="Resource" id="outcome_11"]
script = ExtResource("s_outcome")
result_text = "Вы идете к моряку с пистолетом. На его лице самодовольная, провокационная улыбка. Вы делаете вид, что его прикол вас не задел.
\"Ты у нас трюкач? Давай и мы тебе трюк покажем.\"
Столб волшебного света ударяет слева от него, флибустьер прыгает вправо, отскакивает от ящика, и толкнув в полете одного из богов оказывается на середине палубы.
\"Эй, эй, это что такое? Никак нападение на члена экипажа? Да еще из-за безобидной шутки? А ну бей их братва!\"
С ревом матросы кидаются на вас. На лице флибустьера победная улыбка. Что-то вам подсказывает, что в эту игру он играет не в первый раз, и не в первый раз выигрывает."
battle = SubResource("battle_10")
metadata/_custom_type_script = ExtResource("s_outcome")

