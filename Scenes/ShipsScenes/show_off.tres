failure_outcome = SubResource("outcome_11")
metadata/_custom_type_script = ExtResource("s_choice")

[sub_resource type="Resource" id="check_13"]
script = ExtResource("s_check")
stat = 2
stat_label = "Броня"
metadata/_custom_type_script = ExtResource("s_check")

[sub_resource type="Resource" id="outcome_14"]
script = ExtResource("s_outcome")
result_text = "Вы зажимаете монетку между зубов, как диск.
\"Ну давай, покажи класс.\"
Флибустьер не меняется в лице. Он лениво, будто его попросили об утомительной услуге, поднимается и встает напротив вашего отряда в расслабленной позе, неторопливо вращая пистолет на пальце.
\"Дурында, а? Видали? Я ж даже если попаду, тебе просто зубы выбьет, и ты ими же и подавишься. Ха-ха-ха-ха! Давай, кончай дебил, нашел дурачка.\"
Бог с монетой недвижим и прямо смотрит в лицо пирата. Тот с таким же расслаблено высокомерным лицом берет пистолет дулом вверх.
\"Ну а уж как промахнусь и пуля в глаз войдет, а? Несчастный случай. И не прикопаешься потом. Все подтвердят что сам напросился.\"
Он направляет пистолет в лицо бога вопросительно выгнув бровь.
\"Я ведь это сделаю.\"
Бог просто смотрит на него. Голосящие матросы умолкают. Как будто даже чайки умолкают. Улыбка сползает с лица стрелка. Брови сходятся на переносице. Он вытягивает руку и сосредоточенно смотрит вдоль ствола.

. . .

БАХ!

Дзынь!

Человеку выбило бы зубы. Но бог устоял. Во рту так и блестит золотистый кружок, а по середине блеклый серый шарик. Лицо флибустьера теряет сосредоточенность и становится спокойно безразличным. Он идет к своему оппоненту, на ходу убирая пистолет за пояс. Они оказываются лицом к лицу. Пират встает сбоку и берет бога за руку. Резко поднимает обе руки вверх.
\"УАААААААААА!!!!\"
\"УААААААААААА!!!\" вторят матросы.
На вас бросаются, обнимают, валят, поливают ромом. Матросы орут. Где-то в отдали на них орет капитан. Такого ликования вам еще не доводилось видеть. У кого-то слезы на глазах. Другие моряки танцуют обнявшись. Из всей этой суматохи вы краем глаза замечаете одинокие плошки с моряцким супом. Так они и стоят на ящике, не дождавшись вас."
hero_majesty_delta = 30
highest_armor_hero_permanent_crit_bonus = 0.02
metadata/_custom_type_script = ExtResource("s_outcome")

[sub_resource type="Resource" id="outcome_15"]
script = ExtResource("s_outcome")
result_text = "Вы зажимаете монетку между зубов, как диск.
\"Ну давай, покажи класс.\"
Флибустьер не меняется в лице. Он лениво, будто его попросили об утомительной услуге, поднимается и встает напротив вашего отряда в расслабленной позе, неторопливо вращая пистолет на пальце.
\"Дурында, а? Видали? Я ж даже если попаду, тебе просто зубы выбьет, и ты ими же и подавишься. Ха-ха-ха-ха! Давай, кончай дебил, нашел дурачка.\"
Бог с монетой недвижим и прямо смотрит в лицо пирата. Тот с таким же расслаблено высокомерным лицом берет пистолет дулом вверх.
\"Ну а уж как промахнусь и пуля в глаз войдет, а? Несчастный случай. И не прикопаешься потом. Все подтвердят что сам напросился.\"
Он направляет пистолет в лицо бога вопросительно выгнув бровь.
\"Я ведь это сделаю.\"
Бог просто смотрит на него. Голосящие матросы умолкают. Как будто даже чайки умолкают. Улыбка сползает с лица стрелка. Брови сходятся на переносице. Он вытягивает руку и сосредоточенно смотрит вдоль ствола.

. . .

БАХ!

Дзынь!

Голову бога откидывает назад и вбок. Кровь брызгает на палубу. Матросы начинают волноваться. Бог подносит руку к лицу, и на ладони у него оказывается золотой диск и свинцовый шарик. Половина лица в крови, щека полностью разодрана. Первым у него оказывается флибустьер в красной рубахе. Он прижимает белую марлю к ране. Бог шипит от боли, она пропитана спиртом.
\"Ну, ну... Давай не хныкай, сам вызвался. Ну даешь.\"
Команда вокруг в растерянности, они явно не понимают как реагировать на происходящее.
\"Ну ладно ладно, это было смело, слышь меня? Смело и круто. Правда шрам останется, но хэй, посмотри на меня. Один другого краше, э?\""
highest_armor_hero_hp_percent_delta = -3
metadata/_custom_type_script = ExtResource("s_outcome")

