[gd_resource type="Resource" script_class="MissionSceneResource" format=3]

[ext_resource type="Resource" path="res://Enemies/Sea/Ships/Sailor/sailor.tres" id="ext_1"]
[ext_resource type="Resource" path="res://Enemies/Sea/Ships/Sailor_with_barrel/sailor_with_barrel.tres" id="ext_2"]
[ext_resource type="Resource" path="res://Essence/thoughts.tres" id="ext_3"]
[ext_resource type="Resource" path="res://Items/Weapons/powder_barrel.tres" id="ext_4"]
[ext_resource type="Script" path="res://Missions/mission_scene_resource.gd" id="scene_script"]
[ext_resource type="Script" path="res://Missions/mission_choice.gd" id="choice_script"]
[ext_resource type="Script" path="res://Missions/mission_outcome.gd" id="outcome_script"]
[ext_resource type="Script" path="res://Missions/formation_resource.gd" id="formation_script"]
[ext_resource type="Script" path="res://Missions/battle_config.gd" id="battle_script"]
[ext_resource type="Script" path="res://Missions/unit_modifier.gd" id="unit_modifier_script"]
[ext_resource type="Script" path="res://Missions/buff_entry.gd" id="buff_script"]
[ext_resource type="Script" path="res://Missions/stat_check.gd" id="stat_check_script"]
[ext_resource type="Script" path="res://Missions/reward.gd" id="reward_script"]

[sub_resource type="Resource" id="sr_001"]
script = ExtResource("formation_script")
formation_name = "Подрывники"
pos1 = ExtResource("ext_1")
pos2 = ExtResource("ext_1")
pos3 = ExtResource("ext_2")
pos4 = ExtResource("ext_2")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="sr_002"]
script = ExtResource("unit_modifier_script")
target_position = 0
hp_percent = 50
metadata/_custom_type_script = ExtResource("unit_modifier_script")

[sub_resource type="Resource" id="sr_003"]
script = ExtResource("battle_script")
formation = SubResource("sr_001")
location_id = "ships"
enemy_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("sr_002")])
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="sr_004"]
script = ExtResource("battle_script")
formation = SubResource("sr_001")
location_id = "ships"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="sr_005"]
script = ExtResource("outcome_script")
result_text = "Вы выкладываете дорожку из пороха и зажигаете ее от огнива — и осознаете, что находитесь именно там, где сейчас произойдет взрыв. Невероятная скорость позволяет отскочить: взрыв задевает лишь краем. Но корабль начинает тонуть, и разъяренная команда уже бежит к вам. Эффект: бой, у богов −20% здоровья."
battle = SubResource("sr_004")
hero_heal_percent = -20
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_006"]
script = ExtResource("battle_script")
formation = SubResource("sr_001")
location_id = "ships"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="sr_007"]
script = ExtResource("outcome_script")
result_text = "Взрывная волна отшвыривает и опаляет вас, ударяя о борт судна. Вас, едва живых, заносит водой в пролом палубы — а матросы уже готовы преподать урок за саботаж. Эффект: бой, у богов −60% здоровья."
battle = SubResource("sr_006")
hero_heal_percent = -60
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_008"]
script = ExtResource("stat_check_script")
stat = 3
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="sr_009"]
script = ExtResource("choice_script")
choice_text = "Сделать, как они просят"
stat_check = SubResource("sr_008")
success_outcome = SubResource("sr_005")
failure_outcome = SubResource("sr_007")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="sr_010"]
script = ExtResource("outcome_script")
result_text = "Вы берете длинный фитиль, грузитесь на лодку и ведете ее к скалам — за ними скрывается пиратское судно. Зажигаете фитиль, толкаете лодку и укрываетесь. Оглушительный взрыв! «Идиоты! Я велел подорвать тот корабль, а не наш!» Эффект: бой, у противников −50% здоровья."
battle = SubResource("sr_003")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_011"]
script = ExtResource("choice_script")
choice_text = "Отогнать лодку и взорвать корабль подрывников"
outcome = SubResource("sr_010")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="sr_012"]
script = ExtResource("battle_script")
formation = SubResource("sr_001")
location_id = "ships"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="sr_013"]
script = ExtResource("reward_script")
kind = 0
resource = ExtResource("ext_4")
amount = 1
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="sr_014"]
script = ExtResource("outcome_script")
result_text = "Вы аккуратно поднимаете бочки на борт — и не успеваете перевести дух, как на вас набрасывается экипаж: «Чужаки! Саботажники! Хотят нас подорвать!» В море ничего не бывает просто — но у вас теперь есть порох. Эффект: бой, вы получаете артефакт «Бочка пороха»."
battle = SubResource("sr_012")
rewards = [SubResource("sr_013")]
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_015"]
script = ExtResource("battle_script")
formation = SubResource("sr_001")
location_id = "ships"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="sr_016"]
script = ExtResource("outcome_script")
result_text = "Из-за недостатка опыта вы раз за разом роняете бочки в воду — они становятся скользкими и поднять их еще тяжелее. «Эй, тут чужаки какой-то порох грузят! Вали их, ребята!» Эффект: обычный бой."
battle = SubResource("sr_015")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_017"]
script = ExtResource("stat_check_script")
stat = 4
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="sr_018"]
script = ExtResource("choice_script")
choice_text = "Оставить порох себе"
stat_check = SubResource("sr_017")
success_outcome = SubResource("sr_014")
failure_outcome = SubResource("sr_016")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Лодка с порохом"
body_text = "Из-за борта слышен крик. На лодке, привязанные, стоят несколько бочек, а два моряка машут вам:\n\n«Эй, на корабле! Помогите! Нас отправили подорвать этот корабль, но по пути мы потеряли длинный фитиль! Мы нырнем и поплывем обратно, а вы подорвите бочки. Огниво оставим. Договорились?»\n\n«Договорились!» — и они прыгают в воду. Вам осталась лодка с бочками пороха."
choices = [SubResource("sr_009"), SubResource("sr_011"), SubResource("sr_018")]
