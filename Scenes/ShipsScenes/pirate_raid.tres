[sub_resource type="Resource" id="buff_1"]
script = ExtResource("s_buff")
stat = 2
value = 5
duration = -1
metadata/_custom_type_script = ExtResource("s_buff")

[sub_resource type="Resource" id="outcome_2"]
script = ExtResource("s_outcome")
result_text = "Пираты довольно болтливы, особенно когда ничем не заняты. Вы разбредаетесь, чтобы расспросить и собрать информацию о Черной Бороде.

Оказывается, про него известно довольно много. Флагманский корабль называется \"Месть королевы Анны\", а всего его флот включает от пятнадцати до пятидесяти кораблей. Все они ходят под черными парусами и отвозят добычу в его логово - остров Cabeza Negra. Он считается королем пиратов, и никто не смеет покушаться на его добычу.

Вы узнаете имена отдельных кораблей, капитанов, и даже матросов. Моряки удивительно проинформированы. Некоторые даже знают где его флотилия закупает припасы. Но одна деталь кажется вам особенно важной.

Сам корабль \"Месть королевы Анны\" уже давно не видели в открытых водах. Вам есть над чем задуматься, ведь перед вами противник с которым рано или поздно придется столкнуться.

Вам известен ваш Немезис."
nemesis_buff_all_heroes = true
nemesis_buff_stat = SubResource("buff_1")
nemesis_buff_location_id = "ships"
metadata/_custom_type_script = ExtResource("s_outcome")

[sub_resource type="Resource" id="choice_3"]
script = ExtResource("s_choice")
choice_text = "Узнать побольше"
outcome = SubResource("outcome_2")
metadata/_custom_type_script = ExtResource("s_choice")

[sub_resource type="Resource" id="check_4"]
script = ExtResource("s_check")
