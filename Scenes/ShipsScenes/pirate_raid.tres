stat_check = SubResource("check_4")
success_outcome = SubResource("outcome_7")
failure_outcome = SubResource("outcome_8")
metadata/_custom_type_script = ExtResource("s_choice")

[sub_resource type="Resource" id="check_10"]
script = ExtResource("s_check")
stat = 5
stat_label = "Удача"
metadata/_custom_type_script = ExtResource("s_check")

[sub_resource type="Resource" id="outcome_11"]
script = ExtResource("s_outcome")
result_text = "\"Хм, команда старого Титча, да?\"
Хитрая улыбка расползается по лицу Самди, как у шкодника задумавшего пакость.
\"Почему бы вам не отправить ему маленький подарочек, в честь нашего будущего знакомства.\"
Он играючи вертит трость в руке, после чего поворачивает ее горизонтально полу, отпускает. Трость остается висеть в воздухе, как жердочка для птицы, барон садится сверху, берется руками и начинает раскачиваться взад вперед, словно мечтательный ребенок. Вы и присутствующие матросы с удивлением наблюдаете за происходящим. Он продолжает качаться. Внезапно он начинает двигаться. Мерно качаясь плыть в сторону кормы. Нет. Вы догадываетесь, что он как раз стоит на месте, это корабль возобновил движение. Матросы мгновенно начали делать ставки врежется ли он в дальнюю стену. Слава богу, что палуба достаточно длинная. Всей гурьбой вы следуете за ним, всматриваясь в лицо. Его глаза закрыты. До стены десять метров, пять, два.

Внезапно его туловище выгибается назад, рисуя настолько глубокую арку, что его позвоночник должен был сломаться. Изо рта вылетает черный ворон, словно созданный из самой тьмы и улетает в светлое оконце. Барон спрыгивает со своего насеста, и забирает трость. Театрально поворачивается, при этом край его одежды задевает стенку корабля. Пираты мгновенно начинают спорить о том, считается ли это. А барон движется к вам.

\"Ну чтож, посылка отправлена. Будет ли доставлена? Не знаю, известно одним лишь богам. Ах да, это же мы!\"
Он заливается смехом и идет мимо вас танцующей походкой. Вы первые наносите удар Черной Бороде. И вы уверены, этот удар далеко не последний.

Вам известен ваш Немезис."
nemesis_voodoo_curse_random = true
nemesis_buff_location_id = "ships"
metadata/_custom_type_script = ExtResource("s_outcome")

