pos2 = ExtResource("r_sailor")
pos3 = ExtResource("r_barrel")
metadata/_custom_type_script = ExtResource("s_formation")

[sub_resource type="Resource" id="battle_6"]
script = ExtResource("s_battle")
formation = SubResource("formation_5")
location_id = "ships"
metadata/_custom_type_script = ExtResource("s_battle")

[sub_resource type="Resource" id="outcome_7"]
script = ExtResource("s_outcome")
result_text = "Черная борода кажется опасным противником, и любая возможность его ослабить стоит того чтобы попытаться.

Вы начинаете подбивать пиратов на нападение. Играете на жадности, гордости, берете на слабо. Но они крайне упорны. Страх перед Королем пиратов глубоко засел в головах, пока наконец вам не приходит верное слово:
\"Черная борода не узнает что это вы, если убить всю команду.\"
Людское море зашевелилось. Переглядки, переговоры, блеск. Вы видите как в их душах поднимают голову змеи. Атаковать. Убить всех. Никто не узнает. Забрать добычу. Безнаказанно. Безнаказанно!

\"Поднять паруса!\"

Вы идете полным ходом к торговому судну. Одновременно с вами к нему подходит и корабль с черными парусами. Моряки на нем выглядят растерянными и не готовыми к бою. Размякли от безопасности не иначе.
\"Эй! Это судно принадлежит Черной Бороде! Вы что задумали? Убирайтесь!\"
В ответ, на их палубу летят абордажные крючья.

Вам известен ваш Немезис."
thoughts_delta = 600
battle = SubResource("battle_6")
nemesis_others_hp_percent = 5
nemesis_buff_location_id = "ships"
metadata/_custom_type_script = ExtResource("s_outcome")

[sub_resource type="Resource" id="outcome_8"]
script = ExtResource("s_outcome")
result_text = "Вы начинаете подбивать пиратов на нападение. Играете на жадности, гордости, берете на слабо. Но они крайне упорны. Страх перед Королем пиратов глубоко засел в головах, пока наконец вам не приходит верное слово:
\"Черная борода не узнает что это вы, если убить всю команду.\"
Людское море зашевелилось. Переглядки, переговоры, блеск. Вы видите как в их душах поднимают голову змеи. Атаковать. Убить всех. Никто не узнает. Забрать добычу. Безнаказанно.
\"Совсем сдурели, псы!\"
Рев капитана разносится по палубе.
\"Никому еще не удавалось уйти безнаказанным от Короля Пиратов. Когда он узнает что в той же области где пропал его корабль сбывают добычу и залечивают раны, он не поймет что это мы сделали.\"
Азарт выветривается из глаз матросов. Они словно трезвеют на глазах, и оборачиваются к вам.

Вы гребете на маленькой шлюпке. Вас отправили в море, пусть хоть шлюпку предоставили. Вряд ли вы пропадете, здесь часто ходят корабли. Хотя за проезд, скорее всего, придется заплатить.

Но Черная Борода... Насколько же крепка его хватка на душах пиратов.

Вы не сомневаетесь, что в один момент придется с ним сразиться. И вы сделаете все, чтобы следующий раз закончился по другому.

Вам известен ваш Немезис."
thoughts_delta = -400
metadata/_custom_type_script = ExtResource("s_outcome")

