[resource]
script = ExtResource("1_msr")
scene_title = "Добро пожаловать на корабли"
body_text = "Крики чаек, скрип снастей и матросские песенки. Палуба качается под вами, и с непривычки тяжело удержать равновесие. Самди же, словно всю жизнь провел на корабле. Легкой танцующей походкой, он идет по корабельным доскам, стуча тростью.\n\n\"Йо-хо-хо, господа. Мы на кораблях. О, поверьте, это совершенно уникальный мир. Жизнь, которой не попробуешь на земле. Эти повадки, эти традиции, эта подавленная, но такая бурная свобода.\"\n\nЕго ноздри расширяются, когда он вдыхает соленый воздух здешних мест. Вы неуверенно следуете за ним, перешагивая через канаты, как вдруг обращаете внимание на корабельную команду. Они смотрят на вас недобро, и некоторые уже схватились за ножи. Вы оборачиваетесь к Самди, а он уже нашел где-то бутылку с надписью \"Ром\" и без стеснения опустошает ее в горло. Матросы смотрят на это зрелище с почерневшими от ненависти глазами."
choices = [ExtResource("2_choice")]