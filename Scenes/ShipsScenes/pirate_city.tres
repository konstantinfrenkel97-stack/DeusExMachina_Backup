[resource]
script = ExtResource("scene_script")
scene_title = "Пиратский город"
body_text = "Корабль, на котором вы шли, петляя между рифами, зашёл в бухту. Вашим удивлённым глазам открывается скрытое среди скал поселение. Дома из каркасов кораблей. Пирсы, суда, чёрные флаги. Вы прибыли на пиратский остров. Матросы радостно сходят на пирс — у вас тоже есть возможность осмотреться."
choices = [SubResource("choice_drink"), SubResource("choice_talk"), SubResource("choice_brothel")]
