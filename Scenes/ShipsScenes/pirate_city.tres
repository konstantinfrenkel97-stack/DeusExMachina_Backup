[sub_resource type="Resource" id="out_drink_success"]
script = ExtResource("outcome_script")
result_text = "Что же делать на пиратском острове, как не пить. Найти подходящее заведение оказывается несложно. Сложнее найти здание, где бы не наливали. Вы знакомитесь с местными сортами. На вкус отвратительно, но в голову даёт. Вы быстро напиваетесь.

Ваш отряд, то в унисон, то в какофонию, начинает петь, танцевать и показывать волшебные трюки. Вы идёте от таверны к таверне, неся веселье и волшебство. Даже алкоголь становится лучше. То ли вам наливают из бутылок «для своих», то ли вы попросту привыкли. Куда бы вы ни шли, вы приносите праздник и движение. За вами уже ходит целая толпа. Ваша попойка приобретает масштабы маленького фестиваля.

Пираты орут, танцуют, дерутся, запускают фейерверки, а в центре всего этого — вы.

Утром вы возвращаетесь на корабль. Матросня озорно вам подмигивает, а вы стараетесь улыбаться через треск в голове. Капитан встречает вас словами:

«Такого праздничка в этой дыре давно не было. Поздравляю, чудаки, вы стали местными легендами.»"
rewards = [SubResource("reward_essence_chaos")]
hero_buffs = Array[ExtResource("buff_script")]([SubResource("buff_luck_plus20"), SubResource("buff_accuracy_minus20")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="out_drink_fail"]
script = ExtResource("outcome_script")
result_text = "Что же делать на пиратском острове, как не пить. Найти подходящее заведение оказывается несложно. Сложнее найти здание, где бы не наливали. Вы знакомитесь с местными сортами. На вкус отвратительно, но в голову даёт. Вы быстро напиваетесь.

Ваш отряд, то в унисон, то в какофонию, начинает петь, танцевать и показывать волшебные трюки. Вы идёте от таверны к таверне, неся веселье и волшебство.

А потом просыпаетесь от того, что морские волны омывают ноги. Вы на пляже. В голове гудит, и вы без понятия, как сюда попали. Найдя путь на пристань, вы обнаруживаете, что ваш корабль ушёл без вас. В пиратской бухте несложно найти замену. Но этот вечер вам не сильно хочется повторять."
hero_buffs = Array[ExtResource("buff_script")]([SubResource("buff_luck_plus20"), SubResource("buff_accuracy_minus20")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_drink"]
script = ExtResource("choice_script")
choice_text = "Пойти напиться"
stat_check = SubResource("check_luck")
success_outcome = SubResource("out_drink_success")
failure_outcome = SubResource("out_drink_fail")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="check_evasion"]
script = ExtResource("stat_check_script")
stat = 3
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="out_talk_success"]
script = ExtResource("outcome_script")
result_text = "Самое интересное в любом месте — это люди. Вы решаете походить по улицам и заведениям, пообщаться с местными.

И вы отлично проводите время. Лавочники с удовольствием делятся историями. Каждая побрякушка на прилавке сопровождается историями. Вы находите местную школу, здание совета. Вам попадаются приветливые жители, и вы многое узнаёте об этой маленькой общине. Ваши тела постепенно украшаются разными безделушками — подарками от тех, кто хотел показать своё доброе отношение. Под вечер вы забрели отдохнуть в небольшой парк. Смеркается, и на ваших глазах собираются люди, пожилые пираты и пиратки. Приносят музыкальные инструменты, и начинаются пляски. Причём пираты танцуют не абы как — настоящие сложные па. Вскоре вас замечают и тоже втягивают в танцы.

Когда на следующий день вы покидаете это место, в сердце у вас живёт тоска и ностальгия."
thoughts_delta = 300
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="out_talk_fail"]
script = ExtResource("outcome_script")
result_text = "Самое интересное в любом месте — это люди. Вы решаете походить по улицам и заведениям, пообщаться с местными.

И вы отвратительно проводите время. Вам попадаются пьяные орущие матросы, шарлатаны и просто грубияны. Вам плюют на обувь, толкают. Еда в заведениях отвратительная, а на выходе вы замечаете, что вас успели обворовать, после чего начинается драка с толпой пьяной матросни.

Возвращаясь на корабль, вы обещаете себе больше ни шагу не ступать на землю пиратских городов."
hero_hp_percent_delta = -3
thoughts_delta = -200
metadata/_custom_type_script = ExtResource("outcome_script")

