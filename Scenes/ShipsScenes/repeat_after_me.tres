[sub_resource type="Resource" id="mod_v2_pos3"]
script = ExtResource("unit_modifier_script")
target_position = 3
buffs = Array[ExtResource("buff_script")]([SubResource("buff_attack_minus5_pos3")])
metadata/_custom_type_script = ExtResource("unit_modifier_script")

[sub_resource type="Resource" id="battle_v2"]
script = ExtResource("battle_script")
formation = SubResource("form_parrot")
enemy_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("mod_v2_pos1"), SubResource("mod_v2_pos2"), SubResource("mod_v2_pos3")])
location_id = "ships"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_v2"]
script = ExtResource("outcome_script")
result_text = "Вы повторяете фразу, пока попугай не начал повторять за вами. После чего зеленое чудо вспорхнуло и полетело над головами моряков, крича: «Ром! Ром! Ром от капитана!» Матросы побросали работу и рванули к капитанской каюте. Оттуда вышла женщина в широкополой шляпе и какое-то время пыталась через гвалт разобраться, что от нее хотят. «Ром? Какой ром?! Нет никакого рома, а ну быстро за работу!» — прокричала она, заглушая толпу. Повисла тишина. «Нет рома?» — один из матросов поднял на нее широкие и грустные глаза. «Нет рома!» — рявкнула капитан. Медленно матросы потащились обратно, словно печальная тень накрыла палубу. Тогда-то вас и заметили. Эффект: бой, у матросов и матроса с бочкой −5 атаки на 1 ход."
battle = SubResource("battle_v2")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_v2"]
script = ExtResource("choice_script")
choice_text = "Ром! Ром! Ром от капитана!"
outcome = SubResource("out_v2")
metadata/_custom_type_script = ExtResource("choice_script")

