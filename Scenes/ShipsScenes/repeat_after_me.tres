[gd_resource type="Resource" script_class="MissionSceneResource" format=3]

[ext_resource type="Resource" path="res://Enemies/Sea/Ships/Sailor/sailor.tres" id="ext_1"]
[ext_resource type="Resource" path="res://Enemies/Sea/Ships/Sailor_with_barrel/sailor_with_barrel.tres" id="ext_2"]
[ext_resource type="Resource" path="res://Enemies/Sea/Ships/Captain/captain.tres" id="ext_3"]
[ext_resource type="Script" path="res://Missions/mission_scene_resource.gd" id="scene_script"]
[ext_resource type="Script" path="res://Missions/mission_choice.gd" id="choice_script"]
[ext_resource type="Script" path="res://Missions/mission_outcome.gd" id="outcome_script"]
[ext_resource type="Script" path="res://Missions/formation_resource.gd" id="formation_script"]
[ext_resource type="Script" path="res://Missions/battle_config.gd" id="battle_script"]
[ext_resource type="Script" path="res://Missions/unit_modifier.gd" id="unit_modifier_script"]
[ext_resource type="Script" path="res://Missions/buff_entry.gd" id="buff_script"]

[sub_resource type="Resource" id="form_parrot"]
script = ExtResource("formation_script")
formation_name = "Матрос-Матрос-Матрос с бочкой-Капитан"
pos1 = ExtResource("ext_1")
pos2 = ExtResource("ext_1")
pos3 = ExtResource("ext_2")
pos4 = ExtResource("ext_3")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="buff_init_minus2_pos1"]
script = ExtResource("buff_script")
stat = 6
value = -2
duration = 1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="buff_init_minus2_pos2"]
script = ExtResource("buff_script")
stat = 6
value = -2
duration = 1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="buff_init_minus2_pos3"]
script = ExtResource("buff_script")
stat = 6
value = -2
duration = 1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="mod_v1_pos1"]
script = ExtResource("unit_modifier_script")
target_position = 1
buffs = Array[ExtResource("buff_script")]([SubResource("buff_init_minus2_pos1")])
metadata/_custom_type_script = ExtResource("unit_modifier_script")

[sub_resource type="Resource" id="mod_v1_pos2"]
script = ExtResource("unit_modifier_script")
target_position = 2
buffs = Array[ExtResource("buff_script")]([SubResource("buff_init_minus2_pos2")])
metadata/_custom_type_script = ExtResource("unit_modifier_script")

[sub_resource type="Resource" id="mod_v1_pos3"]
script = ExtResource("unit_modifier_script")
target_position = 3
buffs = Array[ExtResource("buff_script")]([SubResource("buff_init_minus2_pos3")])
metadata/_custom_type_script = ExtResource("unit_modifier_script")

[sub_resource type="Resource" id="battle_v1"]
script = ExtResource("battle_script")
formation = SubResource("form_parrot")
enemy_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("mod_v1_pos1"), SubResource("mod_v1_pos2"), SubResource("mod_v1_pos3")])
location_id = "ships"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_v1"]
script = ExtResource("outcome_script")
result_text = "Вы повторяете фразу, пока попугай не начал повторять за вами. После чего зеленое чудо вспорхнуло и полетело над головами моряков, крича: «Течь! Течь! В трюме течь!» На палубе началась суматоха. Часть моряков бросились на нижнюю палубу, другие пытались набиться в шлюпки. Из каюты в ярости выскочила капитан, в одной руке крюк, в другой пистолет. «Тупорылые крысы, совсем мозги пропили?! Это же просто попугай! Третий раз за месяц!» Она выстрелила в воздух. Паника начала затихать, и в этот момент она замечает вас. «Вы! Совсем там оборзели! Чему вы моего попугая учите!» Эффект: бой, у матросов и матроса с бочкой −2 инициативы на 1 ход."
battle = SubResource("battle_v1")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_v1"]
script = ExtResource("choice_script")
choice_text = "Течь! Течь! В трюме течь!"
outcome = SubResource("out_v1")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="buff_attack_minus5_pos1"]
script = ExtResource("buff_script")
stat = 0
value = -5
duration = 1
