target_position = 3
hp_percent = 95
metadata/_custom_type_script = ExtResource("unit_modifier_script")

[sub_resource type="Resource" id="battle_v3"]
script = ExtResource("battle_script")
formation = SubResource("form_parrot")
enemy_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("mod_v3_pos1"), SubResource("mod_v3_pos2"), SubResource("mod_v3_pos3")])
location_id = "ships"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_v3"]
script = ExtResource("outcome_script")
result_text = "Вы повторяете фразу, пока попугай не начал повторять за вами. После чего зеленое чудо вспорхнуло и полетело над головами моряков, крича: «Слышь, урод! Слышь, урод!» Один из моряков обернулся к другому. «Это ты мне сейчас сказал?» «Совсем тупой, что ли? Нет. А даже если и да, ты и есть урод!» «Слышь! Да мне в драке нос сломали. Да я и так покрасивее тебя буду!» «Че?!» На палубе то тут, то там разгорались огни драки, пока это не переросло в массовую потасовку. Шум прорезал выстрел из пистолета в воздух. Посередине палубы стояла капитан. Попугай приземлился ей на плечо. «Ополоумели? Свиньи!» Драка прекратилась, капитан красными глазами оглядывала палубу и пересеклась с вами глазами. «Хотите кому-то врезать? Так врежьте вон тем крысам!» Эффект: бой, матросы и матрос с бочкой теряют 5% здоровья."
battle = SubResource("battle_v3")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_v3"]
script = ExtResource("choice_script")
choice_text = "Слышь, урод! Слышь, урод!"
outcome = SubResource("out_v3")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Повторяй за мной"
body_text = "На корабле кипит работа, и вас пока не замечают. Вы видите зеленого попугая, порхающего между матросов. Он замечает вас и садится на бочку, разглядывая вас умными глазами. Похоже, эта порода умеет имитировать человеческую речь."
choices = [SubResource("choice_v1"), SubResource("choice_v2"), SubResource("choice_v3")]
