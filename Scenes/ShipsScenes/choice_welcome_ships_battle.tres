[gd_resource type="Resource" script_class="MissionChoice" load_steps=3 format=3]

[ext_resource type="Script" path="res://Missions/mission_choice.gd" id="1_mc"]
[ext_resource type="Resource" path="res://Scenes/ShipsScenes/formation_ships_sailors_barrel.tres" id="2_form"]
[ext_resource type="Script" path="res://Missions/mission_outcome.gd" id="3_outcome"]
[ext_resource type="Script" path="res://Missions/battle_config.gd" id="4_battle"]
[ext_resource type="Script" path="res://Missions/reward.gd" id="5_reward"]
[ext_resource type="Resource" path="res://Essence/essence_chaos.tres" id="6_essence"]

[sub_resource type="Resource" id="battle_welcome_ships"]
script = ExtResource("4_battle")
formation = ExtResource("2_form")
location_id = "ships"
metadata/_custom_type_script = ExtResource("4_battle")

[sub_resource type="Resource" id="reward_essence"]
script = ExtResource("5_reward")
kind = 1
resource = ExtResource("6_essence")
amount = 1
metadata/_custom_type_script = ExtResource("5_reward")

[sub_resource type="Resource" id="out_welcome_ships"]
script = ExtResource("3_outcome")
result_text = "Начинается бой."
battle = SubResource("battle_welcome_ships")
rewards = Array[ExtResource("5_reward")]([SubResource("reward_essence")])
metadata/_custom_type_script = ExtResource("3_outcome")

[resource]
script = ExtResource("1_mc")
choice_text = "Добро пожаловать на корабли."
outcome = SubResource("out_welcome_ships")