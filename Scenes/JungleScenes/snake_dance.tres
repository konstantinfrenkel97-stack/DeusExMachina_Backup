[sub_resource type="Resource" id="out_v3_fail"]
script = ExtResource("outcome_script")
result_text = "Шива разгоняется и совершает огромный прыжок, отделившись от группы. Он несколько раз отталкивается от воздуха как от земли, оставив на месте толчков маленькие облачка. В результате полета, он оказывается в центре арены, окруженный нагами.
Те резко поворачиваются к нему. Он проводит ногой по вырезанному кругу. Они поднимают оружие. Он дважды ударяет себя ладонями по груди «Тум тум.»
Наги на мгновение останавливаются в замешательстве, но сразу бросаются на бога. Он ловит ваш взгляд и жестами призывает поспешить на помощь. А чем бы ни был план, он привел только к тому, что бог оказался в окружении."
battle = SubResource("battle_v3_fail")
target_god = ExtResource("god_shiva")
target_buffs = Array[ExtResource("buff_script")]([SubResource("buff_shiva_evasion_minus15_1turn")])
metadata/_custom_type_script = ExtResource("outcome_script")

