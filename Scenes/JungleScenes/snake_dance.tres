[sub_resource type="Resource" id="battle_v1_success"]
script = ExtResource("battle_script")
formation = SubResource("form_nagas4")
enemy_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("mod_all_luck10")])
hero_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("mod_all_luck10")])
location_id = "jungle"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_v1_success"]
script = ExtResource("outcome_script")
result_text = "Сложно описать словами, что заставило вас принять такое решение. Какое-то наитие толкнуло не пытаться бежать и не занять позицию, а рвануть туда, где происходил боевой танец.
Вы оказываетесь в окружении наг. Они несколько огорошены вашей дерзостью. Вы снова слышите барабан. Круг из зеленых хвостов начинает двигаться в синхронном ритме.
Но и вы плывете на звуке барабана. Наги бросаются в атаку, но вы отбиваетесь. Потому что чувствуете ритм. Барабан превращает противников в один боевой организм, но вы тоже стали едины.
Вы слились с нагами в едином танце боя."
battle = SubResource("battle_v1_success")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="battle_v1_fail"]
script = ExtResource("battle_script")
formation = SubResource("form_nagas4")
enemy_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("mod_all_luck10")])
location_id = "jungle"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_v1_fail"]
script = ExtResource("outcome_script")
result_text = "Сложно описать словами, что заставило вас принять такое решение. Какое-то наитие толкнуло не пытаться бежать и не занять позицию, а рвануть туда, где происходил боевой танец.
Вы оказываетесь в окружении наг. Они несколько огорошены вашей дерзостью. Вы снова слышите барабан. Круг из зеленых хвостов начинает двигаться в синхронном ритме.
Отбиваться от них совсем не просто. Они движутся в каком-то ритме, который вам никак не удаётся поймать. Стоит одному оседлать звук барабана, как он сбивается из-за рассинхрона с союзниками. Эта битва будет непростой."
battle = SubResource("battle_v1_fail")
metadata/_custom_type_script = ExtResource("outcome_script")

