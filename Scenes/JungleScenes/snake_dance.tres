[sub_resource type="Resource" id="out_v2_fail"]
script = ExtResource("outcome_script")
result_text = "Вы бросаетесь в чащу лиан. За спиной шипение и шелест множества хвостов. Кажется целая орда змей преследует вас.
Как можете, вы петляете между корнями и лианами, пока не находите какую-то пещеру в земле и не забиваетесь туда, готовые держать оборону.
Первой заползает нага, чье лицо вымазано в маскировочной грязи. Видимо, одна из наблюдательниц, кто вас и заметил. Она издает свист и заползает еще несколько наг, одетых более церемониально. Вам не удалось избежать боя."
battle = SubResource("battle_v2_fail")
metadata/_custom_type_script = ExtResource("outcome_script")

