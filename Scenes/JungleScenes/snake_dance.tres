[sub_resource type="Resource" id="out_v3_success"]
script = ExtResource("outcome_script")
result_text = "Шива разгоняется и совершает огромный прыжок, отделившись от группы. Он несколько раз отталкивается от воздуха как от земли, оставив на месте толчков маленькие облачка. В результате полета, он оказывается в центре арены, окруженный нагами.
Те резко поворачиваются к нему. Он проводит ногой по вырезанному кругу. Они поднимают оружие. Он дважды ударяет себя ладонями по груди «Тум тум.» Наги взмахивают «Тум тум тум». Они бьют «Тум тум тум тум тум». Удары не достигают цели, вонзаясь в камень у ног божества. Женщины ошарашенно переглядываются. Словно что-то захватило контроль над их телами. «Тум ту-ту ту-тум» — к ударам по груди присоединяются удары по двойному барабану, который Шива носит с собой.
«Тум тум тум» удары наг со свистом разрезают воздух. В них все меньше враждебности, все больше ритма. Хвосты извиваются в танце. Вы с замиранием сердца видите, как все плато превратилось в единый организм, движущийся в ритме в унисон. Даже вас захватывает музыка.
Наконец, ритм становится тише, движения медленнее. Наги постепенно останавливаются. Шива и сам торжественно замирает, руки на барабане, в полном окружении.
Вооруженные женщины сгибают хвосты и склоняются в почтительном поклоне. Бог кланяется в ответ. Смущенно отмахиваясь и широко улыбаясь, он возвращается к вам. Весь ваш отряд через что-то прошел."
rewards = Array[ExtResource("reward_script")]([SubResource("reward_chaos_essence")])
target_god = ExtResource("god_shiva")
target_buffs = Array[ExtResource("buff_script")]([SubResource("buff_shiva_luck10_mission")])
target_buffs_until_mission_end = true
metadata/_custom_type_script = ExtResource("outcome_script")

