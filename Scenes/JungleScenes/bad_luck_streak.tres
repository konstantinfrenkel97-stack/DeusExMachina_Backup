[gd_resource type="Resource" script_class="MissionSceneResource" format=3]

[ext_resource type="Script" uid="uid://dgj8xyl3mmptl" path="res://Missions/mission_scene_resource.gd" id="scene_script"]
[ext_resource type="Script" uid="uid://djjvdhvrq6wkh" path="res://Missions/mission_choice.gd" id="choice_script"]
[ext_resource type="Script" uid="uid://dvpdwqc5nh1vu" path="res://Missions/mission_outcome.gd" id="outcome_script"]
[ext_resource type="Script" uid="uid://cbv7uofemtg3y" path="res://Missions/stat_check.gd" id="stat_check_script"]
[ext_resource type="Script" uid="uid://565su18o8um0" path="res://Missions/buff_entry.gd" id="buff_script"]
[ext_resource type="Script" path="res://Missions/formation_resource.gd" id="formation_script"]
[ext_resource type="Script" path="res://Missions/battle_config.gd" id="battle_script"]
[ext_resource type="Resource" path="res://Gods/Shiva/Shiva.tres" id="shiva"]
[ext_resource type="Resource" path="res://Enemies/Forest/Jungle/Rakshasa/rakshasa.tres" id="rakshasa"]
[ext_resource type="Resource" path="res://Enemies/Forest/Jungle/Saru/Saru.tres" id="saru"]

[sub_resource type="Resource" id="form_base"]
script = ExtResource("formation_script")
formation_name = "Ракшас — Ракшас — Сару — Сару"
pos1 = ExtResource("rakshasa")
pos2 = ExtResource("rakshasa")
pos3 = ExtResource("saru")
pos4 = ExtResource("saru")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="battle_base"]
script = ExtResource("battle_script")
formation = SubResource("form_base")
location_id = "jungle"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="check_evasion"]
script = ExtResource("stat_check_script")
stat = 3
stat_label = "Уклонение"
difficulty = 50
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="out_patience_success"]
script = ExtResource("outcome_script")
result_text = "Вы не дети малые, чтобы расстраиваться из-за череды неудач. Сегодня вам не везет, значит повезет завтра. Боги вы или кто?

Вы продолжаете путь. Неудачи словно становятся все более жестокими. Вам попадаются ловушки охотников, вы не замечаете и наступаете на спящего крокодила, а один раз вас чуть не затаптывает стадо слонов.

Но вы лишь смиренно переводите дыхание, не давая дурной удаче сломить вас и продолжаете путь, пока внезапно не обнаруживаете что все кончилось. Фрукты стали съедобными, кусты относительно безопасными. И пусть джунгли и остаются опасным местом, у вас больше нет чувства что вас пытаются уничтожить."
hero_hp_flat_delta = -5
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="out_patience_failure"]
script = ExtResource("outcome_script")
result_text = "Вы не дети малые, чтобы расстраиваться из-за череды неудач. Сегодня вам не везет, значит повезет завтра. Боги вы или кто?

Вы продолжаете путь. Неудачи словно становятся все более жестокими. Вам попадаются ловушки охотников, вы не замечаете и наступаете на спящего крокодила, а один раз вас чуть не затаптывает стадо слонов.

Наконец вы в раздражении вскидываете руки и разражаетесь яростной тирадой. Вы проклинаете чертовы джунгли, небо, землю, судьбу и всю вселенную, за то что вам приходится переживать в этот день, вы требуете от мира чтобы он вышел и сразился честно, раз так хочет чтобы вы страдали. И мир отвечает на вашу просьбу.

Кусты раздвигаются, и плавной кошачьей походкой из него выходят двое. Одетые в черные одежды, в руках волнистые кинжалы. Тигриные головы издевательски скалят зубы.
«Да, так их всех! Этот дурацкий мир не заслуживает и капли восхваления. Ишь ты, настроили храмов. И кому? Помпезным божкам, которые делают вид что их творение не просто вонючий кусок грязи! А-ха-ха-ха-ха! А что? Стоило вам немного отведать его на вкус и все? Ненависть.»
Они останавливаются, угрожающе наклонившись к вам.
«Открывать людям глаза на уродство мира - самое сладкое наслаждение.»
Вы беретесь за оружие. У ваших уколов порезов и ссадин впервые в жизни появилось лицо, и сейчас оно ответит за все."
battle = SubResource("battle_base")
hero_hp_percent_delta = -5
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_patience"]
script = ExtResource("choice_script")
choice_text = "Запастись терпением"
stat_check = SubResource("check_evasion")
success_outcome = SubResource("out_patience_success")
failure_outcome = SubResource("out_patience_failure")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="check_accuracy"]
script = ExtResource("stat_check_script")
stat = 4
stat_label = "Точность"
difficulty = 50
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="buff_enemy_evasion_down"]
script = ExtResource("buff_script")
stat = 3
value = -10
duration = 1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="out_find_enemy_success"]
script = ExtResource("outcome_script")
result_text = "Вы не для того провели всю жизнь сражаясь с мистическими тварями, чтобы просто решить что вам не везет. Кто-то хочет сыграть с вами в игру, но вы не намерены подыгрывать.

Делая вид что отдыхаете, вы незаметно плетете чары, а также просто глазами вглядываетесь в окружающую зелень. Вскоре вы обнаруживаете две пары зеленых глаз. В ином контексте вы бы решили, что это жители джунглей наблюдают за вами, но сейчас не сомневаетесь - это враг, и враг опасный.

Делая вид, что продолжаете путь, вы резко срываетесь с места и летите прямо на врага. Те не успевают отреагировать. Со всей яростью накопленной за день вы обрушиваетесь на пару человекоподобных фигур с головами тигра. Те шипят и пытаются отбиваться волнистыми кинжалами."
battle = SubResource("battle_base")
enemy_buffs = Array[ExtResource("buff_script")]([SubResource("buff_enemy_evasion_down")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="out_find_enemy_failure"]
script = ExtResource("outcome_script")
result_text = "Вы не для того провели всю жизнь сражаясь с мистическими тварями, чтобы просто решить что вам не везет. Кто-то хочет сыграть с вами в игру, но вы не намерены подыгрывать.

Но не удивительно, что вы не смогли обнаружить противника до этого. Кто бы не был вашим врагом, скрывать свое присутствие они точно умели. Ничего не остается. Вы встаете в круг и громко кричите, что знаете о чарах и никуда не пойдете, пока ваш невидимый оппонент не примет честный бой.

Видимо поняв, что больше играть с вами не получится, из кустов выходят два человека с головами тигра. Они играют волнистыми кинжалами и нагло скалят на вас зубы.
«Эй-эй, вам не стоит так заводиться.»
«Да-да, вы же просто играем. Понимаете? Это игра такая.»
«Но вам не стоило нарушать правила.»
«Вы не должны знать что мы здесь.»
«Иначе игры не получится.»
«И тогда нам придется действовать серьезно.»
Мгновенно перейдя с мягкой походки на резкий прыжок, они бросаются на вас, выставив вперед оружие."
battle = SubResource("battle_base")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_find_enemy"]
script = ExtResource("choice_script")
choice_text = "Мы под чьими-то чарами. Нужно найти врага"
stat_check = SubResource("check_accuracy")
success_outcome = SubResource("out_find_enemy_success")
failure_outcome = SubResource("out_find_enemy_failure")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="buff_shiva_evasion"]
script = ExtResource("buff_script")
stat = 3
value = 7
duration = -1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="buff_shiva_luck"]
script = ExtResource("buff_script")
stat = 5
value = 7
duration = -1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="out_harmony"]
script = ExtResource("outcome_script")
result_text = "Шива успокаивает других богов.
«Дайте я кое-что попробую. Если я правильно понимаю, должно помочь.»
Он садится в позу лотоса, закрывает глаза и расправляет четыре руки, каждая ладонь в причудливом жесте. Вы смотрите на него. На его лице спокойствие. Постепенно синий бог начинает подниматься над землей. Он воспаряет, не меняя позы. Вы слышите какой-то звук. Как мягкое дребезжание. Как музыку. Тихий и бесконечный «Оммм».

Голубоватый свет исходит от Шивы. Он заполняет пространство вокруг, и в этом свету, все становится ясно и правильно. Ни боли ни радости, только абсолютное существование. Единство. Гармония.
И вы замечаете черные тени в воздухе. Они извиваются, словно их жжёт музыка Шивы. Отступают под натиском света, все дальше и дальше, пока не исчезают в кустах. Оттуда раздается шипение. Не змеиное, а враждебный крик озлобленной кошки. Из темноты вылетает нож. Лезвие, сверкнув на солнце летит в спокойного бога, но замирает в сантиметре от его переносицы, словно зажатое воздухом. Шива открывает глаза.
«Больше вам не спрятаться, я знаю вас. Я вижу вас. Выходите демоны, и примите свою судьбу.»
Он расправляет ноги и встает на землю. При этом, остается на том же уровне. Высота на которой парил бог была идеальной. Из кустов на четвереньках выскакивают две фигуры в черном, с головами тигра. В руках у них острые, кривые кинжалы."
battle = SubResource("battle_base")
target_god = ExtResource("shiva")
target_current_hp_percent_delta = 7
target_buffs = Array[ExtResource("buff_script")]([SubResource("buff_shiva_evasion"), SubResource("buff_shiva_luck")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_harmony"]
script = ExtResource("choice_script")
choice_text = "Войти в гармонию со вселенной"
required_god = ExtResource("shiva")
outcome = SubResource("out_harmony")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Полоса неудач"
body_text = "Зацепившись за корень дерева, один из богов падает лицом вниз. К счастью там куда он летит - мягкая трава. К несчастью трава скрывала гнездо земляных ос. В шумном жужжании крыльев вам словно слышится кашляющий смех.

Отбившись от разъяренного роя, вы возобновляете путь. Словно вознаграждение за неудачу, вам попадается банановое дерево. Протянувшись к спелым желтым плодам, вы едва успеваете одернуть руку, когда на вас с шипением бросается змея, скрытая среди плодов. Вам удается отпугнуть животное, но из травы она поворачивает к вам голову, и вам видится ухмылка на ее чешуйчатой морде.

Утомленные и раздраженные вы натыкаетесь на руины какого-то здания. Садитесь на камень отдохнуть, когда он трещит и ломается под вашим весом, роняя на жесткий пол. Вам кажется, что словно весь мир издевается над вами."
choices = Array[ExtResource("choice_script")]([SubResource("choice_patience"), SubResource("choice_find_enemy"), SubResource("choice_harmony")])
metadata/_custom_type_script = ExtResource("scene_script")
