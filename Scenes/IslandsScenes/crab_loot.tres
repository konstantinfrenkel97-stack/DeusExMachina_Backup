[gd_resource type="Resource" script_class="MissionSceneResource" format=3]

[ext_resource type="Resource" path="res://Enemies/Sea/Islands/Crab_collector/crab_collector.tres" id="ext_1"]
[ext_resource type="Resource" path="res://Essence/thoughts.tres" id="ext_2"]
[ext_resource type="Script" path="res://Missions/mission_scene_resource.gd" id="scene_script"]
[ext_resource type="Script" path="res://Missions/mission_choice.gd" id="choice_script"]
[ext_resource type="Script" path="res://Missions/mission_outcome.gd" id="outcome_script"]
[ext_resource type="Script" path="res://Missions/formation_resource.gd" id="formation_script"]
[ext_resource type="Script" path="res://Missions/battle_config.gd" id="battle_script"]
[ext_resource type="Script" path="res://Missions/unit_modifier.gd" id="unit_modifier_script"]
[ext_resource type="Script" path="res://Missions/buff_entry.gd" id="buff_script"]
[ext_resource type="Script" path="res://Missions/stat_check.gd" id="stat_check_script"]
[ext_resource type="Script" path="res://Missions/reward.gd" id="reward_script"]

[sub_resource type="Resource" id="sr_001"]
script = ExtResource("formation_script")
formation_name = "Золотые крабы"
pos1 = ExtResource("ext_1")
pos2 = ExtResource("ext_1")
pos3 = ExtResource("ext_1")
pos4 = ExtResource("ext_1")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="sr_002"]
script = ExtResource("buff_script")
stat = 6
value = -2
duration = 1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="sr_003"]
script = ExtResource("unit_modifier_script")
target_position = 0
hp_percent = 0
buffs = Array[ExtResource("buff_script")]([SubResource("sr_002")])
metadata/_custom_type_script = ExtResource("unit_modifier_script")

[sub_resource type="Resource" id="sr_004"]
script = ExtResource("battle_script")
formation = SubResource("sr_001")
location_id = "island"
enemy_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("sr_003")])
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="sr_005"]
script = ExtResource("reward_script")
kind = 3
resource = ExtResource("ext_2")
amount = 50
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="sr_006"]
script = ExtResource("outcome_script")
result_text = "Вы терпеливо ждете, пока цепочка хитинных спин не исчезнет. Увы — крабы вынесли все, включая ручки дверей. Лишь пара тайников, куда они не смогли добраться, дает скудную добычу. Эффект: вы избегаете боя и получаете 50 мыслей."
rewards = [SubResource("sr_005")]
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_007"]
script = ExtResource("choice_script")
choice_text = "Забрать то, что останется после крабов"
outcome = SubResource("sr_006")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="sr_008"]
script = ExtResource("reward_script")
kind = 3
resource = ExtResource("ext_2")
amount = 700
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="sr_009"]
script = ExtResource("outcome_script")
result_text = "Вы проскальзываете на судно мимо крабов и, вспоров пару тайников, забираете все ценное, что они не успели унести. Эффект: вы избегаете боя и получаете 700 мыслей."
rewards = [SubResource("sr_008")]
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_010"]
script = ExtResource("battle_script")
formation = SubResource("sr_001")
location_id = "island"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="sr_011"]
script = ExtResource("reward_script")
kind = 3
resource = ExtResource("ext_2")
amount = 700
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="sr_012"]
script = ExtResource("outcome_script")
result_text = "Крабы замечают грабителей первыми: по песку и воде к вам разворачивается целая армада золотых спин! Эффект: начинается бой, но добыча с судна — 700 мыслей — уже у вас."
battle = SubResource("sr_010")
rewards = [SubResource("sr_011")]
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_013"]
script = ExtResource("stat_check_script")
stat = 3
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="sr_014"]
script = ExtResource("choice_script")
choice_text = "Попытаться обобрать судно, избегая крабов"
stat_check = SubResource("sr_013")
success_outcome = SubResource("sr_009")
failure_outcome = SubResource("sr_012")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="sr_015"]
script = ExtResource("reward_script")
kind = 3
resource = ExtResource("ext_2")
amount = 300
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="sr_016"]
script = ExtResource("outcome_script")
result_text = "Вы решаете не оставлять за спиной золотую орду. Заметив ваше приближение, крабы бросают добычу и выстраиваются в боевой порядок. Эффект: у противников −2 инициативы на 1 ход, вы получаете 300 мыслей с судна."
battle = SubResource("sr_004")
rewards = [SubResource("sr_015")]
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="sr_017"]
script = ExtResource("choice_script")
choice_text = "Сначала разобраться с крабами"
outcome = SubResource("sr_016")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Добыча крабов"
body_text = "Перелезая с песка на скалы, вы замечаете судно, разбившееся и севшее на мель у песчаной косы. На нем ни одного человека — зато по песку и воде быстро перебирают лапами две цепочки крабов, сжимая в клешнях всякую всячину. Их спины сияют от золотых монет. Если хотите поживиться добычей с корабля, решение нужно принимать быстро."
choices = [SubResource("sr_007"), SubResource("sr_014"), SubResource("sr_017")]
