[sub_resource type="Resource" id="outcome_threaten"]
script = ExtResource("s_outcome")
result_text = "«Понятно, понятно. Подвиньтесь немного». Сусаноо садится на плот рядом с девицей и жестом просит вас спустить плот на воду. Вы выполняете просьбу и смотрите, как двое на плоту уплывают в голубое море.
Когда плот отдаляется от берега, Сусаноо встает на колени, обнажает меч и погружает его в море по рукоятку. Девушка со страхом наблюдает за ним.
«Яматано Орочи, ты помнишь это оружие? Кусанаги-но цуруги. Ты должен помнить».
Вода под плотом начинает бурлить.
«Да, именно он отделял твои головы. Одну за одной. Все восемь. Помнишь, как это было? Так вот, слушай меня. И слушай мой меч».
«Больше эти люди не принесут тебе ни одной жертвы, ни одной невинной души. И ты не станешь мстить, потому что их защищаю я — Сусаноо, бог меча».
«Мы встретимся с тобой и сведем старые счеты. Но ты оставишь в покое простых людей».
Море не ответило. Бурление утихло. Вокруг них была только морская гладь. На лице девушки смешались в одно страх, восхищение, непонимание и еще пара эмоций. Лицо Сусаноо не выражает ни одной. Он берет двумя руками рукоятку катаны, погруженной в воду, и делает резкий рывок. Поднимается волна и относит плот обратно к песчаному пляжу. Боги уже ждут их.
«Возвращайся домой и расскажи, что увидела. Если я узнаю, что жертвоприношения продолжились, — приду и убью старейшину. Поняла?»
Девушка истово закивала. Кажется, на сегодня она перегружена впечатлениями.
«Ладно, ступай. Для вас все закончилось».
Подобрав края платья, она быстро рванула вверх по течению. Вы провожаете девушку взглядом.
«А для нас все только начинается».

Вам известен ваш Немезис."
nemesis_buff_god = ExtResource("r_susanoo")
nemesis_buff_stat = SubResource("buff_susanoo_luck")
nemesis_buff_location_id = "island"
metadata/_custom_type_script = ExtResource("s_outcome")

[sub_resource type="Resource" id="choice_threaten"]
script = ExtResource("s_choice")
choice_text = "Угрожать чудовищу"
required_god = ExtResource("r_susanoo")
outcome = SubResource("outcome_threaten")
metadata/_custom_type_script = ExtResource("s_choice")

[resource]
script = ExtResource("s_scene")
scene_title = "Повелитель змей"
body_text = "Вы отдыхаете на берегу бурлящей реки. Ее воды впадают в открытое море, а источник где-то выше по острову, на горе. Вы пьете прохладную воду и наслаждаетесь ласковым солнцем. Внезапно вам на глаза попадается плот, а на нем человек — девушка. Она лежит на плоту, сложив руки на груди, в простом белом платье, украшенная цветами. Поток уносит ее в море. Вы бросаетесь наперерез и перехватываете плот. Когда вы начинаете оттаскивать судно к берегу, девушка начинает кричать и отбиваться. Когда же она оказывается на суше, то заливается рыданиями и сквозь слезы говорит, что ее принесли в жертву великому водному змею. И если вы ее не отпустите, на деревню падет проклятие. Нужно позволить демону ее сожрать, иначе всю ее семью ждет гибель. Вы смотрите на девушку. Ей нет и двадцати лет. Все лицо красное и мокрое, узкие плечи дрожат. Она старается выглядеть смелой, но вы видите, как сильно она напугана."
choices = Array[ExtResource("s_choice")]([SubResource("choice_let_go"), SubResource("choice_return"), SubResource("choice_threaten")])
metadata/_custom_type_script = ExtResource("s_scene")
