[sub_resource type="Resource" id="form_full"]
script = ExtResource("formation_script")
formation_name = "Каппа: три воина и шаман"
pos1 = ExtResource("ext_warrior")
pos2 = ExtResource("ext_warrior")
pos3 = ExtResource("ext_warrior")
pos4 = ExtResource("ext_shaman")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="form_minus_one"]
script = ExtResource("formation_script")
formation_name = "Каппа: два воина и шаман"
pos1 = ExtResource("ext_warrior")
pos2 = ExtResource("ext_warrior")
pos4 = ExtResource("ext_shaman")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="check_evasion"]
script = ExtResource("stat_check_script")
stat = 3
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="battle_v1_success"]
script = ExtResource("battle_script")
formation = SubResource("form_full")
location_id = "island"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_v1_success"]
script = ExtResource("outcome_script")
result_text = "Вы собираетесь в путь, готовые перехватить каппа, прежде чем те доберутся до деревни. Когда вы уже готовы отправляться, к вам подходят крестьяне и передают большую чарку риса.
«Это всё, что мы можем предложить. Пожалуйста, возьмите...»
Вы с благодарностью принимаете дар и отправляетесь туда, где, как указали крестьяне, находится логово черепахолюдов.
Вы идёте по песку, после чего углубляетесь в лес. Отточенные опытом боевые инстинкты — то, что уберегло вас от фиолетового дождя из яда. С деревьев и из кустов каппа плюют в вас тёмно-зелёными сгустками, но вы находите укрытие за большим деревом. Видя, что их уловка не сработала, каппа бросаются в ближний бой."
battle = SubResource("battle_v1_success")
thoughts_delta = 200
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="buff_ancient_poison"]
script = ExtResource("buff_script")
stat = 9
value = 15
duration = -1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="mod_heroes_poison"]
script = ExtResource("unit_modifier_script")
target_position = 0
buffs = Array[ExtResource("buff_script")]([SubResource("buff_ancient_poison")])
metadata/_custom_type_script = ExtResource("unit_modifier_script")

[sub_resource type="Resource" id="battle_v1_fail"]
script = ExtResource("battle_script")
formation = SubResource("form_full")
hero_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("mod_heroes_poison")])
location_id = "island"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_v1_fail"]
script = ExtResource("outcome_script")
result_text = "Вы собираетесь в путь, готовые перехватить каппа, прежде чем те доберутся до деревни. Когда вы уже готовы отправляться, к вам подходят крестьяне и передают большую чарку риса.
«Это всё, что мы можем предложить. Пожалуйста, возьмите...»
Вы с благодарностью принимаете дар и отправляетесь туда, где, как указали крестьяне, находится логово черепахолюдов.
Вы идёте по песку, после чего углубляетесь в лес.
Вдруг на вас обрушивается зелёный ливень. С деревьев, из кустов, кажется даже с самого неба каппа заплёвывают вас своим ядом. Вы встаёте в боевое построение, когда черепахолюды окружают вас и держат на расстоянии копья, видимо ожидая, пока яд, которым вы покрыты с головы до ног, сделает своё дело.
Не имея другого выхода, вы бросаетесь в атаку."
battle = SubResource("battle_v1_fail")
thoughts_delta = 200
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_v1"]
script = ExtResource("choice_script")
choice_text = "Мы займёмся каппами"
stat_check = SubResource("check_evasion")
success_outcome = SubResource("out_v1_success")
failure_outcome = SubResource("out_v1_fail")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="check_luck"]
script = ExtResource("stat_check_script")
stat = 5
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="reward_essence_power"]
script = ExtResource("reward_script")
kind = 1
resource = ExtResource("ext_essence_power")
amount = 1
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="out_v2_success"]
script = ExtResource("outcome_script")
result_text = "Вы решаете попробовать решить проблему мирным путём. Хотя крестьяне и относятся скептически, вы убеждаете их, что нужно хотя бы попробовать, и, взяв с собой старосту, отправляетесь туда, где по вашей информации находится логово черепахолюдов.
Войдя в лес, вы поднимаете белую тряпку на палке, обозначая, что пришли вести переговоры. Вскоре ваш отряд подходит к пещере, украшенной черепашьими панцирями. Перед входом на широком пне сидит каппа, куда крупнее всех, кого вам доводилось видеть. На его широкие плечи накинут потёртый шёлковый плащ. Его окружает отряд воинов с копьями. Все они молча и неприветливо смотрят на вас.
Вы приветствуете племя и объясняете, что крестьяне попросили вас о помощи, но вы хотите попробовать договориться.
Главарь отвечает, что каппа — высший народ, избранный морем, и они имеют право на все его дары.
Вы акцентируете внимание на том, что если рыбаки умрут голодной смертью, некому будет обеспечивать каппа едой. Этот аргумент, кажется, подействовал.
Следующие два часа вы проводите в напряжённых переговорах, по итогам которых формируется своего рода соглашение. Каппа обязуются охранять деревню от посягательств других племён, а также помогать в охоте и рыбалке. Люди же будут отдавать часть добычи, но не такую, чтобы поставить собственное выживание под угрозу. В случае нарушения договора боги обязуются покарать нарушителя.
Это хрупкий договор, вы видите много способов, как его можно эксплуатировать. Но в этот раз вам удалось решить проблему без кровопролития, а это уже чего-то стоит."
rewards = Array[ExtResource("reward_script")]([SubResource("reward_essence_power")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="buff_kappa_dmg10"]
script = ExtResource("buff_script")
stat = 0
value = 10
duration = -1
metadata/_custom_type_script = ExtResource("buff_script")

