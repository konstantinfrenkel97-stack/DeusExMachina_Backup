[sub_resource type="Resource" id="battle_v3_success"]
script = ExtResource("battle_script")
formation = SubResource("form_minus_one")
location_id = "island"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_v3_success"]
script = ExtResource("outcome_script")
result_text = "«Для начала мне нужна палка и белая холстина. А потом я научу вас быть воинами.»
Удивлённые крестьяне приносят полотно, и бог меча уединяется в одной из хижин, предварительно раздав указания собрать всех в центре деревни.
Когда растерянные крестьяне собрались, из хижины выходит Сусаноо. Из белой холстины он сделал некое подобие знамени. Тушью (откуда он её только взял) нарисованы четыре звезды и незнакомый вам иероглиф. Он пристраивает знамя к домику старейшины и выходит к людям.
«Ну что, братцы. Времени у нас мало, а работы много. Нужно вырезать бамбуковые копья, вырыть укрепления и обучить вас минимальной тактике.»
Его рука ложится на рукоять меча.
«И пусть всё не закончится, как в прошлый раз.»
Каппа атаковали яростно. Крестьяне кололи бамбуковыми копьями через наспех сооружённые укрепления. Боги переходили от одного укрепления к другому, помогая сдержать напор. Казалось, что деревня побеждает, пока в одном месте бамбуковый забор не разлетелся на куски, и в пролом не хлынули черепахолюды. Впереди несётся огромный каппа в шёлковом плаще — видимо, вожак. Ему навстречу выходит бог меча. И дальше всё произошло словно по сценарию. Бойцы с обеих сторон сформировали круг. Сусаноо и главарь каппа — посередине. Один держит катану, другой сжимает копьё. Время словно остановилось. Только одинокий лист, танцуя на ветру, медленно кружится и нежно касается земли. В этот момент оба противника срываются с места. Звон клинка. Голова каппа отлетает, окрашивая песок алой кровью. Каппа застыли в смятении, а рыбаки торжествующе затрясли бамбуковыми копьями. После чего два строя бросились друг на друга."
battle = SubResource("battle_v3_success")
target_god = ExtResource("ext_susanoo")
target_majesty_delta = 30
metadata/_custom_type_script = ExtResource("outcome_script")

