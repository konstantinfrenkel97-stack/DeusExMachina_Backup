[resource]
script = ExtResource("scene_script")
scene_title = "Рыбаки в беде"
body_text = "На одном из островов к вам подбегает бедно одетый человек с удочкой.
«О герои, прошу, помогите моей деревне! Жестокое племя каппа изводит нас и отбирает припасы.»
Рыбак отводит вас в деревню. Там вам вводят в курс дела: поселение живёт выращиванием риса и рыболовством, но в последнее время банда черепахолюдов повадилась собирать с них дань, и теперь крестьянам едва хватает еды. Опасаясь голодной смерти, они решили дать бой каппам, когда один из рыбаков встретил вас и попросил о помощи.
Пока вам описывают проблему, со стороны деревни раздаются крики. Вы спешите туда и видите, как какого-то мужчину несут под руки. Его лицо бледное, а по губам стекает кровь. Вы слышите шёпот среди рыбаков:
«Черепахи... Отравили...»
Мужчина поднимает голову и хрипло произносит:
«Они... Узнали о восстании... Готовят силы... Нам нужно бежать...»
Глаза деревенских жителей со страхом и надеждой оборачиваются на вас."
choices = [SubResource("choice_v1"), SubResource("choice_v2"), SubResource("choice_v3")]
