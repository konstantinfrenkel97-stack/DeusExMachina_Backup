[sub_resource type="Resource" id="out_flatter_failure"]
script = ExtResource("outcome_script")
result_text = "Вы начинаете нахваливать пугающие творения. Медуза продолжает угрожающе двигаться к вам, грациозно ставя одну ногу перед другой.
«О, вам правда так нравится? М?»
Она подходит и немного наклоняет голову, пытаясь заглянуть вам в лицо. Она стоит совсем близко.
«Почему бы вам не посмотреть мне в глаза? Тогда вы сможете стать частью этого сада, который вам так нравится.»
Вы не видите ее глаз, но видите, как рот растянулся в улыбке, обнажившей острые клыки."
battle = SubResource("battle_v2_failure")
metadata/_custom_type_script = ExtResource("outcome_script")

