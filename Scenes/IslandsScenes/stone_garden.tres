[sub_resource type="Resource" id="out_topple_success"]
script = ExtResource("outcome_script")
result_text = "Ситуация опасная, но вам приходит идея как застать медузу врасплох. Пока трое подходят к медузе, один бросается и толкает статую. Падая, та задевает другую статую, а та следующую создавая эффект домино. С грохотом пугающий сад камней начинает рушиться.
«Неееееееет! Что вы наделалиииии?!»
Визг медузы разносится над морем, и в этот момент вы на нее бросаетесь."
battle = SubResource("battle_v1_success")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="out_topple_failure"]
script = ExtResource("outcome_script")
result_text = "Ситуация опасная, но вам приходит идея как застать медузу врасплох. Пока трое подходят к медузе, один бросается и толкает статую. Та падает в песок, подняв облачка пыли. Весь отряд и медуза в растерянности смотрят на совершенный вандализм.
«Ах ты ублюдок» - злобно зашипела медуза.
Вы успешно уронили статую."
battle = SubResource("battle_base")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_topple"]
script = ExtResource("choice_script")
choice_text = "Толкнуть статую, чтобы отвлечь ее"
stat_check = SubResource("check_luck")
success_outcome = SubResource("out_topple_success")
failure_outcome = SubResource("out_topple_failure")
metadata/_custom_type_script = ExtResource("choice_script")

