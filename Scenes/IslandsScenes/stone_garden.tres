[sub_resource type="Resource" id="out_reflect_failure"]
script = ExtResource("outcome_script")
result_text = "Вперед выходит Сусаноо.
«Я слышал о твоих невероятных умениях, медуза.»
Та замедляет шаг, но продолжает грациозно приближаться.
«Неужели?»
«Да» - голос Сусаноо звучит расслабленно. – «Я и сам считаюсь непревзойденным мастером в своей области.»
«О, и что же за область?» - она начала угрожающе шипеть.
«Искусство меча. Хочешь проверить, что быстрее? Мой меч или твой взгляд?» - вы видите как Сусаноо улыбается, опустив голову.
«Высокомерный глупец…»
Сусаноо поднимает голову, медуза резко поворачивает лицо прямо к нему, чтобы заглянуть в глаза…
И бог превращается в камень. Кажется даже медуза не ожидала такого исхода. Отойдя от первого шока, вы бросаетесь в атаку. Похоже меч не смог опередить взгляд."
battle = SubResource("battle_base")
target_god = ExtResource("susanoo")
target_buffs = Array[ExtResource("buff_script")]([SubResource("buff_susanoo_stun")])
metadata/_custom_type_script = ExtResource("outcome_script")

