[gd_resource type="Resource" script_class="MissionSceneResource" format=3]

[ext_resource type="Script" uid="uid://dgj8xyl3mmptl" path="res://Missions/mission_scene_resource.gd" id="scene_script"]
[ext_resource type="Script" uid="uid://djjvdhvrq6wkh" path="res://Missions/mission_choice.gd" id="choice_script"]
[ext_resource type="Script" uid="uid://dvpdwqc5nh1vu" path="res://Missions/mission_outcome.gd" id="outcome_script"]
[ext_resource type="Script" uid="uid://cbv7uofemtg3y" path="res://Missions/stat_check.gd" id="stat_check_script"]
[ext_resource type="Script" uid="uid://565su18o8um0" path="res://Missions/buff_entry.gd" id="buff_script"]
[ext_resource type="Resource" path="res://Gods/Chernobog/Chernobog.tres" id="chernobog"]
[ext_resource type="Script" path="res://Missions/Effects/mission_effect.gd" id="mig_fx_base"]
[ext_resource type="Script" path="res://Missions/Effects/hero_buff_effect.gd" id="mig_fx_buff"]
[ext_resource type="Script" path="res://Missions/Effects/hero_hp_delta_effect.gd" id="mig_fx_hp"]
[ext_resource type="Script" path="res://Missions/Effects/hero_majesty_delta_effect.gd" id="mig_fx_maj"]

[sub_resource type="Resource" id="mig_out_rest_1"]
script = ExtResource("mig_fx_hp")
percent_delta = 7
immediate = true
heal_item_bonus = true
metadata/_custom_type_script = ExtResource("mig_fx_hp")

[sub_resource type="Resource" id="mig_out_rest_2"]
script = ExtResource("mig_fx_maj")
delta = 5
immediate = true
metadata/_custom_type_script = ExtResource("mig_fx_maj")

[sub_resource type="Resource" id="out_rest"]
script = ExtResource("outcome_script")
result_text = "Красивое зрелище, но у вас нет сил присоединиться. Лучше уж наблюдать издалека и использовать время для восстановления.

Вы любуетесь танцем облаков, и в один момент даже можете различить прозрачные фигуры. Но постепенно их движение замедляется. Все медленнее и медленнее, будто ничего не было. Вы даже испытываете легкое разочарование. Но по крайней мере, вы смогли подлатать раны."
effects = Array[ExtResource("mig_fx_base")]([SubResource("mig_out_rest_1"), SubResource("mig_out_rest_2")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_rest"]
script = ExtResource("choice_script")
choice_text = "Отдохнуть и насладиться зрелищем"
outcome = SubResource("out_rest")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="check_evasion"]
script = ExtResource("stat_check_script")
stat = 3
stat_label = "Уклонение"
difficulty = 50
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="buff_evasion_whole_battle"]
script = ExtResource("buff_script")
stat = 3
value = 15
duration = -1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="mig_out_join_success_1"]
script = ExtResource("mig_fx_buff")
buffs = Array[ExtResource("buff_script")]([SubResource("buff_evasion_whole_battle")])
metadata/_custom_type_script = ExtResource("mig_fx_buff")

[sub_resource type="Resource" id="out_join_success"]
script = ExtResource("outcome_script")
result_text = "Вы вступаете в круговорот ветра и облаков. Он мгновенно подхватывает вас. Вздымает, унося в своем ритме, ведя, вовлекая, словно руки невидимого партнера. Вы уноситесь ввысь и падаете в бездну. Голубое смешивается с белым. Вокруг вас круговорот красок, и вы часть этого водоворота. Часть ветра. Часть мира. Погруженные в него.

Ритм ускоряется и ускоряется, заставляя вас терять чувство происходящего, пока наконец не обрывается на одной высокой ноте. Облака устало опускаются. Небо берёт передышку. Зефиры отступили, и лишь легкий ветерок ласкает ваши волосы, словно благодаря."
effects = Array[ExtResource("mig_fx_base")]([SubResource("mig_out_join_success_1")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="out_join_failure"]
script = ExtResource("outcome_script")
result_text = "Вы вступаете в круг ветра и облаков. Вы пытаетесь поймать ритм кружения, двигаться вместе с белым пухом. Но вы не успеваете за его плавной легкостью. Волны переливаются и перекатываются, а вам все не удается ухватить их течение, ритм их движения.

Они движутся и движутся, пока внезапно белый пух не замирает. Никогда вы не видели облака настолько статичными. Замершие, словно в оскорблении, через какое-то время они снова начинают плыть по небу. Но вы не замечаете ничьего осознанного присутствия."
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_join"]
script = ExtResource("choice_script")
choice_text = "Присоединиться к зефирам"
stat_check = SubResource("check_evasion")
success_outcome = SubResource("out_join_success")
failure_outcome = SubResource("out_join_failure")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="mig_out_beautiful_1"]
script = ExtResource("mig_fx_hp")
target = 1
specific_god = ExtResource("chernobog")
percent_delta = 15
metadata/_custom_type_script = ExtResource("mig_fx_hp")

[sub_resource type="Resource" id="mig_out_beautiful_2"]
script = ExtResource("mig_fx_maj")
target = 1
specific_god = ExtResource("chernobog")
delta = 15
metadata/_custom_type_script = ExtResource("mig_fx_maj")

[sub_resource type="Resource" id="out_beautiful"]
script = ExtResource("outcome_script")
result_text = "Чернобог едва заметно покачивается. Его крылья не колышутся, он кажется спокойным. Умиротворенным.
\"КРАСИВО...\"
Пустота его зева тихонько свистит. Танец ветров ускоряется, и кажется, что с каждым па движения элементов становятся все ближе и ближе к вам. Облака вырисовывают невозможные фигуры. Чернобог едва заметно гудит. Звук идет откуда-то из корпуса. Вы никогда не слышали, чтобы он издавал подобный звук. Означает ли он довольство?

А танец зефиров действительно приблизился к вам, вы теперь словно окружены кольцом из несущихся облаков. Оно все сужается. Но не просто вокруг вас. Вокруг тяжелой обсидиановой фигуры.

Движения ветров становятся резче, дерганее. Как будто что-то сбивает их с ритма. В облаках появляется странный зигзаг. Как будто духи ветров пытаются отдалиться от вас, но притягиваются назад. Все ближе и ближе, все ближе и ближе к черной свистящей пустоте. Вы не знаете, как можно остановить происходящее. Как не знали во все разы до этого. Движения облаков превратились в истеричные метания зверя, пойманного в сеть, а свист бездонной пустоты становится все громче, и в этом свисте вам словно слышится крик бестелесных духов. Волнения облаков слабеют и слабеют и слабеют и останавливаются. Чернобог медленно поворачивает голову направо, потом налево.
\"КРАСИВО... КРАСИВО?\"

Его лицо-маска ничего не выражает, по голосу тоже сложно понять.
\"КРАСИВО... ПУСТО...\"
Его крылья и плечи немного опускаются. Он идет вперед, оставляя глубокие ямы следов в белых облаках."
effects = Array[ExtResource("mig_fx_base")]([SubResource("mig_out_beautiful_1"), SubResource("mig_out_beautiful_2")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_beautiful"]
script = ExtResource("choice_script")
choice_text = "КРАСИВО..."
required_god = ExtResource("chernobog")
outcome = SubResource("out_beautiful")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Танец зефиров"
body_text = "Вы слышите свист. Нет, скорее пение. Облака завиваются и изгибаются. Где-то как белые водовороты, где-то как морские волны. Где-то вздымаются и лопаются, как пузыри. И свистящая музыка-пение сопровождает все это. Вы не видите силуэтов, но по движению облаков понимаете, что кто-то тут есть. Какой-то невидимый танцор."
choices = Array[ExtResource("choice_script")]([SubResource("choice_rest"), SubResource("choice_join"), SubResource("choice_beautiful")])
metadata/_custom_type_script = ExtResource("scene_script")
