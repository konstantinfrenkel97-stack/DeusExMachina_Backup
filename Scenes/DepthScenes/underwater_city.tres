[gd_resource type="Resource" script_class="MissionSceneResource" format=3]

[ext_resource type="Resource" path="res://Enemies/Sea/Depth/Merman_Warrior/Merman_Warrior.tres" id="ext_merman_warrior"]
[ext_resource type="Resource" path="res://Essence/essence_power.tres" id="ext_essence_power"]
[ext_resource type="Script" path="res://Missions/mission_scene_resource.gd" id="scene_script"]
[ext_resource type="Script" path="res://Missions/mission_choice.gd" id="choice_script"]
[ext_resource type="Script" path="res://Missions/mission_outcome.gd" id="outcome_script"]
[ext_resource type="Script" path="res://Missions/formation_resource.gd" id="formation_script"]
[ext_resource type="Script" path="res://Missions/battle_config.gd" id="battle_script"]
[ext_resource type="Script" path="res://Missions/unit_modifier.gd" id="unit_modifier_script"]
[ext_resource type="Script" path="res://Missions/buff_entry.gd" id="buff_script"]
[ext_resource type="Script" path="res://Missions/stat_check.gd" id="stat_check_script"]
[ext_resource type="Script" path="res://Missions/reward.gd" id="reward_script"]

[sub_resource type="Resource" id="form_merman_warriors"]
script = ExtResource("formation_script")
formation_name = "Русалы-воины x4"
pos1 = ExtResource("ext_merman_warrior")
pos2 = ExtResource("ext_merman_warrior")
pos3 = ExtResource("ext_merman_warrior")
pos4 = ExtResource("ext_merman_warrior")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="check_luck"]
script = ExtResource("stat_check_script")
stat = 5
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="reward_essence_power"]
script = ExtResource("reward_script")
kind = 1
resource = ExtResource("ext_essence_power")
amount = 1
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="out_v1_success"]
script = ExtResource("outcome_script")
result_text = "Вы решаете, что город стоит потенциальных рисков, и спускаетесь к нему. Городские стены сложены из крупного камня, похоже, он был построен людьми, прежде чем уйти под воду. Вокруг стен расположились хижины, слепленные из мелкого камня и какой-то подводной глины. Как объяснил вам старый дружелюбный русал, у них нет крупных сильных животных, которые могли бы перевозить каменные глыбы, поэтому они не могут строить дома, как «четырёхрукие» с поверхности. К тому же многие жители морского народа предпочитают обходиться без постоянных домов, многие живут в пещерах.
Дедушка русал становится вашим проводником. Вы идёте по затопленным улицам, мимо вас проплывают людорыбы, с интересом вас разглядывая, а вы смотрите вокруг. Улицы покрыты изысканными узорами из ракушек. Товары перевозятся в сетях и клетках, чтобы не унесло течением. Богатые русалы перемещаются в клетках, которые тянут дельфины или другие русалы, в редких случаях даже акулы.
Вы пробуете местную еду — она крайне солёная. Если кто-то из местных проявляет агрессию, их успокаивает дедушка русал. Вы прекрасно проводите время и приобщаетесь к новой для вас культуре. Город вы покидаете обогащённые и благодарные."
rewards = Array[ExtResource("reward_script")]([SubResource("reward_essence_power")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="battle_v1_fail"]
script = ExtResource("battle_script")
formation = SubResource("form_merman_warriors")
location_id = "depths"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_v1_fail"]
script = ExtResource("outcome_script")
result_text = "Вы решаете, что город стоит потенциальных рисков, и спускаетесь к нему. Городские стены сложены из крупного камня, похоже, он был построен людьми, прежде чем уйти под воду. Вокруг стен расположились хижины, слепленные из мелкого камня и какой-то подводной глины. Как объяснил вам старый дружелюбный русал, у них нет крупных сильных животных, которые могли бы перевозить каменные глыбы, поэтому они не могут строить дома, как «четырёхрукие» с поверхности. К тому же многие жители морского народа предпочитают обходиться без постоянных домов, многие живут в пещерах.
Вы благодарите старого рыболюда и продвигаетесь в город. Вы идёте по затопленным улицам, мимо вас проплывают людорыбы, с интересом вас разглядывая, а вы смотрите вокруг. Улицы покрыты изысканными узорами из ракушек. Товары перевозятся в сетях и клетках, чтобы не унесло течением. Богатые русалы перемещаются в клетках, которые тянут дельфины или другие русалы, в редких случаях даже акулы.
Но не всё так радужно в подводном королевстве. Вскоре вы обнаруживаете себя окружёнными группой вооружённых русалов. Они что-то говорят вам на булькающе-шипящем языке. Вы только теперь осознаёте, как повезло вам, что старый русал говорил на понятном вам языке, чего вы даже не заметили. Вы пытаетесь объясниться, когда один из русалов вытягивает в вашу сторону палец.
«Вы. Дерьмо.»
У него совершенно ровное произношение. Ситуация проясняется. То, как они сжимают оружие, и то, как они специально пользуются языком, которого вы не понимаете, хотя могли бы говорить иначе, — не предвещает ничего доброго. Вы готовитесь к бою, но не совершаете первое действие. Тот русал, что говорил с вами, широко улыбается и бросается вперёд."
battle = SubResource("battle_v1_fail")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_v1"]
script = ExtResource("choice_script")
choice_text = "Войти в город"
stat_check = SubResource("check_luck")
success_outcome = SubResource("out_v1_success")
failure_outcome = SubResource("out_v1_fail")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="buff_luck7_next_battle"]
script = ExtResource("buff_script")
stat = 5
value = 7
duration = -1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="out_v2"]
script = ExtResource("outcome_script")
result_text = "Хотя вам и интересна культура подводного народа, вы решаете, что спускаться в незнакомый город — слишком рискованно. Вместо этого вы забираетесь на подводную скалу и оттуда рассматриваете поселение.
Город выглядит на удивление обычно — вы много раз видели такие на поверхности. Немного поразмыслив, вы приходите к выводу, что город был затоплен, а не построен под водой. Однако с внешней стороны стен вы видите круглые домики, которые не похожи на знакомые вам. Видимо, там и живут русалы.
Какое-то время вы созерцаете и обдумываете увиденное. После чего продолжаете путь, заряженные новой любовью к морю и миру."
hero_buffs = Array[ExtResource("buff_script")]([SubResource("buff_luck7_next_battle")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_v2"]
script = ExtResource("choice_script")
choice_text = "Смотреть на город издалека"
outcome = SubResource("out_v2")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="buff_enemies_damage15"]
script = ExtResource("buff_script")
stat = 0
value = 15
duration = -1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="mod_all_enemies_damage15"]
script = ExtResource("unit_modifier_script")
target_position = 0
buffs = Array[ExtResource("buff_script")]([SubResource("buff_enemies_damage15")])
metadata/_custom_type_script = ExtResource("unit_modifier_script")

[sub_resource type="Resource" id="battle_v3"]
script = ExtResource("battle_script")
formation = SubResource("form_merman_warriors")
enemy_modifiers = Array[ExtResource("unit_modifier_script")]([SubResource("mod_all_enemies_damage15")])
location_id = "depths"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="reward_random_common_1"]
script = ExtResource("reward_script")
kind = 0
use_random_item_rarity = true
random_item_rarity = 0
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="reward_random_common_2"]
script = ExtResource("reward_script")
kind = 0
use_random_item_rarity = true
random_item_rarity = 0
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="reward_random_common_3"]
script = ExtResource("reward_script")
kind = 0
use_random_item_rarity = true
random_item_rarity = 0
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="out_v3"]
script = ExtResource("outcome_script")
result_text = "Город — это хорошо. Город — это ресурсы. У вас есть миссия, и вам нужны средства по её достижению. Вы проходите в город и высматриваете самую выгодную добычу. Разграбить город целиком не получится, но у вас есть возможность крупно поживиться.
А вот и магазин драгоценных камней. В нём также продаются какие-то посохи и оружие. Выглядит полезно.
Когда вы выходите из очередного магазина, гружёные тяжёлыми мешками, вас встречает отряд вооружённых русалов. На их лицах ненависть и решимость. Вы достаёте оружие, ибо знали, на что шли."
battle = SubResource("battle_v3")
thoughts_delta = 1500
rewards = Array[ExtResource("reward_script")]([SubResource("reward_random_common_1"), SubResource("reward_random_common_2"), SubResource("reward_random_common_3")])
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_v3"]
script = ExtResource("choice_script")
choice_text = "Разграбить город"
outcome = SubResource("out_v3")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Город под водой"
body_text = "Перед вами раскинулся город. Дома и башни из камня, стены, улицы. Всё погружено под воду. Яркие хвосты русалок мелькают среди улиц. На стенах вырезаны гербы. Целый пласт совершенно новой культуры открывает вам свои двери."
choices = [SubResource("choice_v1"), SubResource("choice_v2"), SubResource("choice_v3")]
