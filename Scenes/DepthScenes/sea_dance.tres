[sub_resource type="Resource" id="reward_gusli"]
script = ExtResource("reward_script")
kind = 0
resource = ExtResource("item_gusli_sadko")
metadata/_custom_type_script = ExtResource("reward_script")

[sub_resource type="Resource" id="out_v3"]
script = ExtResource("outcome_script")
result_text = "Музыку перебивает удар трезубца о дно. Вибрация проходит по всей воде, вы ощущаете ее телом.
«Море отвергает жертву!» Громогласно объявил Посейдон. Танец русалок остановился. Музыкант тоже прекратил.
«Верните человека обратно на сушу. Я не принимаю подобных жертв!»
Вашу группу обступают русалки.
«Но Морской Владыка! Он играет тут уже три дня, мы не можем его просто так отпустить!»
Посейдон кивает.
«Не можем и не отпустим.»
Русалы радостно переглядываются.
«Сначала вознаградим за труды! Принесите человеку по одной жемчужине, за каждую сыгранную мелодию!»
«Но Господин…»
«Быстро!»
Русалы разлетелись как косяк рыб. Посейдон стоит грозно упираясь трезубцем в землю. Все молчат. Музыкант тоже молчит. Постепенно пестрые рыболюды возвращаются. Один приносит огромную ракушку. Другие по одной приносят жемчужины и набирают в ракушку. Одна, вторая, третья… сорок третья… Да сколько же он тут наиграл!
Наконец они останавливаются. Вся команда старается скрыть шока от той горки жемчуга что набралась в ракушке. Музыкант шока не скрывает. Он сжимает обеими руками гусли, губы дрожат. С широко открытыми глазами он протягивает их Посейдону.
«Прошу примите… Не много, но это все что у меня есть.»
Посейдон торжественно берет инструмент.
«Я с благодарностью принимаю твой дар, о музыкант. Сей инструмент украшен талантом своего хозяина. Бывшего хозяина.»
Он грозно смотрит на русалок.
«А вы! Быстро отнесите его на сушу вместе с дарами! И не думайте больше принимать на свой счет жертвы, что вам не принадлежат!»
Вскрикнув русалки подхватили под мышки музыканта, другие схватили жемчуг и понеслись прочь. До вас донеслись только едва слышные слова благодарности."
target_god = ExtResource("god_poseidon")
target_majesty_delta = 15
rewards = [SubResource("reward_gusli")]
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_v3"]
script = ExtResource("choice_script")
choice_text = "Приказать отпустить жертву"
required_god = ExtResource("god_poseidon")
outcome = SubResource("out_v3")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Морская пляска"
body_text = "Вы чувствуете движение в воде. Поднатаскавшись в чтении подводной ряби вы можете сказать - где-то поблизости активно двигается большое количество объектов. Будь вы более умелые могли бы сказать точное количество, направление и размер, но это требует серьезной практики. Вы движетесь туда где заварушка, и до вас доходит то, что вы не привыкли слышать под водой - музыка. У русалок бывают горны и металлические барабаны, но они редко играют что-то сложное. А тут еще и струнный инструмент.

Добравшись до источника музыки, вы видите толпу русалок хаотично кружащихся в каком-то странном танце. Они похожи на косяк рыб в который влетел хищник. В середине, на глубоководной скале стоит мужчина, в его руках гусли, на которых он энергично играет. Удивительно, но похоже что он дышит под водой. Еще и каким-то образом звук от гуслей распространяется. Вы подплываете к музыканту, тот смотрит на вас с ужасом на лице.
«Я играю уже три дня… Корабль попал в шторм и меня принесли в жертву морю… Но эти чертовы русалки требуют чтобы я играл и играл. Помогите…»
В этот момент к вам подплывают русалы и булькающей речью говорят не отвлекать музыканта. Вы прикидываете что можно сделать, незаметно выкрасть его точно не получится."
choices = [SubResource("choice_v1"), SubResource("choice_v2"), SubResource("choice_v3")]
