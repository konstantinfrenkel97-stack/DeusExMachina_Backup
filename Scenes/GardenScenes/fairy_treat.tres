[gd_resource type="Resource" script_class="MissionSceneResource" format=3]

[ext_resource type="Resource" path="res://Enemies/Forest/Garden/Flower_fairy/flower_fairy.tres" id="ext_flower_fairy"]
[ext_resource type="Resource" path="res://Gods/Duna/Duna.tres" id="ext_duna"]
[ext_resource type="Resource" path="res://Scenes/GardenScenes/fairy_gift_tasted_success.tres" id="ext_next_success"]
[ext_resource type="Resource" path="res://Scenes/GardenScenes/fairy_gift_tasted_failure.tres" id="ext_next_failure"]
