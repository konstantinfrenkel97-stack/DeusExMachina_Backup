[ext_resource type="Resource" path="res://Enemies/Forest/Garden/Thorn_fairy/thorn_fairy.tres" id="ext_thorn_fairy"]
[ext_resource type="Resource" path="res://Enemies/Forest/Garden/Satyr/satyr.tres" id="ext_satyr"]
