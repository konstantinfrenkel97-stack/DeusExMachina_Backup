stat_check = SubResource("check_luck")
success_outcome = SubResource("out_v1_success")
failure_outcome = SubResource("out_v1_fail")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="buff_accuracy5"]
script = ExtResource("buff_script")
stat = 2
value = 5
duration = -1
metadata/_custom_type_script = ExtResource("buff_script")

[sub_resource type="Resource" id="out_v2"]
script = ExtResource("outcome_script")
result_text = "Королева Титания и король Оберон. Поссорились и сорвали пир.

Вы стараетесь навести справки. Подданные, которые обычно болтливы в отношении хозяев, проявляют тревогу. Они оглядываются, говорят шепотом. Словно боятся, что Титания выскочит прямо из кустов.

Но что-то вам выяснить удалось. В сложном королевстве фей, эти правители устроили настоящий хаос. Они то ссорятся, то сходятся. И в моменты ссор, каждый улетает в свои владения, и куча фей должны успокаивать владык, выслушивать и соглашаться. Тем, кто не выказывает должного сочувствия, достается, и зачастую жестоко. Однажды королевская чета даже пошла войной друг на друга.

Но хоть они и чудят, но обладают огромной мудростью и глубокими знаниями. Феи долго живут, и правителей меняют редко. Но все, кто участвует в мероприятии, сошлись в том, что более могущественных правителей чем эти, не знали земли великого Сада.

Вы покидаете место в размышлениях. Разобщенные, но единые. Вздорные, но мудрые. Непредсказуемые, но могущественные. Какая противоречивая пара. Но в одном у вас нет сомнений. Вам не избежать встречи с королевской семьей. Нужно быть готовыми.

Вам известен ваш Немезис."
nemesis_buff_stat = SubResource("buff_accuracy5")
nemesis_buff_location_id = "garden"
nemesis_buff_all_heroes = true
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_v2"]
script = ExtResource("choice_script")
choice_text = "Узнать побольше о королевской чете"
outcome = SubResource("out_v2")
metadata/_custom_type_script = ExtResource("choice_script")

[sub_resource type="Resource" id="out_v3"]
script = ExtResource("outcome_script")
result_text = "Дану медленно и торжественно проходит во главу стола. Разговоры постепенно затихают, глаза следуют за ней.

Два плетеных трона расплетаются, пока она идет, и соединяются в один, более высокий. Богиня грациозно на него садится.
«Как богиня, властвующая над всей природой и над фейским королевством, включая правящую чету, я торжественно объявляю пир открытым.» С этими словами она положила в рот ягоду голубики.

Молчание стало еще более абсолютным. Как будто прямо на ваших глазах сорвался первый камень лавины государственного переворота. Богиня заявила себя правительницей сада, чей статус выше Титании и Оберона. Если присутствующие прикоснутся к еде, они признают иерархию власти. И это может быть изменой. Трое богов садятся за стол и также принимаются за еду. Но вот лесные жители мнутся. Простая лесная гулянка внезапно поставила их перед жестким выбором.
«За богиню-мать!» — колокольчиковый звон фейского голоса пробил тишину.
«Это предательство!» — ответил другой. Словно на море начался шторм. Толпа разделилась на две группы пополам. Они спорят и обвиняют друг друга в подлости и предательстве.
«Довольно.»
Дану медленно поднимает руку. Толпа замолкает.
«Довольно.»
Группы расходятся, одна уходит в лес, бросая обиженные взгляды. Другая с видом демонстративного торжества усаживается за каменный стол.

Весёлая пирушка. Феи, сатиры и друиды смеются и общаются, иногда бросая взгляды на Дану. Она словно сияет, восседая на троне из сплетенных веток. Воплощение грациозной королевы. Но в глазах фей страх. Словно тень от огромных крыльев нависает над поляной.
«Мы видим вас, мы знаем, что вы сделали, и не простим, не простим, не простим.»

Вам известен ваш Немезис."
nemesis_buff_god = ExtResource("ext_danu")
nemesis_buff_majesty = 20
nemesis_buff_location_id = "garden"
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_v3"]
script = ExtResource("choice_script")
choice_text = "Разрешить феям пировать"
required_god = ExtResource("ext_danu")
outcome = SubResource("out_v3")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Пир в лесу"
body_text = "Лисичка пробегает мимо, держа в зубах крендель. Вроде и удивительно, но и привычно. Сверху на вас падает леденец, приходится отдирать от волос. По веткам скачет белка с горстью конфет.

Вы идете по направлению, откуда бежали животные. Вскоре выходите на большую поляну, тут сложено вместе несколько плоских камней, образуя длинный стол. Земля усыпана розовыми цветами, во главе стола два кресла, сплетенные из ветвей. Столы богато уставлены разными угощениями, но кроме диких животных никто не обращает на них внимания. Тут сатиры, феи, друиды и прочие обитатели сада. Они разделены на группки и переговариваются. На вас никто не обращает внимания. Вы обращаетесь к друиду, сидящему в отдалении от остальных.
«Ах, это? Пир, праздник у нас намечался. Почетные гости — королева Титания с мужем Обероном. Но вот, пришла новость, что они, похоже, не приедут, опять поссорились... А без почтенных гостей к еде притронуться нельзя, вот их и растаскивает зверье. Только вот кто знает, как на них фейская еда-то повлияет.»
Вы благодарите старика и оставляете его предаваться скорбным размышлениям. Королевская чета капризно пропустила праздник, но никто не смеет прикоснуться к их еде. Титания и Оберон — владыки фей."
choices = [SubResource("choice_v1"), SubResource("choice_v2"), SubResource("choice_v3")]
