[sub_resource type="Resource" id="check_luck"]
script = ExtResource("stat_check_script")
stat = 5
stat_label = "Удача"
metadata/_custom_type_script = ExtResource("stat_check_script")

[sub_resource type="Resource" id="out_v1_success"]
script = ExtResource("outcome_script")
result_text = "Нет ни одной причины вам не поесть. Вы садитесь за плоские камни, и вместе с лесными животными приступаете к трапезе. Блюда изобилуют сладким, видимо под вкус лесного народа. Подано очень красиво, еда украшена цветами, одним из самых популярных ингредиентов является мед.

К вам сзади подходит друид.
«Прошу меня простить, но что вы себе позволяете? Никто не смеет приступать к еде раньше королевской четы.»
Вы отвечаете с набитым ртом, что все хорошо, с правящими супругами вы сами разберетесь, и раз вы уже начали, не будет преступлением и им поесть. Ответственность на вас.
«Ответственность на них... Можем приступать... Ответственность на них...»
Шепот разносится над поляной. Обитатели поляны смотрят на лакомства голодными глазами, а вы все продолжаете уплетать.
«Ответственность на них...»
Один за другим лесные жители садятся за стол. Начинают звучать шутки и песни, люди смеются, веселятся и радостно едят. Вы едите вместе с ними. Приторная фейская еда поднимает настроение и восполняет силы. Нежный аромат цветов, закатывающееся солнце, весёлая компания и вкусная еда. Вы прекрасно проводите время.

Единственное что портит праздник это тень хозяев. Титания и Оберон. Вы чувствуете тревогу каждого за столом. Вот они появятся, прямо сейчас. Повелители фей, хозяева сада. Сегодня вы не встретились, но что-то вам подсказывает, что встреча неизбежна.

Вам известен ваш Немезис."
hero_hp_percent_delta = 10
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="form_feast"]
script = ExtResource("formation_script")
formation_name = "Фея лепестков — фея шипов — сатир — друид"
pos1 = ExtResource("ext_flower_fairy")
pos2 = ExtResource("ext_thorn_fairy")
pos3 = ExtResource("ext_satyr")
pos4 = ExtResource("ext_druid")
metadata/_custom_type_script = ExtResource("formation_script")

[sub_resource type="Resource" id="battle_v1_fail"]
script = ExtResource("battle_script")
formation = SubResource("form_feast")
location_id = "garden"
metadata/_custom_type_script = ExtResource("battle_script")

[sub_resource type="Resource" id="out_v1_fail"]
script = ExtResource("outcome_script")
result_text = "Нет ни одной причины вам не поесть. Вы садитесь за плоские камни, и вместе с лесными животными приступаете к трапезе. Блюда изобилуют сладким, видимо под вкус лесного народа. Подано очень красиво, еда украшена цветами, одним из самых популярных ингредиентов является мед.

К вам сзади подходит друид.
«Прошу меня простить, но что вы себе позволяете? Никто не смеет приступать к еде раньше королевской четы.»
Вы отвечаете, что все нормально и нет никаких проблем. Друиды удивленно переглядываются.
«Да нет, проблема есть. Вы нарушаете королевский этикет.»
Вы отвечаете, что все в порядке, и не о чем беспокоиться, продолжая набивать рот.
«Но так же нельзя...»
Вы отвечаете друиду что льзя. Он обдумывает вашу аргументацию. И под конец находит ее недостаточной.
«Именем Королевы Фей — защищайтесь!»
Вы встаете из-за стола. Сладкая фейская еда восстановила ваши силы, жаль вы не смогли наслаждаться ей подольше.

И еще, нет сомнений что ваша выходка достигнет их ушей. Титания и Оберон, властители фей. Те, с кем вам придется встретиться.

Вам известен ваш Немезис."
hero_hp_percent_delta = 10
battle = SubResource("battle_v1_fail")
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_v1"]
script = ExtResource("choice_script")
