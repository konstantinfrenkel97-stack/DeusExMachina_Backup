[sub_resource type="Resource" id="out_thor_success"]
script = ExtResource("outcome_script")
result_text = "«Что вы стоите? Совсем сдурели? Там же ваши товарищи живые! А ну разойтись!»

Бог грома в одиночку бросается на груду камней. Он заносит свой легендарный молот и обрушивает на булыжник. Тот рассыпается от удара. Он снова бьёт. Разрушается второй камень. Гром земли резонирует с громом неба, когда бог удар за ударом сокрушает каменную породу. Наконец, с новым ударом, электрические языки скользят по камням, и гора обломков рассыпается. Кобольды валят в пролом и видят своего спасителя, покрытого потом и пылью. Маленькие люди подхватывают могучего бога на руки.

«Спаситель! Спаситель! Друг подземного народа! Друг подземного народа!»

Тор торжествующе улыбается на руках маленьких человечков, когда внезапно, под общее ликование, его куда-то понесли. Вы бросаетесь в погоню, прежде чем друга подземного народа унесли прочь от отряда."
target_god_immediate = ExtResource("god_thor")
target_god_immediate_majesty_delta = 40
permanent_enemy_debuff_unit_name = "Кобольд"
permanent_enemy_debuff_accuracy = -5
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="out_thor_fail"]
script = ExtResource("outcome_script")
result_text = "«Что вы стоите? Совсем сдурели? Там же ваши товарищи живые! А ну разойтись!»

Бог грома в одиночку бросается на груду камней. Он заносит свой легендарный молот и обрушивает на булыжник. Тот рассыпается от удара. Он снова бьёт. Разрушается второй камень. Гром земли резонирует с громом неба, когда бог удар за ударом сокрушает каменную породу.

И тут гора ударила в ответ. По каменной стене пошли трещины, и внезапно несколько крупных камней обрушилось прямо на бога. Не успели вы отреагировать, как Тор оказался погребён под булыжниками. Кобольды начинают хохотать, когда вы раскапываете своего незадачливого спутника.

Он жив, но сильно потрёпан и ещё более зол. Вы забираете Тора. Ни о каком завале речь больше не идёт."
target_god_immediate = ExtResource("god_thor")
target_god_immediate_hp_percent_delta = -50
metadata/_custom_type_script = ExtResource("outcome_script")

[sub_resource type="Resource" id="choice_thor"]
script = ExtResource("choice_script")
choice_text = "Броситься разбирать завал самим"
required_god = ExtResource("god_thor")
stat_check = SubResource("check_attack")
success_outcome = SubResource("out_thor_success")
failure_outcome = SubResource("out_thor_fail")
metadata/_custom_type_script = ExtResource("choice_script")

[resource]
script = ExtResource("scene_script")
scene_title = "Дрожь земли"
body_text = "Дальнейший путь по резному украшенному тоннелю охраняется так сильно, что вы решаете попытать удачу в грубых и неотёсанных шахтёрских тоннелях.

Вы идёте по привычному холодному камню, до вас доносится мерный стук кирки о скалу. Иногда в темноте загораются жёлтые глаза кобольдов. Но вас они игнорируют, занятые своей работой. Вы углубляетесь глубже и глубже, стук уже со всех сторон, как вдруг вы слышите другой звук. Тоже глухой звук камня, но какой-то более далёкий и раскатистый. Песня кирки мгновенно останавливается, и в следующую секунду кобольды вокруг вас пускаются в бег. Вы мчитесь за ними, а каменная твердь над головами угрожающе рычит. Вы слышите, как падают на землю камешки с потолка. Кобольды убегают и сталкиваются друг с другом, вы стараетесь продвинуться сквозь толпу к свету более укреплённых тоннелей, пока своей массой вас не придавила огромная гора наверху. Вы осознаёте, где именно вы заперты. Вы пробиваетесь через кобольдов к выходу, видя, как идёт трещинами каменная твердь. Маленькие камни начинают осыпаться, и выход заваливает. Но вы успели оказаться снаружи.

Тут же вас встречает толпа кобольдов, из тех, кто уже добрался до безопасности. Они раздражённо обсуждают потраченное время и невыполненную норму. Из-за камней заваленного прохода слышатся крики и удары о камень. Но рудокопы, что стоят рядом с вами, не обращают внимания. А гора продолжает рычать."
choices = [SubResource("choice_persuade"), SubResource("choice_nothing"), SubResource("choice_thor")]
